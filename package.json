{
  "name": "lusia-docs",
  "private": true,
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lusiajs/docs.git"
  },
  "scripts": {
    "dev": "bun scripts/playground-runtime.ts && bun scripts/ai-docs.ts && lusia dev .",
    "build": "bun scripts/playground-runtime.ts && bun scripts/ai-docs.ts && lusia build . && bun scripts/not-found-page.ts",
    "test": "bun test --parallel=6",
    "typecheck": "tsc --noEmit",
    "check": "bun run typecheck && bun run test && bun run build"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-html": "6.4.12",
    "@codemirror/lang-javascript": "6.2.5",
    "@codemirror/lang-sass": "6.0.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.8",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/common": "1.5.6",
    "@lezer/highlight": "1.2.5",
    "lusiajs": "^0.1.1-beta",
    "prettier": "3.10.1",
    "prismjs": "^1.30.0",
    "sass": "^1.80.0"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^15.11.0",
    "@types/bun": "latest",
    "@types/prismjs": "^1.26.6",
    "playwright": "1.63.0",
    "typescript": "^5.6.0"
  }
}
