<script>
import { onAttach, variable } from "lusiajs";
import {
	addFile,
	deleteActive,
	formatActive,
	renameActive,
	resetFiles,
	selectFile,
} from "../playground/actions.ts";
import { ENTRY_FILE } from "../playground/names.ts";
import { runNow } from "../playground/run.ts";
import { active, autoRun, files, view } from "../playground/state.ts";
import EditorTabs from "./EditorTabs.lusia";
import FileNameForm from "./FileNameForm.lusia";

// "add" and "rename" open one name form at a time. "" means no form is open.
const formMode = variable<"" | "add" | "rename">("");
const adding = variable.compute(() => formMode.value === "add");
const renaming = variable.compute(() => formMode.value === "rename");
const isEntry = variable.compute(() => active.value === ENTRY_FILE);
const menu = variable<HTMLDetailsElement | null>(null);

function pick(name: string) {
	closeMenu();
	selectFile(name);
}

function openAdd() {
	closeMenu();
	formMode.value = "add";
}

function openRename() {
	closeMenu();
	formMode.value = "rename";
}

function closeForm() {
	formMode.value = "";
}

// A name with no problem closes the form.
function submitName(name: string): string | undefined {
	const problem =
		formMode.peek() === "add" ? addFile(name) : renameActive(name);
	if (problem === undefined) formMode.value = "";
	return problem;
}

function toggleAutoRun() {
	autoRun.value = !autoRun.value;
}

function run() {
	view.value = "preview";
	void runNow();
}

function format() {
	closeMenu();
	void formatActive();
}

function removeActive() {
	closeMenu();
	if (confirm(`Delete ${active.peek()}?`)) deleteActive();
}

function reset() {
	closeMenu();
	if (confirm("Reset to the starter example? Your files will be replaced."))
		resetFiles();
}

function closeMenu() {
	const open = menu.peek();
	if (open) open.open = false;
}

function onDocumentClick(event: MouseEvent) {
	const open = menu.peek();
	if (!open || !open.open) return;
	if (open.contains(event.target as Node)) return;
	open.open = false;
}

function onDocumentKey(event: KeyboardEvent) {
	if (event.key === "Escape") closeMenu();
}

// The menu closes on an outside click or Escape, like every other popup.
onAttach(() => {
	document.addEventListener("click", onDocumentClick);
	document.addEventListener("keydown", onDocumentKey);
	return () => {
		document.removeEventListener("click", onDocumentClick);
		document.removeEventListener("keydown", onDocumentKey);
	};
});
</script>

<div class="play-bar">
	<EditorTabs
		files={files}
		active={active}
		onSelect={pick}
		onAdd={openAdd}
	/>
	<div class="play-actions" role="toolbar" aria-label="Playground">
		<button
			class="play-icon"
			type="button"
			aria-label="Toggle auto run"
			title="Auto run on/off"
			aria-pressed={String(autoRun.value)}
			onclick={toggleAutoRun}
		>
			<span class="material-symbols-rounded" aria-hidden="true">autorenew</span>
		</button>
		<button
			class="play-icon"
			type="button"
			aria-label="Run"
			title="Run"
			onclick={run}
		>
			<span class="material-symbols-rounded" aria-hidden="true"
				>play_arrow</span
			>
		</button>
		<button
			class="play-icon"
			type="button"
			aria-label="Format"
			title="Format"
			onclick={format}
		>
			<span class="material-symbols-rounded" aria-hidden="true"
				>format_align_left</span
			>
		</button>
		<details class="play-more" bind-element={menu}>
			<summary
				class="play-icon"
				aria-label="More playground actions"
				title="More"
			>
				<span class="material-symbols-rounded" aria-hidden="true"
					>more_horiz</span
				>
			</summary>
			<div class="play-menu">
				<button type="button" disabled={isEntry} onclick={openRename}>
					Rename file
				</button>
				<button type="button" disabled={isEntry} onclick={removeActive}>
					Delete file
				</button>
				<div class="play-menu-sep" role="separator"></div>
				<button type="button" onclick={reset}>Reset to starter</button>
			</div>
		</details>
	</div>
	<IF {adding}>
		<div class="play-form">
			<FileNameForm
				label="New file name"
				initial={""}
				submitText="Add"
				onSubmit={submitName}
				onCancel={closeForm}
			/>
		</div>
	</IF>
	<IF {renaming}>
		<div class="play-form">
			<FileNameForm
				label="New name"
				initial={active}
				submitText="Rename"
				onSubmit={submitName}
				onCancel={closeForm}
			/>
		</div>
	</IF>
</div>

<style>
.play-bar {
	position: relative;
	z-index: 30;
	display: flex;
	flex-wrap: nowrap;
	align-items: center;
	gap: 0.5rem;
	height: 3rem;
	min-width: 0;
	padding: 0 0.5rem;
	border-bottom: 1px solid var(--line);
	background: var(--card);
}

// A single file has no tabs, so its icon and name sit straight in the bar.
.play-bar > .material-symbols-rounded {
	flex: none;
	color: var(--muted);
	font-size: 1.05rem;
}

// The add button sits right after the last tab, not at the far end of the bar.
// The strip takes the bar height, so the selected tab's underline meets the border.
.play-bar .code-tabs-wrap {
	align-self: stretch;
	align-items: center;
}

.play-bar .code-tabs {
	align-self: stretch;
	flex: 0 1 auto;
}

.play-actions {
	display: flex;
	flex: none;
	align-items: center;
	gap: 0.1rem;
	margin-left: auto;
}

.play-icon {
	display: inline-grid;
	place-items: center;
	width: 2.25rem;
	height: 2.25rem;
	padding: 0;
	border: 0;
	border-radius: 8px;
	background: transparent;
	color: var(--muted);
	cursor: pointer;

	.material-symbols-rounded {
		font-size: 1.2rem;
	}

	&:hover {
		background: var(--accent-soft);
		color: var(--fg);
	}

	&[aria-pressed="true"] {
		background: var(--accent-soft);
		color: var(--accent);
	}
}

summary.play-icon {
	list-style: none;

	&::-webkit-details-marker {
		display: none;
	}
}

// The More menu holds the file actions and Reset.
.play-more {
	position: relative;
	flex: none;
}

.play-menu {
	position: absolute;
	top: calc(100% + 0.35rem);
	right: 0;
	z-index: 1;
	display: grid;
	min-width: 11rem;
	padding: 0.3rem;
	border: 1px solid var(--line);
	border-radius: 10px;
	background: var(--card);
	box-shadow: var(--shadow);
}

.play-menu button {
	display: flex;
	align-items: center;
	padding: 0.45rem 0.55rem;
	border: 0;
	border-radius: 7px;
	background: transparent;
	color: var(--fg);
	font: inherit;
	font-size: 0.82rem;
	text-align: left;
	cursor: pointer;

	&:hover:not(:disabled) {
		background: var(--accent-soft);
	}

	&:disabled {
		color: var(--muted);
		cursor: default;
		opacity: 0.55;
	}
}

.play-menu-sep {
	height: 1px;
	margin: 0.3rem 0.25rem;
	background: var(--line);
}

.play-form {
	position: absolute;
	top: calc(100% + 0.35rem);
	left: 0.5rem;
	z-index: 1;
	width: min(22rem, calc(100% - 1rem));
	border: 1px solid var(--line);
	border-radius: 12px;
	background: var(--card);
	box-shadow: var(--shadow);

	.file-form {
		border-bottom: 0;
	}
}

@media (pointer: coarse), (max-width: 719px) {
	.play-icon {
		width: 2.5rem;
		height: 2.5rem;
	}
}
</style>
