<script>
  import { props } from "lusiajs";
  import CodeBlock from "./CodeBlock.lusia";

  // `copy` is what the button copies. It can differ from the wrapped `text` shown.
  const { text, copy, language, className } = props({
    text: "",
    copy: "",
    language: "none",
    className: "",
  });
</script>

<div class="code-copy">
  <CodeBlock
    text={text.value}
    language={language.value}
    className={className.value}
  />
  <button
    class="copy-button code-copy-button"
    type="button"
    data-copy={copy.value}
    aria-label="Copy the code"
  >
    <span class="material-symbols-rounded" aria-hidden="true"
      >content_copy</span
    >
  </button>
</div>
