<script>
import { props, variable } from "lucia";
import type { EditorFile, EditorJump } from "../editor/files.ts";
import type { EditorSession } from "../editor/session.ts";

const { files, active, readOnly, edited, onChange, onSelect, onReset, jump } = props({
  files: [] as EditorFile[],
  active: "",
  readOnly: false,
  edited: false,
  onChange: (name: string, code: string) => {},
  onSelect: (name: string) => {},
  onReset: () => {},
  jump: null as EditorJump | null,
});

const selected = variable("");
const host = variable<HTMLElement | null>(null);
const multiple = variable.compute(() => files.value.length > 1);
const copied = variable(false);
const copyIcon = variable.compute(() => (copied.value ? "check" : "content_copy"));
const status = variable("");
let session: EditorSession | undefined;

// An active file set by the parent takes effect; tabs change the selection after that.
variable.autoRun(() => {
  selected.value = active.value;
});

// Variables are read before the optional call, so they stay tracked until it loads.
variable.autoRun(() => {
  const list = files.value;
  const name = selected.value;
  session?.show(list, name);
});

variable.autoRun(() => {
  const isReadOnly = readOnly.value;
  session?.setReadOnly(isReadOnly);
});

// A new jump object moves the cursor, even to the place it was last at.
variable.autoRun(() => {
  const target = jump.value;
  if (!target) return;
  selected.value = target.file;
  session?.reveal(target.file, target.line, target.column);
});

// The editor code loads on first mount, so a page without it stays small.
function setup() {
  let closed = false;
  import("../editor/session.ts")
    .then(({ EditorSession }) => {
      if (closed) return;
      session = new EditorSession(host.peek()!, {
        files: files.peek(),
        name: selected.peek(),
        readOnly: readOnly.peek(),
        onChange: changed,
      });
    })
    .catch(() => {
      status.value = "The editor could not load.";
    });
  return () => {
    closed = true;
    session?.destroy();
    session = undefined;
  };
}

function changed(name: string, code: string) {
  onChange.peek()(name, code);
}

function select(name: string) {
  selected.value = name;
  onSelect.peek()(name);
}

function nextIndex(key: string, current: number, count: number): number | null {
  if (key === "ArrowRight") return (current + 1) % count;
  if (key === "ArrowLeft") return (current - 1 + count) % count;
  if (key === "Home") return 0;
  if (key === "End") return count - 1;
  return null;
}

// Arrow keys move between tabs, like a native tab list.
function onTabKey(event: KeyboardEvent) {
  const list = files.peek();
  const current = list.findIndex((file) => file.name === selected.peek());
  const next = nextIndex(event.key, current, list.length);
  if (next === null) return;
  event.preventDefault();
  select(list[next]?.name ?? "");
  const tabs = (event.currentTarget as HTMLElement).children;
  (tabs[next] as HTMLElement | undefined)?.focus();
}

const formatFailed = "Could not format this file. Fix the syntax first.";

function reset() {
  onReset.peek()();
}

function formatCode() {
  session?.format().then((formatted) => {
    status.value = formatted ? "" : formatFailed;
  });
}

async function copyCode() {
  if (!session) return;
  try {
    await navigator.clipboard.writeText(session.text());
    copied.value = true;
    setTimeout(() => (copied.value = false), 1500);
  } catch {
    status.value = "Copy failed. Select the code and copy it instead.";
  }
}
</script>

<div class="code-panel code-editor">
  <div class="code-head">
    <IF {multiple}>
      <div class="code-tabs" role="tablist" aria-label="Files" onkeydown={onTabKey}>
        <EACH {files} as={file} key={file.name}>
          <button
            class="code-tab"
            type="button"
            role="tab"
            aria-selected={String(selected.value === file.name)}
            onclick={() => select(file.name)}
          >
            <span class="material-symbols-rounded" aria-hidden="true">description</span>
            {file.name}
          </button>
        </EACH>
      </div>
    </IF>
    <ELSE>
      <span class="material-symbols-rounded" aria-hidden="true">description</span>
      <span class="file-name">{selected}</span>
    </ELSE>
    <IF {edited.value}>
      <span class="edited-mark">Edited</span>
      <button class="reset-button" type="button" onclick={reset}>Reset</button>
    </IF>
    <button
      class="icon-button"
      type="button"
      aria-label="Format the code"
      title="Format (Shift+Alt+F)"
      disabled={readOnly}
      onclick={formatCode}
    >
      <span class="material-symbols-rounded" aria-hidden="true">format_align_left</span>
    </button>
    <button
      class="icon-button"
      type="button"
      aria-label="Copy the code"
      onclick={copyCode}
    >
      <span class="material-symbols-rounded" aria-hidden="true">{copyIcon}</span>
    </button>
  </div>
  <div class="editor-body" bind-element={host}></div>
  <p class="editor-hint">
    Tab indents. Press Esc to leave the editor. Shift+Alt+F formats.
  </p>
  <p class="editor-status" role="status">{status}</p>
</div>

<style>
@use "../styles/theme" as *;

.code-editor {
  .editor-body {
    min-width: 0;
  }

  .edited-mark {
    flex: none;
    padding: 0.1rem 0.5rem;
    border-radius: 999px;
    background: var(--lavender-soft);
    color: var(--fg);
    font-size: 0.75rem;
  }

  .reset-button {
    flex: none;
    padding: 0.25rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-size: 0.78rem;
    cursor: pointer;

    &:hover {
      border-color: var(--accent);
      color: var(--accent);
    }
  }

  :global(.cm-editor) {
    font-family: $font-mono;
    font-size: 0.9rem;
  }

  :global(.cm-scroller) {
    min-height: 14rem;
    max-height: 70vh;
  }

  // 16px stops iOS from zooming in when the editor takes focus.
  @media (max-width: 40em) {
    :global(.cm-editor) {
      font-size: 16px;
    }
  }

  .editor-hint {
    margin: 0;
    padding: 0.4rem 0.9rem 0;
    color: var(--muted);
    font-size: 0.78rem;
  }

  .editor-status {
    margin: 0;
    padding: 0.2rem 0.9rem 0.6rem;
    min-height: 1.2rem;
    color: var(--link);
    font-size: 0.8rem;
  }
}
</style>
