<script>
  import { SCREEN, variable, props } from "lusiajs";
  import { pageScroll, tunnelIn, tunnelOut } from "../motion/home-bg.ts";

  const p = props(class {
    follow: HTMLElement | null = null;
  });
  const follow = variable.compute(() => p.follow);
  const reduced = SCREEN.REDUCED_MOTION.value;

  const copyCount = 12;
  const biggestVmin = 160;
  const shrink = 0.8;
  const firstOpacity = 0.22;
  const lastOpacity = 0.03;

  // The outline images use a 108 by 112 box. Sizes scale the same 128 grid as before.
  const imageWidthShare = 108 / 128;
  const imageHeightShare = 112 / 128;

  // Copy 0 is the biggest. Each next copy is smaller by `shrink`.
  function copySize(index: number) {
    return biggestVmin * shrink ** index;
  }

  // The opacity falls in equal steps from the first copy to the last.
  function copyOpacity(index: number) {
    const share = index / (copyCount - 1);
    return firstOpacity + (lastOpacity - firstOpacity) * share;
  }

  // The nearest copy (index 0) moves most, so the tunnel gives a depth parallax.
  function depthShift(index: number) {
    return 120 - index * 9;
  }

  function copyCss(index: number) {
    const size = copySize(index);
    const width = size * imageWidthShare;
    const height = size * imageHeightShare;
    return [
      `width: ${width}vmin`,
      `height: ${height}vmin`,
      `margin: ${-height / 2}vmin 0 0 ${-width / 2}vmin`,
      `opacity: ${copyOpacity(index)}`,
    ].join("; ");
  }

  function copyScroll(index: number) {
    if (reduced) return [];
    return pageScroll(
      follow,
      { translate: "0 0" },
      { translate: `0 -${depthShift(index)}vh` },
    );
  }

  // Each stroke bucket shares one outline file, so thin lines stay visible.
  const copiesPerStroke = 3;

  function outlineSource(theme: string, index: number) {
    const bucket = Math.floor(index / copiesPerStroke) + 1;
    return `/logo-outline-${theme}-${bucket}.svg`;
  }

  const copies = Array.from({ length: copyCount }, (_, index) => ({
    id: index,
    css: copyCss(index),
    lightSrc: outlineSource("light", index),
    darkSrc: outlineSource("dark", index),
    motion: reduced ? [] : [tunnelIn(index), tunnelOut],
    scroll: copyScroll(index),
  }));
</script>

<div class="logo-tunnel" aria-hidden="true">
  <EACH {copies} as="{copy}">
    <span class="tunnel-copy" style={copy.css} animate={copy.scroll}>
      <span class="tunnel-pop" animate={copy.motion}>
        <img
          class="tunnel-image tunnel-image-light"
          src={copy.lightSrc}
          alt=""
          decoding="async"
        />
        <img
          class="tunnel-image tunnel-image-dark"
          src={copy.darkSrc}
          alt=""
          decoding="async"
        />
      </span>
    </span>
  </EACH>
</div>

<style>
  .logo-tunnel {
    position: absolute;
    top: 0;
    right: 0;
    left: 0;
    height: 100svh;
  }

  // The margin centres each copy on its 50% point, so the translate moves it from centre.
  .tunnel-copy {
    position: absolute;
    top: 50%;
    left: 50%;
    pointer-events: none;
    will-change: translate, scale;
  }

  .tunnel-pop {
    display: block;
    width: 100%;
    height: 100%;
  }

  .tunnel-image {
    display: block;
    width: 100%;
    height: 100%;
  }

  .tunnel-image-dark {
    display: none;
  }

  :root[data-theme="dark"] .tunnel-image-light {
    display: none;
  }

  :root[data-theme="dark"] .tunnel-image-dark {
    display: block;
  }
</style>
