<script>
  import { onAttach, props } from "lusiajs";
  import { flashHeading } from "../flash.ts";
  import { guidePath, pageLink } from "../page-link.ts";
  import type { Part } from "../keywords.ts";

  // Lets the browser start scrolling before the heading flashes.
  const SCROLL_WAIT_MS = 350;
  const noParts: Part[] = [];
  const { parts, base } = props(class {
    parts = noParts;
    base = guidePath;
  });
  const basePath = base;

  let flashTimer = 0;

  function followChip(event: MouseEvent) {
    const link = event.currentTarget as HTMLAnchorElement;
    clearTimeout(flashTimer);
    flashTimer = window.setTimeout(
      () => flashHeading(link.hash.slice(1)),
      SCROLL_WAIT_MS,
    );
  }

  onAttach(() => () => clearTimeout(flashTimer));
</script>

<EACH {parts} as={part}>
  <IF {part.target}>
    <a
      class="chip"
      data-kind={part.kind}
      href={pageLink(basePath, part.target.id)}
      title={part.target.summary}
      onclick={followChip}
      >{part.text}</a
    >
  <ELSEIF {part.chip}>
    <code class="chip" data-kind={part.kind}>{part.text}</code>
  <ELSE>{part.text}</IF>
</EACH>
