<script>
  import { EVENT, listen, onAttach, variable } from "lusiajs";
  import { toggleDrawer, drawerOpen } from "../drawer.ts";
  import { atTop, topbarClass } from "../topbar.ts";
  import SearchPalette from "./SearchPalette.lusia";
  import ThemeToggle from "./ThemeToggle.lusia";

  const stripEl = variable<HTMLElement | null>(null);
  const topbarEl = variable<HTMLElement | null>(null);
  const sentinelEl = variable<HTMLElement | null>(null);
  const menuExpanded = variable.compute(() => String(drawerOpen.value));

  // Full screen sections subtract the real banner and topbar heights.
  onAttach(() => {
    listen(sentinelEl.value!, EVENT.VIEW, ({ in: visible }) => {
      atTop.value = visible;
    });
    trackHeight(stripEl.value!, "--strip-h");
    trackHeight(topbarEl.value!, "--topbar-h");
  });

  function trackHeight(el: HTMLElement, property: string) {
    listen(el, EVENT.SIZE, () => {
      document.documentElement.style.setProperty(property, `${el.offsetHeight}px`);
    });
  }
</script>

<NOLAZY />

<span class="top-sentinel" aria-hidden="true" bind-element={sentinelEl}></span>

<p class="status-strip" role="note" bind-element={stripEl}>
  Beta — Lusia is under active development. APIs may change.
  <a href="https://github.com/lusiajs/lusia">Follow progress on GitHub</a>
</p>

<header class={topbarClass} bind-element={topbarEl}>
  <button
    class="icon-button menu-button"
    id="menu"
    type="button"
    aria-label="Open the docs menu"
    aria-controls="sidebar"
    aria-expanded={menuExpanded}
    onclick={toggleDrawer}
  >
    <span class="material-symbols-rounded" aria-hidden="true">menu</span>
  </button>
  <a class="brand" href="/">
    <img src="/logo.svg" width="28" height="28" alt="" />Lusia
  </a>
  <nav class="main-menu" aria-label="Main">
    <a href="/">Home</a>
    <a href="/guide">Guide</a>
    <a href="/reference">Reference</a>
    <a href="/playground">Playground</a>
  </nav>
  <SearchPalette />
  <div class="topbar-actions">
    <ThemeToggle />
    <a
      class="icon-button"
      href="https://github.com/lusiajs/lusia"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Lusia on GitHub"
    >
      <svg class="github-mark" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
        <path
          d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91
            .58.11.79-.25.79-.55 0-.27-.01-1.17-.02-2.12-3.2.7-3.87-1.36
            -3.87-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7
            1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.69 1.25 3.35.96.1-.75
            .4-1.25.72-1.54-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28
            1.18-3.09-.12-.29-.51-1.46.11-3.05 0 0 .96-.31 3.15 1.18a10.9
            10.9 0 0 1 5.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.59.23
            2.76.11 3.05.74.81 1.18 1.83 1.18 3.09 0 4.41-2.69 5.38-5.25
            5.67.41.35.77 1.05.77 2.12 0 1.53-.01 2.76-.01 3.14 0 .3.2.67
            .8.55A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"
          fill="currentColor"
        />
      </svg>
    </a>
  </div>
</header>

<div id="outlet"></div>

<footer class="site-footer">
  <p class="footer-brand">
    <img src="/logo.svg" width="28" height="28" alt="" />Lusia
  </p>
  <nav aria-label="Footer">
    <a href="/">Home</a>
    <a href="/guide">Guide</a>
    <a href="/reference">Reference</a>
    <a href="/playground">Playground</a>
    <a href="/llms.txt">For AI</a>
    <a href="https://github.com/lusiajs/lusia" target="_blank" rel="noopener noreferrer"
      >GitHub</a
    >
  </nav>
</footer>

<style scoped>
  .top-sentinel {
    position: absolute;
    top: 8px;
    left: 0;
    width: 1px;
    height: 1px;
    pointer-events: none;
  }
</style>
