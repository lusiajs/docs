<script>
  import { SCREEN, ON } from "lusiajs";
  import LoadingMark from "./LoadingMark.lusia";

  // Reduced motion keeps the loader still. Only the fade-out still plays.
  const reduced = SCREEN.REDUCED_MOTION.value;

  const fadeOut = {
    0: { opacity: 1 },
    1: { opacity: 0 },
  };
</script>

<div
  class="loader"
  role="status"
  aria-label="Loading Lusia"
  animate={{ play: fadeOut, on: ON.DETACH, duration: reduced ? 1 : 400 }}
>
  <LoadingMark />
</div>

<style>
  .loader {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: grid;
    place-items: center;
    background: var(--bg);
    color: var(--fg);
  }
</style>
