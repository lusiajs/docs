<script>
import { WHEN, EASE } from "lusia";

// Reduced motion keeps the loader still. Only the fade-out still plays.
const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

const dotBounce = {
  default: [EASE.STYLE.SINE, EASE.INOUT],
  0: { translate: "0px 0px" },
  1: { translate: "0px -8px" },
};

const fadeOut = {
  0: { opacity: 1 },
  1: { opacity: 0 },
};

const loopSettings = {
  loop: true,
  backAndForth: true,
};

function dotMotion(delay: number) {
  return reduced ? [] : { ...loopSettings, style: dotBounce, duration: 500, delay };
}
</script>

<div
  class="loader"
  role="status"
  aria-label="Loading Lusia"
  animate={{ style: fadeOut, when: WHEN.DETACH, duration: reduced ? 1 : 400 }}
>
  <div class="loader-inner">
    <p class="name">Lusia</p>
    <div class="dots" aria-hidden="true">
      <span class="dot pink" animate={dotMotion(0)}></span>
      <span class="dot lavender" animate={dotMotion(120)}></span>
      <span class="dot mint" animate={dotMotion(240)}></span>
    </div>
  </div>
</div>

<style>
.loader {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: grid;
  place-items: center;
  background: var(--bg);
  color: var(--fg);
}

.loader-inner {
  display: grid;
  justify-items: center;
  gap: 0.9rem;
}

.name {
  margin: 0;
  font-family: "M PLUS Rounded 1c", system-ui, sans-serif;
  font-size: 1.4rem;
  font-weight: 800;
}

.dots {
  display: flex;
  gap: 0.45rem;
}

.dot {
  width: 0.55rem;
  height: 0.55rem;
  border-radius: 50%;

  &.pink { background: var(--pink); }
  &.lavender { background: var(--lavender); }
  &.mint { background: var(--mint); }
}
</style>
