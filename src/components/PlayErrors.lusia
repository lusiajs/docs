<script>
import { props, variable } from "lusia";
import type { LiveError } from "../live/types.ts";

const { errors, onJump } = props({
	errors: [] as LiveError[],
	onJump: (error: LiveError) => {},
});

const isEmpty = variable.compute(() => errors.value.length === 0);

function where(error: LiveError): string {
	return error.file
		? `${error.file}:${error.line ?? 1}:${error.column ?? 1}`
		: "";
}

function jump(error: LiveError) {
	onJump.peek()(error);
}
</script>

<section class="play-errors" aria-label="Errors">
	<IF {isEmpty}>
		<p class="play-ok">No errors.</p>
	</IF>
	<ELSE>
		<ul class="play-error-list" role="list">
			<EACH {errors} as={error}>
				<li class="play-error">
					<p class="play-error-message">
						<IF {error.code}>
						<span class="play-error-code">{error.code}</span>
						</IF> {error.message}
					</p>
					<IF {error.hint}>
						<p class="play-error-hint">{error.hint}</p>
					</IF>
					<IF {error.file}>
						<button
							class="play-error-where"
							type="button"
							onclick={() => jump(error)}
						>
							{where(error)}
						</button>
					</IF>
				</li>
			</EACH>
		</ul>
	</ELSE>
</section>

<style>
@use "../styles/theme" as *;

.play-errors {
	display: grid;
	gap: 0.5rem;
}

.play-ok {
	margin: 0;
	color: var(--muted);
	font-size: 0.85rem;
}

.play-error-list {
	display: grid;
	gap: 0.5rem;
	margin: 0;
	padding: 0;
	list-style: none;
}

.play-error {
	display: grid;
	gap: 0.25rem;
	padding: 0.6rem 0.75rem;
	border: 1px solid var(--link);
	border-radius: 10px;
	background: var(--accent-soft);
}

.play-error-message {
	margin: 0;
	font-size: 0.9rem;
}

.play-error-code {
	margin-right: 0.45rem;
	color: var(--link);
	font-family: $font-mono;
	font-weight: 700;
}

.play-error-hint {
	margin: 0;
	color: var(--muted);
	font-size: 0.85rem;
}

.play-error-where {
	justify-self: start;
	padding: 0;
	border: 0;
	background: none;
	color: var(--link);
	font-family: $font-mono;
	font-size: 0.8rem;
	text-decoration: underline;
	cursor: pointer;
}
</style>
