<script>
import { props, type Style } from "lusia";
import { scrollBetween } from "../motion/home-scroll.ts";

const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

// One shared backdrop behind the whole page. Each layer moves at its own speed.
const { follow, storm } = props({
	follow: null as HTMLElement | null,
	storm: false,
});

function layer(from: Style, to: Style) {
	return reduced ? [] : scrollBetween(follow, from, to);
}

const rays = layer(
	{ translate: "0 0", rotate: "0deg" },
	{ translate: "0 -15vh", rotate: "30deg" },
);
const dots = layer({ translate: "0 0" }, { translate: "0 -25vh" });
const sparkles = layer({ translate: "0 0" }, { translate: "0 -45vh" });

function petal(
	left: number,
	size: number,
	delay: number,
	duration: number,
	drift: number,
) {
	const css = [
		`--left: ${left}%`,
		`--size: ${size}px`,
		`--delay: ${delay}s`,
		`--duration: ${duration}s`,
		`--drift: ${drift}px`,
	].join("; ");
	return { id: left, css };
}

const petals = [
	petal(6, 14, -4, 26, 30),
	petal(16, 10, -9, 30, -24),
	petal(27, 12, -2, 28, 18),
	petal(38, 16, -12, 34, -36),
	petal(49, 9, -6, 25, 22),
	petal(58, 13, -15, 32, -18),
	petal(67, 11, -1, 27, 28),
	petal(76, 15, -8, 35, -30),
	petal(84, 10, -11, 29, 20),
	petal(91, 12, -5, 26, -22),
	petal(12, 8, -13, 24, 16),
	petal(72, 9, -3, 30, -14),
];

// The storm petals fall fast and only show while the Konami code is active.
const stormPetals = [
	petal(10, 16, -1, 4, 60),
	petal(25, 12, -2, 3.5, -50),
	petal(40, 18, -0.5, 4.5, 40),
	petal(55, 14, -3, 3.8, -70),
	petal(70, 16, -1.5, 4.2, 30),
	petal(85, 12, -2.5, 3.6, -40),
];
</script>

<div class="home-bg" aria-hidden="true">
	<span class="bg-rays" animate={rays}></span>
	<span class="bg-dots" animate={dots}></span>
	<div class="bg-sparkles" animate={sparkles}>
		<span class="bg-sparkle s1"></span>
		<span class="bg-sparkle s2"></span>
		<span class="bg-sparkle s3"></span>
		<span class="bg-sparkle s4"></span>
		<span class="bg-sparkle s5"></span>
		<span class="bg-sparkle s6"></span>
	</div>
	<div class="petals">
		<EACH {petals} as="{item}">
			<span class="petal" style={item.css}></span>
		</EACH>
		<IF {storm}>
			<EACH {stormPetals} as="{item}">
				<span class="petal storm" style={item.css}></span>
			</EACH>
		</IF>
	</div>
</div>
