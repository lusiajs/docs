<script>
  import { WHEN, variable } from "lusiajs";
  import Highlight from "./Highlight.lusia";
  import { buildSearchIndex } from "../search/build.ts";
  import { groupJump, groupStarts, moveIndex } from "../search/keys.ts";
  import { countRows, groupsFor, rowCounts, type Row } from "../search/rank.ts";
  import { loadRecent, saveRecent, withRecent } from "../search/recent.ts";
  import { closeSearch, openSearch, searchOpen } from "../search/state.ts";

  // Opening glides the box to the top centre. The backdrop fades in behind it.
  const index = buildSearchIndex();
  const typed = variable("");
  const active = variable(0);
  const recent = variable(loadRecent());
  const field = variable<HTMLInputElement | null>(null);
  const list = variable<HTMLElement | null>(null);

  const groups = variable.compute(() =>
    groupsFor(index, typed.value, recent.value),
  );
  const starts = variable.compute(() => groupStarts(rowCounts(groups.value)));
  const count = variable.compute(() => countRows(groups.value));
  const noResults = variable.compute(
    () => typed.value.trim() !== "" && count.value === 0,
  );

  const glide = { when: WHEN.MOVE_OR_RESIZE, duration: 380 };
  const fadeIn = { 0: { opacity: 0 }, 1: { opacity: 1 } };
  const backdrop = {
    style: fadeIn,
    when: searchOpen,
    duration: 250,
  };

  // The results card drops from the box on open and rolls back on close.
  const panelIn = {
    0: { opacity: 0, translate: "0px -8px", scale: 0.97 },
    1: { opacity: 1, translate: "0px 0px", scale: 1 },
  };
  const panelOut = {
    0: { opacity: 1, translate: "0px 0px", scale: 1 },
    1: { opacity: 0, translate: "0px -8px", scale: 0.97 },
  };
  const panelMotion = [
    { style: panelIn, when: WHEN.ATTACH, duration: 220, keep: false },
    {
      style: panelOut,
      when: WHEN.DETACH,
      duration: 160,
    },
    { when: WHEN.RESIZE, duration: 260 },
  ];

  // Rows rise in turn. Rows past the twelfth start together, so long lists stay quick.
  const rowIn = {
    0: { opacity: 0, translate: "0px 6px" },
    1: { opacity: 1, translate: "0px 0px" },
  };
  const ROW_STEP_MS = 25;
  const MAX_STAGGERED_ROWS = 12;

  function rowMotion(index: number) {
    const stagger = Math.min(index, MAX_STAGGERED_ROWS) * ROW_STEP_MS;
    return { style: rowIn, when: WHEN.ATTACH, duration: 200, delay: stagger };
  }

  // The shortcut hint shows the key of this platform: Cmd on Apple devices, Ctrl elsewhere.
  const APPLE_PLATFORM = /Mac|iPhone|iPad/;
  const shortcutModifier = APPLE_PLATFORM.test(navigator.platform) ? "⌘" : "Ctrl";

  // Focus follows the open state: opening focuses the field, closing leaves it.
  variable.autoRun(() => {
    if (searchOpen.value) field.value?.focus();
    else field.value?.blur();
  });

  function onInput() {
    active.value = 0;
  }

  function setActive(index: number) {
    active.value = index;
  }

  function onKey(event: KeyboardEvent) {
    switch (event.key) {
      case "ArrowDown":
        event.preventDefault();
        active.value = moveIndex(active.value, count.value, 1);
        break;
      case "ArrowUp":
        event.preventDefault();
        active.value = moveIndex(active.value, count.value, -1);
        break;
      case "Tab":
        event.preventDefault();
        active.value = groupJump(
          starts.value,
          active.value,
          event.shiftKey ? -1 : 1,
        );
        break;
      case "Enter":
        event.preventDefault();
        activeRow()?.click();
        break;
      case "Escape":
        closeSearch();
        break;
    }
  }

  function rowClass(index: number): string {
    return index === active.value ? "search-row is-active" : "search-row";
  }

  function activeRow(): HTMLElement | null | undefined {
    return list.value?.querySelector<HTMLElement>(
      `[data-index="${active.value}"]`,
    );
  }

  // A term row fills the box. A result row closes the palette and remembers the term.
  function pick(event: MouseEvent, row: Row) {
    if (row.term !== undefined) {
      event.preventDefault();
      typed.value = row.term;
      active.value = 0;
      return;
    }
    if (typed.value.trim() !== "") {
      recent.value = withRecent(recent.value, typed.value.trim());
      saveRecent(recent.value);
    }
    closeSearch();
  }
</script>

<div class="search-palette">
  <div
    class={searchOpen.value ? "search-backdrop is-open" : "search-backdrop"}
    animate={backdrop}
    onclick={closeSearch}
  ></div>
  <div
    class={searchOpen.value ? "search is-open" : "search"}
    animate={glide}
  >
    <div class="search-field">
      <span class="material-symbols-rounded search-glyph" aria-hidden="true"
        >search</span
      >
      <input
        id="search"
        type="search"
        role="combobox"
        aria-controls="search-results"
        aria-label="Search the docs"
        placeholder="Search the docs"
        autocomplete="off"
        bind-value={typed}
        bind-element={field}
        oninput={onInput}
        onkeydown={onKey}
        onfocus={openSearch}
      />
      <span class="search-shortcut" aria-hidden="true">
        <kbd>{shortcutModifier}</kbd><kbd>K</kbd>
      </span>
      <button
        class="icon-button search-close"
        type="button"
        aria-label="Close search"
        onclick={closeSearch}
      >
        <span class="material-symbols-rounded" aria-hidden="true">close</span>
      </button>
    </div>

    <IF {searchOpen.value}>
      <div
        class="search-panel"
        id="search-results"
        role="listbox"
        bind-element={list}
        animate={panelMotion}
      >
        <div class="search-results">
          <IF {noResults.value}>
            <p class="search-empty">
              No results for "{typed.value}". Try one of these:
            </p>
          </IF>
          <EACH {groups.value} as={group}>
            <section class="search-group">
              <h3 class="search-group-title">{group.label}</h3>
              <EACH {group.rows} as={row}>
                <a
                  class={rowClass(row.index)}
                  href={row.href}
                  data-index={row.index}
                  role="option"
                  animate={rowMotion(row.index)}
                  onclick={(event) => pick(event, row)}
                  onpointerenter={() => setActive(row.index)}
                >
                  <span
                    class="material-symbols-rounded search-icon"
                    aria-hidden="true"
                    >{row.icon}</span
                  >
                  <span class="search-text">
                    <span class="search-title"
                      ><Highlight parts={row.title}
                    /></span>
                    <IF {row.summary.length > 0}>
                      <span class="search-summary">
                        <Highlight parts={row.summary} />
                      </span>
                    </IF>
                  </span>
                  <IF {row.section !== ""}>
                    <span class="chip search-section">{row.section}</span>
                  </IF>
                </a>
              </EACH>
            </section>
          </EACH>
          <p class="search-hint" aria-hidden="true">
            <kbd>Up</kbd><kbd>Down</kbd> move <kbd>Tab</kbd> next group
            <kbd>Enter</kbd> open <kbd>Esc</kbd> close
          </p>
        </div>
      </div>
    </IF>
  </div>
</div>
