<script>
  import { props, variable } from "lusiajs";
  import type { SourceFile } from "../catalog.ts";
  import { languageFor } from "../highlight/highlight.ts";
  import { nextIndex } from "../tab-keys.ts";
  import CodeBlock from "./CodeBlock.lusia";

  const { sources } = props({ sources: [] as SourceFile[] });
  const active = variable(0);

  function selectTab(index: number) {
    active.value = index;
  }

  function fileName(path: string): string {
    return path.split("/").pop() ?? path;
  }

  // Arrow keys move between tabs, like a native tab list.
  function onTabKey(event: KeyboardEvent) {
    const next = nextIndex(event.key, active.value, sources.value.length);
    if (next === null) return;
    event.preventDefault();
    selectTab(next);
    const tabs = (event.currentTarget as HTMLElement).children;
    (tabs[next] as HTMLElement).focus();
  }
</script>

<div class="code-panel">
  <div class="code-head">
    <IF {sources.value.length > 1}>
      <div class="code-tabs" role="tablist" onkeydown={onTabKey}>
        <EACH {sources} as={source} index={i}>
          <button
            class="code-tab"
            type="button"
            role="tab"
            aria-selected={String(active.value === i.value)}
            onclick={() => selectTab(i.value)}
          >
            <span class="material-symbols-rounded" aria-hidden="true"
              >description</span
            >
            {fileName(source.path)}
          </button>
        </EACH>
      </div>
    <ELSE>
      <span class="material-symbols-rounded" aria-hidden="true"
        >description</span
      >
      <span class="file-name">{fileName(sources.value[0].path)}</span>
    </IF>
    <button class="copy-button" type="button" aria-label="Copy the code">
      <span class="material-symbols-rounded" aria-hidden="true"
        >content_copy</span
      >
    </button>
  </div>
  <EACH {sources} as={source} index={i}>
    <div class="code-body" hidden={active.value !== i.value}>
      <CodeBlock text={source.text} language={languageFor(source.path)} />
    </div>
  </EACH>
</div>
