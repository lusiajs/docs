<script>
import { props, variable } from "lusiajs";
import type { Animate } from "lusiajs";

const { title, icon, tag, tone, motion } = props({
	title: "",
	icon: "",
	tag: "",
	tone: "var(--pink)",
	motion: [] as Animate[],
});

const toneStyle = variable.compute(() => `--tone: ${tone.value}`);
</script>

<article class="feature-card" style={toneStyle} animate={motion.peek()}>
	<span class="tag">{tag}</span>
	<div class="feature-head">
		<span class="feature-icon">
