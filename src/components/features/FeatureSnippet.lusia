<script>
  import { onAttach, props, variable } from "lusiajs";
  import { highlightInto } from "../../highlight/highlight.ts";

  const { code, language } = props({ code: "", language: "lusia" });
  const block = variable<HTMLElement | null>(null);

  onAttach(() => {
    highlightInto(block.value!, code.peek(), language.peek());
  });
</script>

<pre class="snippet"><code bind-element={block}></code></pre>

<style scoped>
  @use "../../styles/theme" as *;

  .snippet {
    flex: none;
    margin: 0;
    padding: 0.75rem 1rem;
    overflow: auto;
    border: 2px solid var(--line);
    border-radius: 18px;
    background: var(--code);
    font-family: $font-mono;
    font-size: 0.78rem;
    line-height: 1.5;
  }

  .snippet code {
    font-family: inherit;
    white-space: pre;
  }
</style>
