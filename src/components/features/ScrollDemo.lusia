<script>
  import { SCREEN, onAttach, variable } from "lusiajs";

  const reduced = SCREEN.REDUCED_MOTION.value;

  const items = [
    { id: 1, label: "Rise" },
    { id: 2, label: "Turn" },
    { id: 3, label: "Fade" },
    { id: 4, label: "Rise" },
    { id: 5, label: "Turn" },
    { id: 6, label: "Fade" },
    { id: 7, label: "Rise" },
    { id: 8, label: "Turn" },
  ];

  const box = variable<HTMLElement | null>(null);
  const rows = items.map(() => variable<HTMLElement | null>(null));

  // How far each item has come up into the box, from 0 (below) to 1 (fully in view).
  const progress = variable<number[]>(items.map(() => (reduced ? 1 : 0)));

  function clamp01(value: number): number {
    return Math.min(1, Math.max(0, value));
  }

  function rowProgress(row: HTMLElement, el: HTMLElement): number {
    const view = el.clientHeight;
    return clamp01((el.scrollTop + view - row.offsetTop) / (view * 0.7));
  }

  function measure() {
    const el = box.peek();
    if (!el || reduced) return;
    progress.value = rows.map((row) => rowProgress(row.peek()!, el));
  }

  onAttach(() => {
    measure();
    const el = box.peek();
    if (el) listen(el, "scroll", measure);
  });

  function itemStyle(index: number): string {
    return `--p: ${progress.value[index] ?? 0}`;
  }
</script>

<div class="scroll-demo">
  <p class="hint">Scroll the box</p>
  <div class="box" bind-element={box}>
    <ul class="list">
      <EACH {items} as={item} index={i} key={item.id}>
        <li
          class="item"
          style={itemStyle(i.value)}
          bind-element={rows[i.value]}
        >
          <span>{item.label} {i.value + 1}</span>
        </li>
      </EACH>
    </ul>
  </div>
</div>

<style scoped>
  .scroll-demo {
    display: grid;
    width: 100%;
    gap: 0.8rem;
    color: var(--fg);
  }

  .hint {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .box {
    position: relative;
    height: min(46vh, 22rem);
    overflow-y: auto;
    padding: 0.8rem;
    border-radius: 24px;
    background: color-mix(in srgb, var(--tone, var(--mint)) 14%, var(--card));
    overscroll-behavior: contain;
  }

  .list {
    display: grid;
    gap: 0.9rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .item {
    display: grid;
    place-items: center;
    min-height: 4.5rem;
    border-radius: 20px;
    background: var(--tone, var(--mint));
    color: #2a2033;
    font-size: 1.2rem;
    font-weight: 800;
    opacity: var(--p);
    transform: translateY(calc((1 - var(--p)) * 60px))
      rotate(calc((1 - var(--p)) * -14deg));
    will-change: transform, opacity;
  }

  @media (prefers-reduced-motion: reduce) {
    .item {
      transform: none;
      opacity: 1;
    }
  }
</style>
