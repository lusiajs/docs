<script>
  import { PRESET, ON, variable, props } from "lusiajs";

  const { name, active, onSelect } = props(class {
    name = "";
    active = "";
    onSelect = (value: string) => {};
  });

  // A new tab slides in. A closed tab fades, and the tabs after it slide over the gap.
  const tabMotion = [
    { play: PRESET.SLIDE_DOWN, on: ON.ATTACH, duration: 250 },
    {
      play: PRESET.FADE_OUT,
      on: ON.DETACH,
      duration: 200,
      options:{ animateSpace: true },
    },
  ];

  const tab = variable<HTMLElement | null>(null);
  const isSelected = variable.compute(() => active === name);
  const selectedText = variable.compute(() => String(isSelected.value));

  // Only the tab strip scrolls. The page keeps its place when a demo mounts.
  function revealTab(el: HTMLElement) {
    const list = el.closest<HTMLElement>('[role="tablist"]');
    if (!list) return;
    const listBox = list.getBoundingClientRect();
    const tabBox = el.getBoundingClientRect();
    const tabLeft =
      tabBox.left - listBox.left - list.clientLeft + list.scrollLeft;
    const tabRight = tabLeft + tabBox.width;
    if (tabLeft < list.scrollLeft) {
      list.scrollLeft = tabLeft;
    } else if (tabRight > list.scrollLeft + list.clientWidth) {
      list.scrollLeft = tabRight - list.clientWidth;
    }
  }

  variable.watch([tab, isSelected], () => {
    const el = tab.peek();
    if (el && isSelected.peek()) revealTab(el);
  });

  function choose() {
    onSelect(name);
  }
</script>

<button
  class="code-tab"
  type="button"
  role="tab"
  aria-selected={selectedText}
  animate={tabMotion}
  bind-element={tab}
  onclick={choose}
>
  <span class="material-symbols-rounded" aria-hidden="true">description</span>
  {name}
</button>
