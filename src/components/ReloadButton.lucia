<script>
import { PRESET, WHEN, controller, props } from "lucia";

const { onReload } = props({ onReload: () => {} });
const spin = controller();
const spinMotion = {
  style: PRESET.SPIN,
  when: WHEN.MANUAL,
  control: spin,
  duration: 600,
  keep: false,
};

function reloadNow() {
  void spin.play();
  onReload.peek()();
}
</script>

<button
  class="icon-button"
  type="button"
  aria-label="Run again"
  title="Run again"
  onclick={reloadNow}
>
  <span
    class="material-symbols-rounded"
    aria-hidden="true"
    animate={spinMotion}
    >refresh</span
  >
</button>
