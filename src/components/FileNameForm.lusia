<script>
  import { onAttach, props, variable } from "lusiajs";

  const { label, initial, placeholder, submitText, types, onSubmit, onCancel } =
    props({
      label: "",
      initial: "",
      placeholder: "",
      submitText: "Save",
      types: [] as readonly string[],
      onSubmit: (name: string): string | undefined => undefined,
      onCancel: () => {},
    });

  const value = variable(initial.peek());
  const problem = variable("");
  const hasProblem = variable.compute(() => problem.value !== "");
  // A false attribute is removed, so aria-invalid takes the text "false".
  const invalid = variable.compute(() => String(hasProblem.value));
  const field = variable<HTMLInputElement | null>(null);

  // The form opens from a click, so the name field takes focus with its text selected.
  onAttach(() => {
    const input = field.peek();
    input?.focus();
    input?.select();
  });

  // The parent returns a problem with the name, or nothing to accept it and close it.
  function submit(event: SubmitEvent) {
    event.preventDefault();
    problem.value = onSubmit.peek()(value.peek().trim()) ?? "";
  }

  function cancel() {
    onCancel.peek()();
  }

  // Escape closes the form without the page's own Escape handling running too.
  function onFieldKey(event: KeyboardEvent) {
    if (event.key !== "Escape") return;
    event.stopPropagation();
    cancel();
  }
</script>

<form class="file-form" onsubmit={submit}>
  <label class="file-form-field">
    <span class="file-form-label">{label}</span>
    <input
      type="text"
      placeholder={placeholder}
      bind-value={value}
      bind-element={field}
      aria-invalid={invalid}
      autocomplete="off"
      spellcheck="false"
      onkeydown={onFieldKey}
    />
  </label>
  <ul class="file-form-types" aria-label="Supported file types">
    <EACH {types} as={type} key={type}>
      <li class="file-form-type">{type}</li>
    </EACH>
  </ul>
  <div class="file-form-actions">
    <button class="chip" type="submit">{submitText}</button>
    <button class="chip" type="button" onclick={cancel}>Cancel</button>
  </div>
  <IF {hasProblem}>
    <p class="file-form-problem" role="alert">{problem}</p>
  </IF>
</form>

<style>
  @use "../styles/theme" as *;

  .file-form {
    display: grid;
    gap: 0.5rem;
    padding: 0.75rem;
    border-bottom: 1px solid var(--line);
  }

  .file-form-field {
    display: grid;
    gap: 0.25rem;
  }

  .file-form-label {
    color: var(--muted);
    font-size: 0.8rem;
  }

  input {
    padding: 0.45rem 0.6rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--card);
    color: var(--fg);
    font: inherit;
    font-family: $font-mono;
    font-size: 16px;
  }

  .file-form-types {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .file-form-type {
    padding: 0.1rem 0.5rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--code);
    color: var(--muted);
    font-family: $font-mono;
    font-size: 0.75rem;
  }

  .file-form-actions {
    display: flex;
    gap: 0.5rem;
  }

  .file-form-problem {
    margin: 0;
    color: var(--link);
    font-size: 0.85rem;
  }

  input[aria-invalid="true"] {
    border-color: var(--link);
  }

  input:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 1px;
  }
</style>
