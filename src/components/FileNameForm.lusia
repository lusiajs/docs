<script>
import { onAttach, props, variable } from "lusia";

const { label, initial, submitText, onSubmit, onCancel } = props({
	label: "",
	initial: "",
	submitText: "Save",
	onSubmit: (name: string): string | undefined => undefined,
	onCancel: () => {},
});

const value = variable(initial.peek());
const problem = variable("");
const hasProblem = variable.compute(() => problem.value !== "");
const field = variable<HTMLInputElement | null>(null);

// The form opens from a click, so the name field takes focus with its text selected.
onAttach(() => {
	const input = field.peek();
	input?.focus();
	input?.select();
});

// The parent returns a problem with the name, or nothing to accept it and close the form.
function submit(event: SubmitEvent) {
	event.preventDefault();
	problem.value = onSubmit.peek()(value.peek().trim()) ?? "";
}

function cancel() {
	onCancel.peek()();
}
</script>

<form class="file-form" onsubmit={submit}>
	<label class="file-form-field">
		<span class="file-form-label">{label}</span>
		<input
			type="text"
			bind-value={value}
			bind-element={field}
			autocomplete="off"
			spellcheck="false"
		/>
	</label>
	<div class="file-form-actions">
		<button class="chip" type="submit">{submitText}</button>
		<button class="chip" type="button" onclick={cancel}>Cancel</button>
	</div>
	<IF {hasProblem}>
		<p class="file-form-problem" role="alert">{problem}</p>
	</IF>
</form>

<style>
@use "../styles/theme" as *;

.file-form {
	display: grid;
	gap: 0.5rem;
	padding: 0.75rem;
	border-bottom: 1px solid var(--line);
}

.file-form-field {
	display: grid;
	gap: 0.25rem;
}

.file-form-label {
	color: var(--muted);
	font-size: 0.8rem;
}

input {
	padding: 0.45rem 0.6rem;
	border: 1px solid var(--line);
	border-radius: 8px;
	background: var(--card);
	color: var(--fg);
	font: inherit;
	font-family: $font-mono;
	font-size: 16px;
}

.file-form-actions {
	display: flex;
	gap: 0.5rem;
}

.file-form-problem {
	margin: 0;
	color: var(--link);
	font-size: 0.85rem;
}
</style>
