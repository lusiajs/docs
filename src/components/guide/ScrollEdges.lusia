<svg
  class="edges"
  viewBox="0 0 360 200"
  role="img"
  aria-label="A point on the element is matched with a point on the screen"
>
  <rect class="screen" x="20" y="20" width="320" height="160" rx="10" />
  <line class="screen-edge" x1="20" x2="340" y1="100" y2="100" />
  <text class="label" x="30" y="40">screen top</text>
  <text class="label" x="30" y="172">screen bottom</text>
  <text class="label" x="250" y="94">screen edge</text>
  <rect class="element" x="130" y="130" width="100" height="30" rx="6" />
  <line class="link" x1="180" x2="180" y1="130" y2="100" />
  <text class="label" x="240" y="150">element edge</text>
</svg>

<style scoped>
  .edges {
    width: 100%;
