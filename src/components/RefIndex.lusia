<script>
import { props } from "lusiajs";
import { pageLink, referencePath } from "../page-link.ts";

// The index mirrors the Guide sidebar's markup, so both share its styles and scripts.
interface IndexLink {
	id: string;
	name: string;
	icon: string;
}

interface IndexBlock {
	id: string;
	label?: string;
	links: IndexLink[];
}

interface IndexGroup {
	group: string;
	label: string;
	icon: string;
	color: string;
	blocks: IndexBlock[];
}

const { groups } = props({ groups: [] as IndexGroup[] });
</script>

<EACH {groups} as={group}>
	<div
		class="nav-group"
		data-index-group={group.group}
		style={"--group: " + group.color}
	>
		<button class="nav-title" type="button" aria-expanded="true">
			<span class="group-name">
				<span class="material-symbols-rounded" aria-hidden="true"
					>{group.icon}</span
				>
				{group.label}
			</span>
			<span class="material-symbols-rounded chevron" aria-hidden="true"
				>expand_more</span
			>
		</button>
		<div class="nav-items">
			<div>
				<EACH {group.blocks} as={block}>
					<div class="nav-subgroup" data-index-block={block.id}>
						<IF {block.label}>
							<button
								class="nav-title nav-subtitle"
								type="button"
								aria-expanded="true"
							>
								<span class="group-name">{block.label}</span>
								<span
									class="material-symbols-rounded chevron"
									aria-hidden="true"
								>
									expand_more
								</span>
							</button>
						</IF>
						<div class="nav-items">
							<div>
								<nav
									class="nav-links"
									aria-label={group.label}
								>
									<EACH {block.links} as={link}>
										<a
											href={pageLink(referencePath, link.id)}
											data-ref-link={link.id}
										>
											<span
												class="material-symbols-rounded"
												aria-hidden="true"
											>
												{link.icon}
											</span>
											<code class="nav-label"
												>{link.name}</code
											>
										</a>
									</EACH>
								</nav>
							</div>
						</div>
					</div>
				</EACH>
			</div>
		</div>
	</div>
</EACH>
