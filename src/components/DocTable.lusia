<script>
import { props } from "lusiajs";

const { head, rows } = props({ head: [] as string[], rows: [] as string[][] });
</script>

<div class="doc-table-wrap">
	<table class="doc-table">
		<thead>
			<tr>
				<EACH {head} as={cell}>
					<th>{cell}</th>
				</EACH>
			</tr>
		</thead>
		<tbody>
			<EACH {rows} as={row}>
				<tr>
					<EACH {row} as={cell}>
						<td>{cell}</td>
					</EACH>
				</tr>
			</EACH>
		</tbody>
	</table>
</div>

