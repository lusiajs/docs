<script>
import { props, variable } from "lusia";
import type { EditorFile } from "../editor/files.ts";

const { files, active, onSelect, onAdd } = props({
	files: [] as EditorFile[],
	active: "",
	onSelect: (name: string) => {},
	onAdd: null as (() => void) | null,
});

const strip = variable<HTMLElement | null>(null);
const showTabs = variable.compute(
	() => files.value.length > 1 || onAdd.value !== null,
);

// Bindings refresh the tabs after this watcher runs, so scroll once they have.
variable.autoRun(() => {
	const source = strip.value;
	const name = active.value;
	if (!source || name === "") return;
	queueMicrotask(() => {
		source
			.querySelector<HTMLElement>('[aria-selected="true"]')
			?.scrollIntoView({ inline: "nearest", block: "nearest" });
	});
});

function select(name: string) {
	onSelect.peek()(name);
}

function add() {
	onAdd.peek()?.();
}

function nextIndex(key: string, current: number, count: number): number | null {
	if (key === "ArrowRight") return (current + 1) % count;
	if (key === "ArrowLeft") return (current - 1 + count) % count;
	if (key === "Home") return 0;
	if (key === "End") return count - 1;
	return null;
}

// Arrow keys move between tabs and focus them, like a native tab list.
function onTabKey(event: KeyboardEvent) {
	const list = files.peek();
	const current = list.findIndex((file) => file.name === active.peek());
	const next = nextIndex(event.key, current, list.length);
	if (next === null) return;
	event.preventDefault();
	select(list[next]?.name ?? "");
	const tabs = (event.currentTarget as HTMLElement).children;
	(tabs[next] as HTMLElement | undefined)?.focus();
}
</script>

<IF {showTabs}>
	<div class="code-tabs-wrap">
		<div
			class="code-tabs"
			role="tablist"
			aria-label="Files"
			onkeydown={onTabKey}
			bind-element={strip}
		>
			<EACH {files} as={file} key={file.name}>
				<button
					class="code-tab"
					type="button"
					role="tab"
					aria-selected={String(active.value === file.name)}
					onclick={() => select(file.name)}
				>
					<span
						class="material-symbols-rounded"
						aria-hidden="true"
						>description</span
					>
					{file.name}
				</button>
			</EACH>
		</div>
		<IF {onAdd.value !== null}>
			<button
				class="code-tab-add"
				type="button"
				aria-label="New file"
				title="New file"
				onclick={add}
			>
				<span class="material-symbols-rounded" aria-hidden="true"
					>add</span
				>
			</button>
		</IF>
	</div>
</IF>
<ELSE>
	<span class="material-symbols-rounded" aria-hidden="true">description</span>
	<span class="file-name">{active}</span>
</ELSE>
