<script>
  import { variable, props } from "lusiajs";
  import type { EditorFile } from "../editor/files.ts";
  import { nextIndex } from "../tab-keys.ts";
  import EditorTab from "./EditorTab.lusia";

  const { files, active, onSelect, onAdd } = props(class {
    files: EditorFile[] = [];
    active = "";
    onSelect = (name: string) => {};
    onAdd: (() => void) | null = null;
  });

  const showTabs = variable.compute(
    () => files.length > 1 || onAdd !== null,
  );

  function select(name: string) {
    onSelect(name);
  }

  function add() {
    onAdd?.();
  }

  // Arrow keys move between tabs and focus them, like a native tab list.
  function onTabKey(event: KeyboardEvent) {
    const list = files;
    const current = list.findIndex((file) => file.name === active);
    const next = nextIndex(event.key, current, list.length);
    if (next === null) return;
    event.preventDefault();
    select(list[next]?.name ?? "");
    const tabs = (event.currentTarget as HTMLElement).children;
    (tabs[next] as HTMLElement | undefined)?.focus();
  }
</script>

<IF {showTabs}>
  <div class="code-tabs-wrap">
    <div
      class="code-tabs"
      role="tablist"
      aria-label="Files"
      onkeydown={onTabKey}
    >
      <EACH {files} as={file} key={file.name}>
        <EditorTab name={file.name} active={active} onSelect={select} />
      </EACH>
    </div>
    <IF {onAdd !== null}>
      <button
        class="code-tab-add"
        type="button"
        aria-label="New file"
        title="New file"
        onclick={add}
      >
        <span class="material-symbols-rounded" aria-hidden="true">add</span>
      </button>
    </IF>
  </div>
<ELSE>
  <span class="material-symbols-rounded" aria-hidden="true">description</span>
  <span class="file-name">{active}</span>
</IF>
