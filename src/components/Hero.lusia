<script>
  import { SCREEN, onAttach, variable, props, WHEN, EASE } from "lusiajs";
  import { homePath, pageLink } from "../page-link.ts";
  import { scrollHint } from "../motion.ts";
  import { heroBetween } from "../motion/hero-slow.ts";
  import { typingFrames } from "../motion/typing.ts";
  import { pull, release } from "../motion/pointer.ts";
  import Mascot from "./Mascot.lusia";
  import HeroLogo from "./HeroLogo.lusia";
  import InstallCommand from "./InstallCommand.lusia";

  const reduced = SCREEN.REDUCED_MOTION.value;

  const { follow } = props({ follow: null as HTMLElement | null });

  // Each letter drops in on its own delay. Hovering a letter wobbles it.
  const letterIn = {
    0: { opacity: 0, translate: "0px 30px" },
    1: [EASE.STYLE.QUART, EASE.OUT, { opacity: 1, translate: "0px 0px" }],
  };
  const letterWobble = {
    default: [EASE.STYLE.SINE, EASE.OUT],
    0: { rotate: "0deg" },
    0.25: { rotate: "-14deg" },
    0.5: { rotate: "10deg" },
    0.75: { rotate: "-5deg" },
    1: { rotate: "0deg" },
  };

  function letterMotion(index: number) {
    if (reduced) return [];
    return [
      {
        style: letterIn,
        when: WHEN.ATTACH,
        more: { animateSpace: true },
        duration: 600,
        delay: 80 + index * 70,
      },
      { style: letterWobble, when: WHEN.HOVER, duration: 500 },
    ];
  }

  // Fixed per letter, so every load looks the same. Units are em.
  const scatters = [
    { x: -0.2, y: -0.3, rotate: -22, scale: 1.06 },
    { x: 0.14, y: 0.2, rotate: 16, scale: 0.94 },
    { x: -0.1, y: -0.2, rotate: -10, scale: 1.04 },
    { x: 0.18, y: -0.32, rotate: 24, scale: 0.96 },
    { x: -0.14, y: 0.24, rotate: -18, scale: 1.05 },
    { x: 0.1, y: -0.18, rotate: 12, scale: 0.95 },
    { x: -0.18, y: 0.14, rotate: 25, scale: 1.04 },
  ];

  // Each letter drifts apart as the page scrolls, on its own path.
  function letterScatter(index: number) {
    if (reduced) return [];
    const offset = scatters[index];
    const to = {
      translate: `${offset.x}em ${offset.y}em`,
      rotate: `${offset.rotate}deg`,
      scale: `${offset.scale}`,
    };
    const from = { translate: "0em 0em", rotate: "0deg", scale: "1" };
    return heroBetween(follow, from, to);
  }

  const letters = "Lusia".split("").map((char, index) => ({
    char,
    scatter: letterScatter(index),
    motion: letterMotion(index),
    slot: variable<HTMLElement | null>(null),
  }));
  const firstSlot = letters[0].slot;

  const fadeIn = {
    0: { opacity: 0 },
    1: [EASE.STYLE.QUART, EASE.OUT, { opacity: 1 }],
  };
  const ctaIn = {
    0: { opacity: 0, translate: "0px 16px" },
    1: [EASE.STYLE.QUART, EASE.OUT, { opacity: 1, translate: "0px 0px" }],
  };

  const eyebrowMotion = {
    style: fadeIn,
    when: WHEN.ATTACH,
    duration: 600,
    delay: 500,
  };
  const taglineMotion = {
    style: fadeIn,
    when: WHEN.ATTACH,
    duration: 600,
    delay: 600,
  };
  const installMotion = {
    style: ctaIn,
    when: WHEN.ATTACH,
    duration: 600,
    delay: 700,
  };
  const ctaMotion = {
    style: ctaIn,
    when: WHEN.ATTACH,
    duration: 600,
    delay: 800,
  };
  const noteMotion = {
    style: fadeIn,
    when: WHEN.ATTACH,
    duration: 600,
    delay: 900,
  };

  // The text drifts up and fades over the first part of the page as the hero scrolls.
  const heroDrift = reduced
    ? []
    : heroBetween(
        follow,
        { opacity: 1, translate: "0 0" },
        { opacity: 0.3, translate: "0 -4vh" },
      );

  // The title moves faster than the rest of the hero, so the two separate as you scroll.
  const titleDrift = reduced
    ? []
    : heroBetween(follow, { translate: "0 0" }, { translate: "0 -8vh" });

  // The two badges fly up and apart, one to each side, to clear the title as it rises.
  const badgeStart = { translate: "0px 0px", rotate: "0deg" };
  const eyebrowDrift = heroBetween(follow, badgeStart, {
    translate: "-12vw -8vh",
    rotate: "-16deg",
  });
  const kaomojiDrift = heroBetween(follow, badgeStart, {
    translate: "12vw -8vh",
    rotate: "14deg",
  });
  const eyebrowAnimate = reduced ? eyebrowMotion : [eyebrowMotion, eyebrowDrift];
  const kaomojiAnimate = reduced ? [] : kaomojiDrift;

  const hintMotion = {
    style: scrollHint,
    loop: true,
    backAndForth: true,
    duration: 1600,
  };

  const phrases = [
    "Single-file components, variables and scoped SCSS.",
    "Variables that update only what changed.",
    "A Bun-native UI framework.",
  ];
  const typed = variable("");
  const frames = typingFrames(phrases);

  // Types the taglines one after another. Reduced motion shows the first one whole.
  onAttach(() => {
    if (reduced) {
      typed.value = phrases[0];
      return;
    }
    let frame = 0;
    const timer = setInterval(() => {
      typed.value = frames[frame];
      frame = (frame + 1) % frames.length;
    }, 55);
    return () => clearInterval(timer);
  });
</script>

<section class="hero" id="top">
  <div class="hero-inner" animate={heroDrift}>
    <p class="eyebrow-row">
      <span class="eyebrow" animate={eyebrowAnimate}
        >A Bun-native UI framework</span
      >
      <span class="badge-kaomoji" animate={kaomojiAnimate}>
        <Mascot />
      </span>
    </p>
    <h1 class="hero-title" aria-label="Lusia" animate={titleDrift}>
      <HeroLogo letter={firstSlot} />
      <EACH {letters} as="{letter}">
        <span
          class="letter-slot"
          aria-hidden="true"
          animate={letter.scatter}
          bind-element={letter.slot}
        >
          <span class="letter" animate={letter.motion}> {letter.char} </span>
        </span>
      </EACH>
    </h1>
    <p class="tagline" animate={taglineMotion}>
      <span class="typed">{typed}</span
      ><span class="caret" aria-hidden="true"></span>
    </p>
    <div class="install" animate={installMotion}>
      <InstallCommand />
    </div>
    <div class="cta" animate={ctaMotion}>
      <a
        class="button rainbow magnetic"
        href="/guide"
        onpointermove={pull}
        onpointerleave={release}
      >
        <span class="material-symbols-rounded" aria-hidden="true"
          >arrow_forward</span
        >
        Get started
      </a>
      <a
        class="button github magnetic"
        href="https://github.com/lusiajs/lusia"
        target="_blank"
        rel="noopener noreferrer"
        onpointermove={pull}
        onpointerleave={release}
      >
        <svg
          class="github-mark"
          viewBox="0 0 24 24"
          aria-hidden="true"
          focusable="false"
        >
          <path
            d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91
              .58.11.79-.25.79-.55 0-.27-.01-1.17-.02-2.12-3.2.7-3.87-1.36
              -3.87-1.36-.52-1.33-1.28-1.68-1.28-1.68-1.04-.71.08-.7.08-.7
              1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.69 1.25 3.35.96.1-.75
              .4-1.25.72-1.54-2.55-.29-5.23-1.28-5.23-5.68 0-1.26.45-2.28
              1.18-3.09-.12-.29-.51-1.46.11-3.05 0 0 .96-.31 3.15 1.18a10.9
              10.9 0 0 1 5.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.59.23
              2.76.11 3.05.74.81 1.18 1.83 1.18 3.09 0 4.41-2.69 5.38-5.25
              5.67.41.35.77 1.05.77 2.12 0 1.53-.01 2.76-.01 3.14 0 .3.2.67
              .8.55A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"
            fill="currentColor"
          />
        </svg>
        GitHub
      </a>
      <a
        class="button npm magnetic"
        href="https://www.npmjs.com/package/lusiajs"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Lusia on npm"
        onpointermove={pull}
        onpointerleave={release}
      >
        <svg
          class="github-mark"
          viewBox="0 0 24 24"
          aria-hidden="true"
          focusable="false"
        >
          <path
            fill-rule="evenodd"
            d="M0 7h24v10H0V7Z
              M2.5 9H7.5V15H6V10.5H4V15H2.5Z
              M9.5 9H14.5V13.5H11V15H9.5Z
              M15.5 9H22V15H20.5V10.5H19.2V15H17.7V10.5H16.5V15H15.5Z"
            fill="currentColor"
          />
        </svg>
        npm
      </a>
      <a
        class="button vscode magnetic"
        href="https://marketplace.visualstudio.com/items?itemName=lusia.lusia-vscode"
        target="_blank"
        rel="noopener noreferrer"
        aria-label="Lusia for VS Code"
        onpointermove={pull}
        onpointerleave={release}
      >
        <svg
          class="github-mark"
          viewBox="0 0 24 24"
          aria-hidden="true"
          focusable="false"
        >
          <path
            d="M17.5 2 9 9.4 4.6 6 3 6.8v10.4l1.6.8L9 14.6 17.5 22 21 20.3V3.7L17.5 2Z
              M4.5 14.6 7.8 12 4.5 9.4v5.2Z
              M18 17.4 13.1 12 18 6.6v10.8Z"
            fill="currentColor"
          />
        </svg>
        VS Code
      </a>
    </div>
    <p class="wip-note" animate={noteMotion}>
      I wanted to name it Lucia, but that name was taken on npm (╥﹏╥). So it is
      lusia.
    </p>
  </div>
  <a
    class="scroll-hint"
    href={pageLink(homePath, "features")}
    aria-label="Scroll to features"
    animate={hintMotion}
  >
    <span class="material-symbols-rounded" aria-hidden="true"
      >keyboard_arrow_down</span
    >
  </a>
</section>
