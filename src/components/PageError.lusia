<script>
  import { props } from "lusiajs";

  const { onRetry } = props({ onRetry: () => {} });

  function reloadNow() {
    location.reload();
  }

  function retryNow() {
    onRetry.peek()();
  }
</script>

<section class="page-error" role="alert">
  <span class="material-symbols-rounded icon" aria-hidden="true">error</span>
  <h1>This page could not load</h1>
  <p>The site may have been updated. Reload to get the latest version.</p>
  <div class="actions">
    <button class="button primary" type="button" onclick={reloadNow}>
      Reload
    </button>
    <button class="button" type="button" onclick={retryNow}>
      Try again
    </button>
  </div>
</section>

