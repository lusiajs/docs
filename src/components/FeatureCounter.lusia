<script>
import { variable } from "lusia";

const count = variable(0);
const doubled = variable.compute(() => count.value * 2);

function addOne() {
	count.value++;
}
</script>

<div class="counter">
	<p class="count">{count}</p>
	<p class="doubled">Doubled: {doubled}</p>
	<button class="bump" type="button" onclick={addOne}>Add 1</button>
</div>

<style>
@use "../styles/demo" as demo;

.counter {
	display: grid;
	justify-items: center;
	gap: 0.4rem;
	color: var(--fg);

	p {
		margin: 0;
	}

	.count {
		font-family: "M PLUS Rounded 1c", sans-serif;
		font-size: 3.2rem;
		font-weight: 800;
		line-height: 1;
	}

	.doubled {
		color: var(--muted);
		font-size: 0.9rem;
	}

	.bump {
		@include demo.button;
		margin-top: 0.4rem;
	}
}
</style>
