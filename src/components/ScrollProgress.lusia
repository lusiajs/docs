<script>
import { props } from "lusia";
import { scrollBetween } from "../motion/home-scroll.ts";

const { follow } = props({ follow: null as HTMLElement | null });

const fill = scrollBetween(follow, { scale: "0 1" }, { scale: "1 1" });
</script>

<div class="progress-track" aria-hidden="true">
  <div class="progress-bar" animate={fill}></div>
</div>
