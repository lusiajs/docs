<script>
  import { props } from "lusiajs";
  import type { ApiEntry } from "lusiajs/api";
  import { searchText } from "../reference-model.ts";
  import { tileHoverMotion } from "../motion/reference.ts";

  const emptyEntry: ApiEntry = {
    id: "",
    name: "",
    kind: "value",
    group: "basics",
    signature: "",
    summary: "",
    bullets: [],
    example: "",
  };
  const { entry, href } = props(class {
    entry = emptyEntry;
    href = "";
  });

  // The entry never changes after mount, so everything derived from it is computed once.
  const shown = entry;
  const search = searchText(shown);
</script>

<a
  class="ref-tile"
  href={href}
  data-ref-entry={shown.id}
  data-kind={shown.kind}
  data-group={shown.kind}
  data-search={search}
  animate={tileHoverMotion}
>
  <span class="ref-tile-head">
    <span class="chip" data-kind={shown.kind}>{shown.kind}</span>
    <code class="ref-tile-name">{shown.name}</code>
  </span>
  <span class="ref-tile-summary">{shown.summary}</span>
</a>
