<script>
import { props } from "lusiajs";
import type { ApiEntry } from "lusiajs/api";
import { cardMotion } from "../motion/reference.ts";
import { guidePath, pageLink, referencePath } from "../page-link.ts";
import {
	KIND_INFO,
	languageOf,
	parameterRows,
	valueRows,
	wrapSignature,
} from "../reference-model.ts";
import CodeCopy from "./CodeCopy.lusia";

const emptyEntry: ApiEntry = {
	id: "",
	name: "",
	kind: "value",
	group: "basics",
	signature: "",
	summary: "",
	bullets: [],
	example: "",
};
const { entry, previous, next } = props({
	entry: emptyEntry,
	previous: undefined as ApiEntry | undefined,
	next: undefined as ApiEntry | undefined,
});

// The entry never changes after mount, so everything derived from it is computed once.
const shown = entry.peek();
const shownPrevious = previous.peek();
const shownNext = next.peek();
const kindLabel = KIND_INFO[shown.kind].label;
const values = valueRows(shown.members);
const parameters = parameterRows(shown);
const language = languageOf(shown);
const signature = wrapSignature(shown.signature);
const anchor = location.origin + pageLink(referencePath, shown.id);
</script>

<article
	class="ref-card"
	animate={cardMotion}
	id={shown.id}
	data-ref-card
>
	<nav class="ref-crumbs" aria-label="Breadcrumb">
		<a class="ref-link" href={referencePath} data-ref-back>Reference</a>
		<span aria-hidden="true">/</span>
		<span>{kindLabel}</span>
		<span aria-hidden="true">/</span>
		<span><code>{shown.name}</code></span>
	</nav>

	<header class="ref-head">
		<span class="chip" data-kind={shown.kind}>{shown.kind}</span>
		<h3 class="ref-name"><code>{shown.name}</code></h3>
		<button
			class="copy-button ref-anchor"
			type="button"
			data-copy={anchor}
			aria-label={"Copy the link to " + shown.name}
		>
			<span class="material-symbols-rounded" aria-hidden="true"
				>numbers</span
			>
		</button>
	</header>

	<CodeCopy
		text={signature}
		copy={shown.signature}
		language={language}
		className="ref-code"
	/>

	<p class="ref-summary">{shown.summary}</p>

	<section class="ref-block">
		<h4 class="ref-block-title">Example</h4>
		<CodeCopy
			text={shown.example}
			copy={shown.example}
			language={language}
			className="ref-code"
		/>
	</section>

	<IF {values.length > 0}>
		<section class="ref-block">
			<h4 class="ref-block-title">Values</h4>
			<div class="ref-table-wrap">
				<table class="ref-table">
					<thead>
						<tr>
							<th>Value</th>
							<th>What it does</th>
							<th>Default/notes</th>
						</tr>
					</thead>
					<tbody>
						<EACH {values} as={value}>
							<tr data-depth={value.depth}>
								<td><code>{value.name}</code></td>
								<td>{value.summary}</td>
								<td>{value.note}</td>
							</tr>
						</EACH>
					</tbody>
				</table>
			</div>
		</section>
	</IF>

	<IF {parameters.length > 0}>
		<section class="ref-block">
			<h4 class="ref-block-title">Parameters</h4>
			<div class="ref-table-wrap">
				<table class="ref-table">
					<thead>
						<tr>
							<th>Name</th>
							<th>Type</th>
							<th>Optional</th>
						</tr>
					</thead>
					<tbody>
						<EACH {parameters} as={param}>
							<tr>
								<td><code>{param.name}</code></td>
								<td><code>{param.type}</code></td>
								<td>{param.optional ? "Yes" : "No"}</td>
							</tr>
						</EACH>
					</tbody>
				</table>
			</div>
		</section>
	</IF>

	<nav class="ref-nav">
		<IF {shownPrevious}>
			<a class="ref-link ref-nav-prev" href={pageLink(referencePath, shownPrevious.id)}
				>← {shownPrevious.name}</a
			>
		</IF>
		<IF {shownNext}>
			<a class="ref-link ref-nav-next" href={pageLink(referencePath, shownNext.id)}
				>{shownNext.name} →</a
			>
		</IF>
	</nav>

	<footer class="ref-foot">
		<a class="ref-link" href={pageLink(guidePath, shown.id)}>
			Guide <span aria-hidden="true">→</span>
		</a>
	</footer>
</article>
