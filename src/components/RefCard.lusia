<script>
import { props } from "lusia";
import type { ApiEntry } from "../../../reference/api.ts";
import type { Part } from "../keywords.ts";
import { guidePath, pageLink, referencePath } from "../page-link.ts";
import {
	flattenMembers,
	languageOf,
	wrapSignature,
} from "../reference-model.ts";
import CodeCopy from "./CodeCopy.lusia";
import RichText from "./RichText.lusia";

const emptyEntry: ApiEntry = {
	id: "",
	name: "",
	kind: "value",
	group: "basics",
	signature: "",
	summary: "",
	bullets: [],
	example: "",
};
const { entry, parts, previous, next } = props({
	entry: emptyEntry,
	parts: [] as Part[][],
	previous: undefined as ApiEntry | undefined,
	next: undefined as ApiEntry | undefined,
});

// The entry never changes after mount, so everything derived from it is computed once.
const shown = entry.peek();
const shownParts = parts.peek();
const shownPrevious = previous.peek();
const shownNext = next.peek();
const members = flattenMembers(shown.members);
const language = languageOf(shown);
const signature = wrapSignature(shown.signature);
const anchor = location.origin + pageLink(referencePath, shown.id);
</script>

<article class="ref-card" id={shown.id} data-ref-card>
	<header class="ref-head">
		<h3 class="ref-name"><code>{shown.name}</code></h3>
		<span class="chip" data-kind={shown.kind}>{shown.kind}</span>
		<button
			class="copy-button ref-anchor"
			type="button"
			data-copy={anchor}
			aria-label={"Copy the link to " + shown.name}
		>
			<span class="material-symbols-rounded" aria-hidden="true"
				>numbers</span
			>
		</button>
	</header>

	<p class="ref-summary">{shown.summary}</p>

	<CodeCopy
		text={signature}
		copy={shown.signature}
		language={language}
		className="ref-code"
	/>

	<IF {shownParts.length > 0}>
		<ul class="notes">
			<EACH {shownParts} as={line}>
				<li>
					<RichText parts={line} base={referencePath} />
				</li>
			</EACH>
		</ul>
	</IF>

	<IF {members.length > 0}>
		<div class="ref-members-wrap">
			<table class="ref-members">
				<thead>
					<tr>
						<th>Name</th>
						<th>Summary</th>
					</tr>
				</thead>
				<tbody>
					<EACH {members} as={member}>
						<tr data-depth={member.depth}>
							<td><code>{member.name}</code></td>
							<td>{member.summary}</td>
						</tr>
					</EACH>
				</tbody>
			</table>
		</div>
	</IF>

	<details class="ref-example">
		<summary>
			<span class="material-symbols-rounded chevron" aria-hidden="true">
				chevron_right
			</span>
			Example
		</summary>
		<CodeCopy
			text={shown.example}
			copy={shown.example}
			language={language}
			className="ref-code"
		/>
	</details>

	<nav class="ref-nav">
		<IF {shownPrevious}>
			<a class="ref-nav-prev" href={pageLink(referencePath, shownPrevious.id)}
				>← {shownPrevious.name}</a
			>
		</IF>
		<IF {shownNext}>
			<a class="ref-nav-next" href={pageLink(referencePath, shownNext.id)}
				>{shownNext.name} →</a
			>
		</IF>
	</nav>

	<footer class="ref-foot">
		<a class="ref-guide" href={pageLink(guidePath, shown.id)}>
			Guide <span aria-hidden="true">→</span>
		</a>
	</footer>
</article>
