<script>
import { WHEN, PRESET } from "lusiajs";
import type { ApiEntry } from "lusiajs/api";
import { catalog } from "../catalog.ts";
import { headingFlash } from "../flash.ts";
import { buildKeywordIndex, tokenize } from "../keywords.ts";
import { guideGroups, orderedEntries } from "../render.ts";
import { animateSpacePageId, startProjectId } from "../guide-pages.ts";
import AnimateSpace from "./AnimateSpace.lusia";
import CodeBlock from "./CodeBlock.lusia";
import CodePanel from "./CodePanel.lusia";
import DemoRow from "./DemoRow.lusia";
import DocTable from "./DocTable.lusia";
import RichText from "./RichText.lusia";
import StartProject from "./StartProject.lusia";

// Built once from the rendered entries. Text is split into keyword chips once, here.
const demos = Object.values(catalog).flatMap((entry) => entry.demos ?? []);
const keywordIndex = buildKeywordIndex(orderedEntries, demos);

// Plays in when the section enters the screen, and back out when it leaves.
// Only opacity: a transform would make this section the box for fixed demo lines.
const sectionMotion = {
	style: PRESET.FADE_IN,
	when: WHEN.VIEW,
	duration: 600,
	more: { margin: 80, amount: 0.1, reverse: true },
};

// The heading tints briefly when a keyword chip links to its section.
const flashKeys = {
	0: { backgroundColor: "transparent" },
	1: { backgroundColor: "var(--lavender-soft)" },
};

function sectionOf(entry: ApiEntry) {
	const flash = headingFlash(entry.id);
	return {
		entry,
		demos: catalog[entry.id]?.demos ?? [],
		table: catalog[entry.id]?.table ?? null,
		files: catalog[entry.id]?.files ?? [],
		intro: entry.id === startProjectId,
		detail: entry.id === animateSpacePageId,
		subtitle: tokenize(entry.summary, keywordIndex, entry.id),
		bullets: entry.bullets.map((text) =>
			tokenize(text, keywordIndex, entry.id),
		),
		flashMotion: {
			style: flashKeys,
			when: WHEN.MANUAL,
			control: flash,
			duration: 900,
		},
	};
}

// Groups, then their blocks, then the sections: the same order as the sidebar.
const groups = guideGroups.map((group) => ({
	label: group.label,
	color: group.color,
	blocks: group.blocks.map((block) => ({
		id: block.id,
		label: block.label,
		sections: block.entries.map(sectionOf),
	})),
}));

function languageOf(entry: ApiEntry): string {
	return entry.kind === "function" ? "typescript" : "lusia";
}
</script>

<EACH {groups} as={group}>
	<h2 class="guide-group-title" style={"--group: " + group.color}>
		{group.label}
	</h2>
	<EACH {group.blocks} as={block}>
		<IF {block.label}>
			<h3 class="guide-subgroup-title">{block.label}</h3>
		</IF>
		<EACH {block.sections} as={section}>
			<section
				class="doc-section"
				id={section.entry.id}
				animate={sectionMotion}
			>
				<h2 class="doc-title" animate={section.flashMotion}>
					<code class="doc-name">{section.entry.name}</code>
					<span class="doc-subtitle"
						><RichText parts={section.subtitle}
					/></span>
				</h2>
				<CodeBlock
					text={section.entry.signature}
					language={languageOf(section.entry)}
					className="declaration"
				/>
				<ul class="notes">
					<EACH {section.bullets} as={parts}>
						<li><RichText parts={parts} /></li>
					</EACH>
				</ul>
				<IF {section.intro}>
					<StartProject />
				</IF>
				<IF {section.detail}>
					<AnimateSpace />
				</IF>
				<IF {section.table}>
					<DocTable
						head={section.table.head}
						rows={section.table.rows}
					/>
				</IF>
				<IF {section.files.length > 0}>
					<CodePanel sources={section.files} />
				</IF>
				<EACH {section.demos} as={demo}>
					<DemoRow demo={demo} />
				</EACH>
			</section>
		</EACH>
	</EACH>
</EACH>
