<script>
import { props, setup, variable } from "lusia";
import type { EditorFile, EditorJump } from "../editor/files.ts";
import type { EditorSession } from "../editor/session.ts";
import EditorTabs from "./EditorTabs.lusia";

const { files, active, readOnly, edited, toolbar, onChange, onSelect, onReset, jump } =
	props({
		files: [] as EditorFile[],
		active: "",
		readOnly: false,
		edited: false,
		toolbar: true,
		onChange: (name: string, code: string) => {},
		onSelect: (name: string) => {},
		onReset: () => {},
		jump: null as EditorJump | null,
	});

const selected = variable("");
const host = variable<HTMLElement | null>(null);
const copied = variable(false);
const wrap = variable(false);
// A false attribute is removed, so aria-pressed takes the text "false".
const wrapPressed = variable.compute(() => String(wrap.value));
const copyIcon = variable.compute(() =>
	copied.value ? "check" : "content_copy",
);
const status = variable("");
let session: EditorSession | undefined;

// An active file set by the parent takes effect; tabs change the selection after that.
variable.autoRun(() => {
	selected.value = active.value;
});

// Variables are read before the optional call, so they stay tracked until it loads.
variable.autoRun(() => {
	const list = files.value;
	const name = selected.value;
	session?.show(list, name);
});

variable.autoRun(() => {
	const isReadOnly = readOnly.value;
	session?.setReadOnly(isReadOnly);
});

variable.autoRun(() => {
	const isWrapped = wrap.value;
	session?.setWrap(isWrapped);
});

// A new jump object moves the cursor, even to the place it was last at.
variable.autoRun(() => {
	const target = jump.value;
	if (!target) return;
	selected.value = target.file;
	session?.reveal(target.file, target.line, target.column);
});

// The editor code loads on first mount, so a page without it stays small.
setup(() => {
	let closed = false;
	import("../editor/session.ts")
		.then(({ EditorSession }) => {
			if (closed) return;
			session = new EditorSession(host.peek()!, {
				files: files.peek(),
				name: selected.peek(),
				readOnly: readOnly.peek(),
				wrap: wrap.peek(),
				onChange: changed,
			});
		})
		.catch(() => {
			status.value = "The editor could not load.";
		});
	return () => {
		closed = true;
		session?.destroy();
		session = undefined;
	};
});

function changed(name: string, code: string) {
	onChange.peek()(name, code);
}

function select(name: string) {
	selected.value = name;
	onSelect.peek()(name);
}

const formatFailed = "Could not format this file. Fix the syntax first.";

function reset() {
	onReset.peek()();
}

function toggleWrap() {
	wrap.value = !wrap.value;
}

function formatCode() {
	session?.format().then((formatted) => {
		status.value = formatted ? "" : formatFailed;
	});
}

async function copyCode() {
	if (!session) return;
	try {
		await navigator.clipboard.writeText(session.text());
		copied.value = true;
		setTimeout(() => (copied.value = false), 1500);
	} catch {
		status.value = "Copy failed. Select the code and copy it instead.";
	}
}
</script>

<div class="code-panel code-editor">
	<IF {toolbar.value}>
		<div class="code-head">
			<EditorTabs files={files} active={selected} onSelect={select} />
			<IF {edited.value}>
				<span class="edited-mark">Edited</span>
				<button class="reset-button" type="button" onclick={reset}>
					Reset
				</button>
			</IF>
			<button
				class="icon-button"
				type="button"
				aria-label="Wrap lines"
				aria-pressed={wrapPressed}
				title="Wrap lines"
				onclick={toggleWrap}
			>
				<span class="material-symbols-rounded" aria-hidden="true"
					>wrap_text</span
				>
			</button>
			<button
				class="icon-button"
				type="button"
				aria-label="Format the code"
				title="Format (Shift+Alt+F)"
				disabled={readOnly}
				onclick={formatCode}
			>
				<span class="material-symbols-rounded" aria-hidden="true"
					>format_align_left</span
				>
			</button>
			<button
				class="icon-button"
				type="button"
				aria-label="Copy the code"
				onclick={copyCode}
			>
				<span class="material-symbols-rounded" aria-hidden="true"
					>{copyIcon}</span
				>
			</button>
		</div>
	</IF>
	<div class="editor-body" bind-element={host}></div>
	<IF {toolbar.value}>
		<p class="editor-hint">
			Tab indents. Press Esc to leave the editor. Shift+Alt+F formats.
		</p>
		<p class="editor-status" role="status">{status}</p>
	</IF>
</div>

<style>
@use "../styles/theme" as *;

.code-editor {
	.editor-body {
		min-width: 0;
	}

	.edited-mark {
		flex: none;
		padding: 0.1rem 0.5rem;
		border-radius: 999px;
		background: var(--lavender-soft);
		color: var(--fg);
		font-size: 0.75rem;
	}

	.reset-button {
		flex: none;
		padding: 0.25rem 0.6rem;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: transparent;
		color: var(--muted);
		font: inherit;
		font-size: 0.78rem;
		cursor: pointer;

		&:hover {
			border-color: var(--accent);
			color: var(--accent);
		}
	}

	:global(.cm-editor) {
		font-family: $font-mono;
		font-size: 0.9rem;
	}

	:global(.cm-scroller) {
		min-height: 14rem;
		max-height: 70vh;
	}

	// 16px stops iOS from zooming in when the editor takes focus.
	@media (max-width: 40em) {
		:global(.cm-editor) {
			font-size: 16px;
		}
	}

	.editor-hint {
		margin: 0;
		padding: 0.4rem 0.9rem 0;
		color: var(--muted);
		font-size: 0.78rem;
	}

	.editor-status {
		margin: 0;
		padding: 0.2rem 0.9rem 0.6rem;
		min-height: 1.2rem;
		color: var(--link);
		font-size: 0.8rem;
	}
}
</style>
