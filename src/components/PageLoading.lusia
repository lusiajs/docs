<script>
  import { ON } from "lusiajs";
  import LoadingMark from "./LoadingMark.lusia";

  const fadeOut = {
    0: { opacity: 1 },
    1: { opacity: 0 },
  };
</script>

<div
  class="page-loading"
  role="status"
  aria-label="Loading the page"
  animate={{ play: fadeOut, on: ON.DETACH, duration: 200 }}
>
  <LoadingMark />
</div>

<style>
  .page-loading {
    display: grid;
    place-items: center;
    min-height: 60vh;
    padding: 3rem 1rem;
  }
</style>
