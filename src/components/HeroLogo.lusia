<script>
  import {
    EASE,
    EVENT,
    SCREEN,
    ON,
    listen,
    onAttach,
    props,
    variable,
  } from "lusiajs";
  import { wobbleStyle } from "../motion/wobble.ts";

  const reduced = SCREEN.REDUCED_MOTION.value;

  const { letter } = props({ letter: null as HTMLElement | null });

  const logoEl = variable<HTMLElement | null>(null);

  // The title is centered, so the first letter's position is read from the DOM.
  function placeLogo() {
    const logo = logoEl.value;
    const title = logo?.parentElement;
    const firstLetter = letter.value;
    if (!logo || !title || !firstLetter) return;
    title.style.setProperty("--title-pad", `${titlePadding(logo)}px`);
    logo.style.setProperty("--letter-left", `${firstLetter.offsetLeft}px`);
  }

  // The left margin is the logo width plus the gap. Padding by it moves the text by half.
  function titlePadding(logo: HTMLElement) {
    if (getComputedStyle(logo).display === "none") return 0;
    return -parseFloat(getComputedStyle(logo).marginLeft);
  }

  // The size listener runs at start, and again on each font swap or resize of the title.
  onAttach(() => {
    const title = logoEl.peek()?.parentElement;
    if (title) listen(title, EVENT.SIZE, placeLogo);
  });

  // Grows in with the first letter. Reduced motion shows it at once.
  const logoIn = {
    0: { opacity: 0, scale: "0.6" },
    1: [EASE.STYLE.QUART, EASE.OUT, { opacity: 1, scale: "1" }],
  };
  const logoMotion = reduced
    ? []
    : [
        {
          play: logoIn,
          on: ON.ATTACH,
          options:{ animateSpace: false },
          duration: 600,
          delay: 80,
        },
        { play: wobbleStyle, on: ON.HOVER, duration: 500 },
      ];
</script>

<img
  class="hero-logo"
  src="/logo-animated.svg"
  alt=""
  aria-hidden="true"
  bind-element={logoEl}
  animate={logoMotion}
/>

<style>
  .hero-logo {
    position: absolute;
    top: 50%;
    left: var(--letter-left, 0px);
    width: 1.25em;
    height: 1.25em;
    margin: -0.625em 0 0 -1.55em;
    pointer-events: auto;
  }

  @media (max-width: 559px) {
    .hero-logo {
      display: none;
    }
  }
</style>
