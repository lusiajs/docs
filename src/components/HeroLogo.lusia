<script>
import { onAttach, variable, WHEN, EASE } from "lusia";

const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

const logoEl = variable<HTMLElement | null>(null);

// The title is centered, so the first letter's position is read from the DOM.
function placeLogo() {
	const logo = logoEl.value;
	const letter = logo?.parentElement?.querySelector<HTMLElement>(".letter-slot");
	if (!logo || !letter) return;
	logo.style.setProperty("--letter-left", `${letter.offsetLeft}px`);
}

onAttach(() => {
	placeLogo();
	document.fonts.ready.then(placeLogo);
	window.addEventListener("resize", placeLogo);
	return () => window.removeEventListener("resize", placeLogo);
});

// Grows in with the first letter. Reduced motion shows it at once.
const logoIn = {
	0: { opacity: 0, scale: "0.6" },
	1: [EASE.STYLE.QUART, EASE.OUT, { opacity: 1, scale: "1" }],
};
const logoMotion = reduced
	? []
	: [
			{
				style: logoIn,
				when: WHEN.ATTACH,
				more: { animateSpace: false },
				duration: 600,
				delay: 80,
			},
		];
</script>

<img
	class="hero-logo"
	src="/logo.svg"
	alt=""
	aria-hidden="true"
	bind-element={logoEl}
	animate={logoMotion}
/>

<style>
.hero-logo {
	position: absolute;
	top: 50%;
	left: var(--letter-left, 0px);
	width: 1.25em;
	height: 1.25em;
	margin: -0.625em 0 0 -1.55em;
	pointer-events: none;
}

@media (max-width: 559px) {
	.hero-logo {
		display: none;
	}
}
</style>
