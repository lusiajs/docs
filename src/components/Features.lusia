<script>
import { EASE, EDGE, SCROLL_AT, variable } from "lusia";
import { scrollAcross } from "../motion/home-scroll.ts";
import FeatureCounter from "./FeatureCounter.lusia";

const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

const bobbing = {
	0: { translate: "0px 0px" },
	1: [EASE.STYLE.SINE, EASE.INOUT, { translate: "0px -4px" }],
};

const bob = { style: bobbing, loop: true, backAndForth: true, duration: 3000 };

// Each element starts when its top edge enters at the bottom of the screen and rests
// when its top edge reaches the given line (window height from the top, 0 to 1).
// The section is the element measured. Each item plays from the section's top edge at the
// bottom of the screen to its own line (window height from the top, 0 to 1).
const section = variable<HTMLElement | null>(null);
const ENTER = SCROLL_AT.ENTER;
const TOP_THIRD = 1 / 3;
const LAST_CARD = 5;
// Cards play as the section crosses the viewport middle.
const CARD_START = { element: EDGE.TOP, window: 0.7 };
const FIRST_CARD_LINE = 0.35;
const LAST_CARD_LINE = 0.1;

// The content rises into place as the page scrolls, then rests.
const contentDrift = reduced
	? []
	: scrollAcross(
			section,
			{ translate: "0 6vh" },
			{ translate: "0 0" },
			ENTER,
			{ element: EDGE.TOP, window: TOP_THIRD },
		);

// The title slides in from the left as the section arrives.
const titleSlide = reduced
	? []
	: scrollAcross(
			section,
			{ opacity: 0, translate: "-40vw 0" },
			{ opacity: 1, translate: "0 0" },
			ENTER,
			{ element: EDGE.TOP, window: 0.6 },
		);

function cardMotion(index: number) {
	if (reduced) return [];
	const start = {
		opacity: 0,
		translate: "0 24px",
		rotate: `${index % 2 ? 2 : -2}deg`,
		scale: "0.96",
	};
	const end = { opacity: 1, translate: "0 0", rotate: "0deg", scale: "1" };
	const line =
		FIRST_CARD_LINE -
		((FIRST_CARD_LINE - LAST_CARD_LINE) * index) / LAST_CARD;
	return scrollAcross(section, start, end, CARD_START, {
		element: EDGE.TOP,
		window: line,
	});
}

const childrenSnippet = [
	'<Card title="Inbox">',
	"  <p>{mail} new</p>",
	"</Card>",
	"",
	"<!-- Card.lusia -->",
	"<CONTENT />",
].join("\n");
const helloSnippet = "<p>Hi {name}</p>";
</script>

<section class="features" id="features" bind-element={section}>
	<div class="features-inner" animate={contentDrift}>
		<h2 class="section-title" animate={titleSlide}>Features</h2>
		<div class="feature-grid">
			<article
				class="feature-card feature-card--wide"
				style="--tone: var(--pink)"
				animate={cardMotion(0)}
			>
				<span class="sticker">Core</span>
				<span class="card-sparkle" aria-hidden="true">
					<svg viewBox="0 0 24 24">
						<path
							d="M12 0 L14.5 9.5 L24 12 L14.5 14.5 L12 24 L9.5 14.5 L0 12 L9.5 9.5 Z"
							fill="currentColor"
						/>
					</svg>
				</span>
				<div class="feature-head">
					<span class="feature-icon">
						<span
							class="blob"
							animate={bob}
							aria-hidden="true"
						></span>
						<span
							class="material-symbols-rounded"
							aria-hidden="true"
							>bolt</span
						>
					</span>
					<h3>Variables</h3>
				</div>
				<p>
					Only the text and attributes that read a changed variable
					are updated.
				</p>
				<div class="feature-demo">
					<FeatureCounter />
				</div>
				<pre
					class="snippet"
				><code data-lang="typescript">const count = variable(0);
const double = variable.compute(() =&gt; count.value * 2);
count.value++;</code></pre>
			</article>
			<article
				class="feature-card"
				style="--tone: var(--lavender)"
				animate={cardMotion(1)}
			>
				<span class="sticker">Format</span>
				<div class="feature-head">
					<span class="feature-icon">
						<span
							class="blob"
							animate={bob}
							aria-hidden="true"
						></span>
						<span
							class="material-symbols-rounded"
							aria-hidden="true"
							>description</span
						>
					</span>
					<h3>Single-file .lusia</h3>
				</div>
				<p>Script, markup and styles live in one file.</p>
				<pre class="snippet"><code data-lang="lusia">&lt;script&gt;
import {"{"} variable {"}"} from "lusia";
&lt;/script&gt;
&lt;p&gt;Hi {"{"}name{"}"}&lt;/p&gt;</code></pre>
			</article>
			<article
				class="feature-card"
				style="--tone: var(--mint)"
				animate={cardMotion(2)}
			>
				<span class="sticker">Components</span>
				<div class="feature-head">
					<span class="feature-icon">
						<span
							class="blob"
							animate={bob}
							aria-hidden="true"
						></span>
						<span
							class="material-symbols-rounded"
							aria-hidden="true"
							>input</span
						>
					</span>
					<h3>Props and children</h3>
				</div>
				<p>
					Pass values as attributes. Put markup between the tags.
					Place it with CONTENT.
				</p>
				<pre
					class="snippet"
				><code data-lang="lusia">{childrenSnippet}</code></pre>
			</article>
			<article
				class="feature-card"
				style="--tone: var(--sky)"
				animate={cardMotion(3)}
			>
				<span class="sticker">Styling</span>
				<div class="feature-head">
					<span class="feature-icon">
						<span
							class="blob"
							animate={bob}
							aria-hidden="true"
						></span>
						<span
							class="material-symbols-rounded"
							aria-hidden="true"
							>palette</span
						>
					</span>
					<h3>Scoped SCSS</h3>
				</div>
				<p>Styles stay with their component.</p>
				<pre
					class="snippet"
				><code data-lang="lusia">&lt;style scoped&gt;
.card {"{"} padding: 1rem; {"}"}
&lt;/style&gt;</code></pre>
			</article>
			<article
				class="feature-card"
				style="--tone: var(--lemon)"
				animate={cardMotion(4)}
			>
				<span class="sticker">Tooling</span>
				<div class="feature-head">
					<span class="feature-icon">
						<span
							class="blob"
							animate={bob}
							aria-hidden="true"
						></span>
						<span
							class="material-symbols-rounded"
							aria-hidden="true"
						>
							rocket_launch
						</span>
					</span>
					<h3>Bun native</h3>
				</div>
				<p>
					The compiler is a Bun plugin. No extra build tool to set up.
				</p>
				<pre class="snippet"><code data-lang="none">bun install
bun dev</code></pre>
			</article>
			<article
				class="feature-card"
				style="--tone: var(--pink)"
				animate={cardMotion(5)}
			>
				<span class="sticker">Editor</span>
				<div class="feature-head">
					<span class="feature-icon">
						<span
							class="blob"
							animate={bob}
							aria-hidden="true"
						></span>
						<span
							class="material-symbols-rounded"
							aria-hidden="true"
							>code_blocks</span
						>
					</span>
					<h3>VS Code extension</h3>
				</div>
				<p>
					Type-aware completion, hover, errors and formatting for
					script, style and markup in <code>.lusia</code> files.
				</p>
				<pre
					class="snippet"
				><code data-lang="lusia">{helloSnippet}</code></pre>
			</article>
		</div>
	</div>
</section>
