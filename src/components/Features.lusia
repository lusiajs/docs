<script>
import { EDGE, PRESET, SCROLL_AT, WHEN, variable } from "lusiajs";
import { featureSnippets } from "../features.ts";
import { scrollAcross } from "../motion/home-scroll.ts";
import EditorMock from "./features/EditorMock.lusia";
import FeatureCard from "./features/FeatureCard.lusia";
import FeatureSnippet from "./features/FeatureSnippet.lusia";
import TerminalMock from "./features/TerminalMock.lusia";
import FeatureCounter from "./FeatureCounter.lusia";

const reduced = matchMedia("(prefers-reduced-motion: reduce)").matches;

// Each element starts when its top edge enters at the bottom of the screen and rests
// when its top edge reaches the given line (window height from the top, 0 to 1).
const section = variable<HTMLElement | null>(null);
const ENTER = SCROLL_AT.ENTER;
const TOP_THIRD = 1 / 3;
const CARD_COUNT = 8;
// Cards play as the section crosses the viewport middle.
const CARD_START = { element: EDGE.TOP, window: 0.7 };
const FIRST_CARD_LINE = 0.35;
const LAST_CARD_LINE = 0.1;

// The content rises into place as the page scrolls, then rests.
const contentDrift = reduced
	? []
	: scrollAcross(
			section,
			{ translate: "0 6vh" },
			{ translate: "0 0" },
			ENTER,
			{ element: EDGE.TOP, window: TOP_THIRD },
		);

// The title slides in from the left as the section arrives.
const titleSlide = reduced
	? []
	: scrollAcross(
			section,
			{ opacity: 0, translate: "-40vw 0" },
			{ opacity: 1, translate: "0 0" },
			ENTER,
			{ element: EDGE.TOP, window: 0.6 },
		);

function cardMotion(index: number) {
	if (reduced) return [];
	const start = {
		opacity: 0,
		translate: "0 24px",
		rotate: `${index % 2 ? 2 : -2}deg`,
		scale: "0.96",
	};
	const end = { opacity: 1, translate: "0 0", rotate: "0deg", scale: "1" };
	const line =
		FIRST_CARD_LINE -
		((FIRST_CARD_LINE - LAST_CARD_LINE) * index) / (CARD_COUNT - 1);
	return scrollAcross(section, start, end, CARD_START, {
		element: EDGE.TOP,
		window: line,
	});
}
</script>

<section class="features" id="features" bind-element={section}>
	<div class="features-inner" animate={contentDrift}>
		<h2 class="section-title" animate={titleSlide}>Features</h2>
		<div class="feature-grid">
			<FeatureCard
				title="Variables"
				icon="bolt"
				tag="Reactive"
				tone="var(--pink)"
				motion={cardMotion(0)}
			>
				<p class="benefit">Only the text that reads a changed variable updates.</p>
				<div class="feature-demo">
					<FeatureCounter />
				</div>
				<FeatureSnippet code={featureSnippets.variables} />
			</FeatureCard>

			<FeatureCard
				title="Flow tags"
				icon="account_tree"
				tag="Markup"
				tone="var(--lavender)"
				motion={cardMotion(1)}
			>
				<p class="benefit">IF, ELSE, EACH and FOR show, hide and repeat markup.</p>
				<FeatureSnippet code={featureSnippets.flow} />
			</FeatureCard>

			<FeatureCard
				title="Animate"
				icon="motion_photos_auto"
				tag="Motion"
				tone="var(--mint)"
				motion={cardMotion(2)}
			>
				<p class="benefit">Entrance and hover motion from one attribute.</p>
				<div class="feature-demo">
					<button
						class="hover-demo"
						type="button"
						animate={{ style: PRESET.ZOOM_IN, when: WHEN.HOVER }}
					>
						Hover me
					</button>
				</div>
				<FeatureSnippet code={featureSnippets.animate} />
			</FeatureCard>

			<FeatureCard
				title="Single file"
				icon="description"
				tag="Format"
				tone="var(--sky)"
				motion={cardMotion(3)}
			>
				<p class="benefit">Script, markup and styles live in one .lusia file.</p>
				<FeatureSnippet code={featureSnippets.singleFile} />
			</FeatureCard>

			<FeatureCard
				title="Props and children"
				icon="input"
				tag="Components"
				tone="var(--lemon)"
				motion={cardMotion(4)}
			>
				<p class="benefit">
					Pass values as attributes. Markup between the tags goes where
					CONTENT is.
				</p>
				<FeatureSnippet code={featureSnippets.propsUse} />
			</FeatureCard>

			<FeatureCard
				title="Scoped SCSS"
				icon="palette"
				tag="Styles"
				tone="var(--peach)"
				motion={cardMotion(5)}
			>
				<p class="benefit">Styles stay with their component. Use scoped, tree or global.</p>
				<FeatureSnippet code={featureSnippets.scoped} />
			</FeatureCard>

			<FeatureCard
				title="Bun native"
				icon="rocket_launch"
				tag="Tooling"
				tone="var(--rose)"
				motion={cardMotion(6)}
			>
				<p class="benefit">
					A Bun plugin compiles .lusia files. Start a project in one
					command.
				</p>
				<TerminalMock />
			</FeatureCard>

			<FeatureCard
				title="VS Code"
				icon="code_blocks"
				tag="Editor"
				tone="var(--lavender)"
				motion={cardMotion(7)}
			>
				<p class="benefit">Errors and hints show as you type in .lusia files.</p>
				<EditorMock />
			</FeatureCard>
		</div>
	</div>
</section>

<style scoped>
@use "../styles/theme" as *;

// A full screen section with no background: the Home backdrop shows through.
.features {
	position: relative;
	display: flex;
	flex-direction: column;
	padding: 1rem clamp(1.25rem, 3vw, 3rem) 0.5rem;
}

.features-inner {
	position: relative;
	z-index: 1;
	width: 100%;
	max-width: 1400px;
	margin: 0 auto;
}

.section-title {
	margin-bottom: 0.25rem;
	font-size: clamp(1.8rem, 3.6vw, 2.5rem);
	text-align: center;
}

// Eight cards of one size: four per row, two rows.
.feature-grid {
	display: grid;
	grid-template-columns: repeat(4, minmax(0, 1fr));
	gap: 14px;
}

.benefit {
	margin: 0;
	color: var(--muted);
	font-size: 0.95rem;
}

.feature-demo {
	display: grid;
	place-items: center;
	min-height: 6rem;
}

.hover-demo {
	padding: 0.6rem 1.1rem;
	border: 2px solid var(--line);
	border-radius: 999px;
	background: var(--card);
	color: var(--fg);
	font: inherit;
	font-weight: 700;
	cursor: pointer;
}

@media (max-width: 1099px) {
	.feature-grid {
		grid-template-columns: repeat(2, minmax(0, 1fr));
	}
}

@media (max-width: 619px) {
	.feature-grid {
		grid-template-columns: minmax(0, 1fr);
	}
}
</style>
