<script>
  import { PRESET, ON, controller, props } from "lusiajs";

  const { onReload } = props({ onReload: () => {} });
  const spin = controller();
  const spinMotion = {
    play: PRESET.SPIN,
    on: ON.MANUAL,
    control: spin,
    duration: 600,
    keep: false,
  };

  function reloadNow() {
    void spin.play();
    onReload.peek()();
  }
</script>

<button
  class="icon-button"
  type="button"
  aria-label="Run again"
  title="Run again"
  onclick={reloadNow}
>
  <span
    class="material-symbols-rounded"
    aria-hidden="true"
    animate={spinMotion}
    >refresh</span
  >
</button>
