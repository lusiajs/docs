<script>
  import {
    EVENT,
    attach,
    listen,
    onAttach,
    props,
    variable,
    type Instance,
  } from "lusiajs";
  import type { Demo } from "../catalog.ts";
  import type { EditorFile } from "../editor/files.ts";
  import { createDemoSession } from "../live/demo-session.ts";
  import { createQueue } from "../live/queue.ts";
  import { Preview, RunError } from "../live/preview.ts";
  import { loadRuntime } from "../live/runtime-source.ts";
  import type { LiveBundle, LiveError, LiveRun } from "../live/types.ts";
  import { guidePath, pageLink } from "../page-link.ts";
  import { theme } from "../theme.ts";
  // CodeEditor is large. Inside an IF, smart mode splits it into its own chunk.
  import CodeEditor from "./CodeEditor.lusia";
  import CodePanel from "./CodePanel.lusia";
  import ErrorNote from "./ErrorNote.lusia";
  import ReloadButton from "./ReloadButton.lusia";

  const emptyDemo: Demo = {
    id: "",
    title: "",
    caption: "",
    components: [],
    sources: [],
  };
  const { demo } = props({ demo: emptyDemo });
  const body = variable<Element | null>(null);
  const stage = variable<HTMLElement | null>(null);
  const codeSlot = variable<HTMLElement | null>(null);
  // The editor opens near the screen or on click. Until then the code is only shown.
  const near = variable(false);
  // True while the edited build is shown in place of the original demo.
  const live = variable(false);
  const sources: EditorFile[] = demo.peek().sources.map((file) => ({
    name: file.path,
    code: file.text,
  }));
  const firstName = sources[0]?.name ?? "";
  let originals: Instance[] = [];
  let preview: Preview | undefined;
  // Mounts and removals run one at a time, so a fast second click never mixes two sets.
  const later = createQueue();

  const session = createDemoSession(sources, {
    show: showLive,
    restore: showOriginal,
  });

  // The frame takes its theme when it runs, so an edited demo runs again on a switch.
  variable.watch(
    [theme],
    () => {
      if (live.peek()) session.rerun();
    },
    { onInit: false },
  );

  // The demo and its editor are made when the row nears the screen.
  onAttach(() => {
    preview = new Preview(stage.peek()!, (error) => session.report(error), {
      sizeToContent: true,
    });
    const stopNearby = listen(
      codeSlot.peek()!,
      EVENT.VIEW,
      ({ in: visible }) => {
        if (!visible) return;
        remountOriginals();
        openEditor();
        stopNearby();
      },
      { margin: "-240px", amount: 0 },
    );
    return () => preview?.destroy();
  });

  function openEditor(): void {
    near.value = true;
  }

  function mountOriginals(): void {
    originals = demo
      .peek()
      .components.map((component) => attach(component, body.peek()!));
  }

  // Removes the mounted demo. Its leave animations play first.
  async function detachOriginals(): Promise<void> {
    const old = originals;
    originals = [];
    await Promise.all(old.map((instance) => instance.detach()));
  }

  // Runs the demo again from scratch: the old instance leaves, then a fresh one attaches.
  function remountOriginals(): void {
    later(async () => {
      await detachOriginals();
      if (!live.peek()) mountOriginals();
    });
  }

  // The first edit that builds takes over from the original demo.
  async function showLive(bundle: LiveBundle): Promise<LiveRun> {
    try {
      await preview!.show({
        ...bundle,
        runtime: await loadRuntime(),
        theme: theme.peek(),
      });
    } catch (error) {
      return { ok: false, error: errorDetail(error) };
    }
    if (!live.peek()) {
      live.value = true;
      later(detachOriginals);
    }
    return { ok: true };
  }

  function showOriginal(): void {
    if (!live.peek()) return;
    preview!.clear();
    live.value = false;
    remountOriginals();
  }

  // An edited demo runs its edited code again. An original demo starts over.
  function reload(): void {
    if (session.edited.peek()) session.rerun();
    else remountOriginals();
  }

  function errorDetail(error: unknown): LiveError {
    if (error instanceof RunError) return error.detail;
    return { message: error instanceof Error ? error.message : String(error) };
  }
</script>

<div class="demo-block" id={demo.value.id}>
  <header class="demo-head">
    <h3 class="demo-title">
      {demo.value.title}
      <a
        class="demo-anchor"
        href={pageLink(guidePath, demo.value.id)}
        aria-label="Link to this demo"
      >
        <span class="material-symbols-rounded" aria-hidden="true">link</span>
      </a>
    </h3>
    <p class="demo-caption">{demo.value.caption}</p>
  </header>
  <div class="demo-row">
    <div class="demo">
      <p class="demo-label">
        <span class="material-symbols-rounded" aria-hidden="true">science</span
        >Sandbox
        <ReloadButton onReload={reload} />
      </p>
      <div
        class="demo-body"
        hidden={live.value}
        bind-element={body}
      ></div>
      <div
        class="live-preview"
        hidden={!live.value}
        bind-element={stage}
      ></div>
      <ErrorNote error={session.error} />
    </div>
    <IF {near.value}>
      <CodeEditor
        files={session.files.value}
        active={firstName}
        edited={session.edited.value}
        onChange={session.edit}
        onReset={session.reset}
      />
    <ELSE>
      <div class="lazy-code" bind-element={codeSlot} onclick={openEditor}>
        <CodePanel sources={demo.value.sources} />
      </div>
    </IF>
  </div>
</div>
