<script>
import { props } from "lusiajs";
import type { Spark } from "../motion/sparks.ts";

const { sparks } = props({ sparks: [] as Spark[] });
</script>

<EACH {sparks} as="{spark}">
	<span
		class="spark {spark.kind}"
		style="left: {spark.x}px; top: {spark.y}px; --tone: {spark.tone}"
		animate={spark.motion}
	></span>
</EACH>
