<script>
  import { SCREEN, ON, EASE } from "lusiajs";

  const reduced = SCREEN.REDUCED_MOTION.value;

  // The eyes close for a moment, once every few seconds.
  const blink = {
    play: {
      ease: [EASE.STYLE.SINE, EASE.INOUT],
      0: { scale: "1 1" },
      0.45: { scale: "1 1" },
      0.5: { scale: "1 0.1" },
      0.55: { scale: "1 1" },
      1: { scale: "1 1" },
    },
    loop: true,
    duration: 3600,
  };

  // Waves when the pointer is on it.
  const wave = {
    play: {
      ease: [EASE.STYLE.SINE, EASE.OUT],
      0: { rotate: "0deg" },
      0.25: { rotate: "-22deg" },
      0.5: { rotate: "14deg" },
      0.75: { rotate: "-8deg" },
      1: { rotate: "0deg" },
    },
    on: ON.HOVER,
    duration: 800,
  };

  // Leans toward the page as the mascot scrolls across the screen.
  const lean = {
    play: { 0: { rotate: "-10deg" }, 1: { rotate: "10deg" } },
    on: ON.SCROLL,
  };

  const eyeMotion = reduced ? [] : blink;
  const armMotion = reduced ? [] : wave;
  const leanMotion = reduced ? [] : lean;
</script>

<span class="mascot" aria-hidden="true" animate={leanMotion}>
  <span class="mascot-face">
    (<span class="eye" animate={eyeMotion}>•</span>ᴗ<span
      class="eye"
      animate={eyeMotion}
      >•</span
    >)<span class="arm" animate={armMotion}>ﾉ</span>
  </span>
</span>
