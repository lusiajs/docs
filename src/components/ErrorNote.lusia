<script>
  import { props } from "lusiajs";
  import type { LiveError } from "../live/types.ts";

  const { error } = props(class {
    error: LiveError | null = null;
  });

  function placeOf(next: LiveError | null): string {
    if (!next?.file) return "";
    if (next.line === undefined) return next.file;
    return next.column === undefined
      ? `${next.file}:${next.line}`
      : `${next.file}:${next.line}:${next.column}`;
  }
</script>

<div class="error-note">
  <IF {error !== null}>
    <div class="live-error" role="alert">
      <p class="live-error-title">
        <span class="material-symbols-rounded" aria-hidden="true">error</span>
        {error?.code ?? "Error"}
      </p>
      <p>{error?.message}</p>
      <IF {error?.hint !== undefined}>
        <p class="live-error-hint">{error?.hint}</p>
      </IF>
      <IF {error?.file !== undefined}>
        <p class="live-error-place">{placeOf(error)}</p>
      </IF>
      <IF {error?.frame !== undefined}>
        <pre class="live-error-frame">{error?.frame}</pre>
      </IF>
    </div>
  </IF>
</div>
