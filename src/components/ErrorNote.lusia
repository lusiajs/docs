<script>
  import { props } from "lusiajs";
  import type { LiveError } from "../live/types.ts";

  const { error } = props({ error: null as LiveError | null });

  function placeOf(next: LiveError | null): string {
    if (!next?.file) return "";
    if (next.line === undefined) return next.file;
    return next.column === undefined
      ? `${next.file}:${next.line}`
      : `${next.file}:${next.line}:${next.column}`;
  }
</script>

<div class="error-note">
  <IF {error.value !== null}>
    <div class="live-error" role="alert">
      <p class="live-error-title">
        <span class="material-symbols-rounded" aria-hidden="true">error</span>
        {error.value?.code ?? "Error"}
      </p>
      <p>{error.value?.message}</p>
      <IF {error.value?.hint !== undefined}>
        <p class="live-error-hint">{error.value?.hint}</p>
      </IF>
      <IF {error.value?.file !== undefined}>
        <p class="live-error-place">{placeOf(error.value)}</p>
      </IF>
      <IF {error.value?.frame !== undefined}>
        <pre class="live-error-frame">{error.value?.frame}</pre>
      </IF>
    </div>
  </IF>
</div>
