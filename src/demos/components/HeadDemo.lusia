<script>
  import { variable } from "lusiajs";
  import HeadTitle from "./HeadTitle.lusia";

  const FIRST = "Lusia head demo";
  const RENAMED = "Lusia, renamed";
  const shown = variable(false);
  const title = variable(FIRST);

  function toggle() {
    shown.value = !shown.value;
  }

  function changeTitle() {
    title.value = title.value === FIRST ? RENAMED : FIRST;
  }
</script>

<div class="head-demo">
  <button onclick={toggle}>{shown.value ? "Hide" : "Show"} the head block</button>
  <IF {shown}>
    <HeadTitle title={title} />
    <button onclick={changeTitle}>Change the title</button>
  </IF>
</div>

<style scoped>
  .head-demo {
    display: grid;
    justify-items: start;
    gap: 0.6rem;
    color: var(--fg);

    p {
      margin: 0;
    }

    button {
      padding: 0.5rem 1rem;
      border: 0;
      border-radius: 8px;
      background: var(--accent);
      color: var(--bg);
      font: inherit;
      cursor: pointer;
    }
  }
</style>
