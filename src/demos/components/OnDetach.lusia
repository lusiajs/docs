<script>
import { attach, variable, type Instance } from "lusia";
import { detachedBoxes } from "../../variable.ts";
import DetachBox from "./DetachBox.lusia";

const attached = variable(0);
const slot = variable<Element | null>(null);
const instances: Instance[] = [];

function attachBox() {
	if (!slot.value) return;
	instances.push(attach(DetachBox, slot.value));
	attached.value = instances.length;
}

function detachLastBox() {
	instances.pop()?.detach();
	attached.value = instances.length;
}
</script>

<div class="on-detach-demo">
	<div class="actions">
		<button onclick={attachBox} type="button">Attach a box</button>
		<button onclick={detachLastBox} type="button">Detach last box</button>
	</div>
	<p>Attached boxes: {attached}</p>
	<p>Removed boxes: {detachedBoxes}</p>
	<div class="slot" bind-element={slot}></div>
</div>

<style>
@use "../../styles/demo" as demo;

.on-detach-demo {
	display: grid;
	gap: 0.75rem;
	color: var(--fg);

	p {
		margin: 0;
	}

	.actions {
		@include demo.row;
	}

	button {
		@include demo.button;
	}

	.slot {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
}
</style>
