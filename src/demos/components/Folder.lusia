<script>
  import { props, variable } from "lusiajs";
  import Folder from "./Folder.lusia";

  interface Item {
    name: string;
    children?: Item[];
  }

  const { item } = props({ item: { name: "" } as Item });
  const open = variable(true);
  const children = variable.compute(() => item.value.children ?? []);

  function toggle() {
    open.value = !open.value;
  }
</script>

<li class="node">
  <IF {item.value.children}>
    <button class="row" type="button" onclick={toggle}>
      <span class="arrow">{open.value ? "▾" : "▸"}</span>
      <span>{item.value.name}</span>
    </button>
    <IF {open}>
      <ul>
        <EACH {children} as={child} key={child.name}>
          <Folder item={child} />
        </EACH>
      </ul>
    </IF>
  </IF>
  <ELSE>
    <span class="file">{item.value.name}</span>
  </ELSE>
</li>

<style>
  @use "../../styles/demo" as demo;
  @use "../../styles/theme" as theme;

  ul {
    margin: 0;
    padding-left: 1.25rem;
    border-left: 2px dashed var(--line);
    list-style: none;
  }

  .node {
    margin: 0.15rem 0;
  }

  .row,
  .file {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-family: theme.$font-mono;
  }

  .row {
    @include demo.button;
    padding: 0.15rem 0.6rem;
  }

  .arrow {
    width: 1ch;
  }

  .file {
    padding: 0.15rem 0.6rem;
    color: var(--muted);
  }
</style>
