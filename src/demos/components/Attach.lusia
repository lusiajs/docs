<script>
import { attach, variable, type Instance } from "lusia";
import { clicks } from "../../variable.ts";
import Chip from "./Chip.lusia";

const attached = variable(0);
const slot = variable<Element | null>(null);
const instances: Instance[] = [];

function addClick() {
	clicks.value++;
}

function attachChip() {
	if (!slot.value) return;
	instances.push(attach(Chip, slot.value));
	attached.value = instances.length;
}

function detachChip() {
	instances.pop()?.detach();
	attached.value = instances.length;
}
</script>

<div class="attach-demo">
	<div class="actions">
		<button onclick={attachChip} type="button">Attach a chip</button>
		<button onclick={detachChip} type="button">Detach last chip</button>
		<button onclick={addClick} type="button">Add 1 shared click</button>
	</div>
	<p>Attached chips: {attached}</p>
	<div class="slot" bind-element={slot}></div>
</div>

<style>
@use "../../styles/demo" as demo;

.attach-demo {
	display: grid;
	gap: 0.75rem;
	color: var(--fg);

	p {
		margin: 0;
	}

	.actions {
		@include demo.row;
	}

	button {
		@include demo.button;
	}

	.slot {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
	}
}
</style>
