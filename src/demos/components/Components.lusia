<script>
import { variable } from "lusiajs";
import badge from "./badge.lusia";

const mail = variable(0);
const label = variable.compute(() =>
	mail.value === 0 ? "No mail" : `${mail.value} new`,
);

function addMail() {
	mail.value++;
}

function clearMail() {
	mail.value = 0;
}
</script>

<div class="components-demo">
	<div class="actions">
		<button onclick={addMail} type="button">Add mail</button>
		<button onclick={clearMail} type="button">Clear</button>
	</div>
	<p>Reactive prop, default tone: <badge label={label} /></p>
	<p>Static props, tone set: <badge label="Static" tone="warn" /></p>
</div>

<style>
@use "../../styles/demo" as demo;

.components-demo {
	display: grid;
	gap: 0.5rem;
	color: var(--fg);

	p {
		margin: 0;
	}

	.actions {
		@include demo.row;
		margin-bottom: 0.5rem;
	}

	button {
		@include demo.button;
	}
}
</style>
