<script>
import { onDetach } from "lusiajs";
import { detachedBoxes } from "../../variable.ts";

onDetach(() => {
	detachedBoxes.value++;
});
</script>

<div class="detach-box">
	<p>Box</p>
	<p>Removed boxes: {detachedBoxes}</p>
</div>

