<script>
import { props, variable } from "lusia";
import Comment from "./Comment.lusia";

interface Note {
	id: number;
	author: string;
	text: string;
	replies?: Note[];
}

// Replies past this depth are not shown, even when the data has them.
const maxDepth = 3;

const { comment, depth } = props({
	comment: { id: 0, author: "", text: "" } as Note,
	depth: 1,
});
const replies = variable.compute(() => comment.value.replies ?? []);
</script>

<li class="comment">
	<p class="head"><strong>{comment.value.author}</strong></p>
	<p class="text">{comment.value.text}</p>
	<IF {depth.value < maxDepth}>
		<ul class="replies">
			<EACH {replies} as={reply} key={reply.id}>
				<Comment comment={reply} depth={depth.value + 1} />
			</EACH>
		</ul>
	</IF>
	<ELSE>
		<IF {replies.value.length > 0}>
			<p class="hidden">Replies past depth {maxDepth} are not shown.</p>
		</IF>
	</ELSE>
</li>

<style>
.comment {
	margin-top: 0.6rem;
	color: var(--fg);
}

.head,
.text {
	margin: 0;
}

.text {
	color: var(--muted);
}

.replies {
	margin: 0.25rem 0 0;
	padding: 0 0 0 1rem;
	border-left: 2px dashed var(--line);
	list-style: none;
}

.hidden {
	margin: 0.25rem 0 0;
	color: var(--muted);
	font-size: 0.9rem;
}
</style>
