<script>
import { variable } from "lusia";
import Chart from "./LazyChart.lusia";

const shown = variable(false);

function show() {
	shown.value = true;
}

function hide() {
	shown.value = false;
}
</script>

<div class="lazy-demo">
	<div class="actions">
		<button onclick={show} type="button">Show chart</button>
		<button onclick={hide} type="button">Hide chart</button>
	</div>
	<IF {shown}>
		<Chart />
	</IF>
</div>

<style>
@use "../../styles/demo" as demo;

.lazy-demo {
	display: grid;
	gap: 0.75rem;
	color: var(--fg);

	.actions {
		@include demo.row;
	}

	button {
		@include demo.button;
	}
}
</style>
