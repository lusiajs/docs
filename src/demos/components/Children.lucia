<script>
import { variable } from "lucia";
import Card from "./Card.lucia";

const clicks = variable(0);

function addClick() {
  clicks.value++;
}
</script>

<div class="children-demo">
  <Card title="Inbox">
    <p>{clicks} clicks, counted by the parent</p>
    <button onclick={addClick} type="button">Click</button>
  </Card>
  <Card title="Empty" />
</div>

<style>
@use "../../styles/demo" as demo;

.children-demo {
  display: grid;
  gap: 0.75rem;

  p { margin: 0; color: var(--fg); }

  button {
    @include demo.button;
  }
}
</style>
