<script>
import { variable } from "lusia";

const on = variable(false);
const locked = variable.compute(() => !on.value);
const note = variable.compute(() => (on.value ? "Saved" : null));
const flag = variable.compute(() => on.value);
const tone = variable.compute(() => (on.value ? "on" : null));

function toggleOn() {
	on.value = !on.value;
}
</script>

<div class="attributes-demo">
	<div class="actions">
		<button onclick={toggleOn} type="button">Toggle state</button>
		<button class="save" type="button" disabled={locked}>Save</button>
	</div>
	<p title={note}>
		Hover this line. Its title is set only when the state is on.
	</p>
	<p>Save is locked: {locked}</p>
	<p>
		<span
			class="chip {tone}"
			data-state={tone}
			data-flag={flag}
			>chip</span
		>
		Partial attributes mix text and values. Whole attributes follow the
		value.
	</p>
</div>

<style>
@use "../../styles/demo" as demo;

.attributes-demo {
	display: grid;
	gap: 0.5rem;
	color: var(--fg);

	p {
		margin: 0;
	}

	.actions {
		@include demo.row;
		margin-bottom: 0.5rem;
	}

	button {
		@include demo.button;
	}

	.chip {
		display: inline-block;
		padding: 0 0.5rem;
		border: 1px solid var(--line);
		border-radius: 999px;
		color: var(--muted);

		&.on {
			border-color: var(--accent);
			color: var(--accent);
		}
	}
}
</style>
