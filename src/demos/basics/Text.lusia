<script>
import { variable } from "lusia";

const name = variable("Ada");
const count = variable(3);
const greeting = variable.compute(() => `Hello, ${name.value}!`);
const limit = 10;
const raw = "<b>not bold</b>";
const nothing = null;

function toggleName() {
  name.value = name.value === "Ada" ? "Grace" : "Ada";
}

function addOne() {
  count.value++;
}
</script>

<div class="text-demo">
  <p>Variable: {name}</p>
  <p>Expression with .value: {count.value * 2}</p>
  <p>Derived: {greeting}</p>
  <p>Plain const, never changes: {limit}</p>
  <p>Inserted as text: {raw}</p>
  <p>null renders nothing: [{nothing}]</p>
  <div class="actions">
    <button onclick={toggleName} type="button">Rename</button>
    <button onclick={addOne} type="button">Add 1 to count</button>
  </div>
</div>

<style>
@use "../../styles/demo" as demo;

.text-demo {
  display: grid;
  gap: 0.5rem;
  color: var(--fg);

  p { margin: 0; }

  .actions {
    @include demo.row;
    margin-top: 0.5rem;
  }

  button {
    @include demo.button;
  }
}
</style>
