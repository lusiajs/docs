<script>
import { variable } from "lusia";

const name = variable("Ada");
const age = variable<number | null>(36);
const subscribed = variable(false);
const plan = variable("free");
const summary = variable.compute(() => {
  const subscription = subscribed.value ? ", subscribed" : "";
  const ageText = age.value ?? "no";
  return `${name.value}, ${ageText} years old, ${plan.value} plan${subscription}`;
});
</script>

<div class="bind-fields">
  <label>Name <input bind-value={name} /></label>
  <label>Age <input type="number" bind-value={age} /></label>
  <label class="check"><input type="checkbox" bind-value={subscribed} /> Subscribe</label>
  <label>Plan
    <select bind-value={plan}>
      <option value="free">Free</option>
      <option value="pro">Pro</option>
    </select>
  </label>
  <p>{summary}</p>
</div>

<style>
.bind-fields {
  display: grid;
  gap: 0.6rem;
  color: var(--fg);

  label {
    display: grid;
    gap: 0.25rem;
    color: var(--muted);
  }

  .check {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  input:not([type="checkbox"]),
  select {
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--bg);
    color: var(--fg);
    font: inherit;
  }

  p { margin: 0; }
}
</style>
