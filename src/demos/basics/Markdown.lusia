<script>
import { variable } from "lusia";

const source = variable("Some **bold**, *soft* and `code` text.");

// Escape first, so typed HTML stays text. Then add the few tags this demo knows.
function escapeHtml(text: string) {
  return text.replaceAll("&", "&amp;").replaceAll("<", "&lt;").replaceAll(">", "&gt;");
}

function toHtml(text: string) {
  return escapeHtml(text)
    .replace(/\*\*(.+?)\*\*/g, "<strong>$1</strong>")
    .replace(/\*(.+?)\*/g, "<em>$1</em>")
    .replace(/`(.+?)`/g, "<code>$1</code>");
}

const preview = variable.compute(() => toHtml(source.value));
</script>

<div class="markdown-demo">
  <textarea bind-value={source} rows="3"></textarea>
  <div class="preview"><HTML>{preview}</HTML></div>
  <p class="warning">
    Only insert HTML you trust. Escape user input first, as this demo does.
    Otherwise a script can run.
  </p>
</div>

<style>
.markdown-demo {
  display: grid;
  gap: 0.5rem;
  color: var(--fg);

  textarea {
    width: 100%;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--bg);
    color: var(--fg);
    font: inherit;
  }

  .preview {
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 8px;
  }

  .warning {
    margin: 0;
    color: var(--muted);
    font-size: 0.9rem;
  }
}
</style>
