<script>
import { variable } from "lucia";

const limit = 5;
const count = variable(0);
const name = variable("");
const done = variable.compute(() => count.value >= limit);
const greeting = variable.compute(() => name.value.trim() || "stranger");

function addOne() {
  count.value++;
}

function resetCount() {
  count.value = 0;
}

// oninput gets the event, so the handler can read the field's value.
function readName(event: Event) {
  name.value = (event.target as HTMLInputElement).value;
}
</script>

<div class="events">
  <p class="status {done.value ? 'done' : ''}">Clicked {count} of {limit} times.</p>
  <progress max={limit} value={count}></progress>
  <p class="hint">{done.value ? "Limit reached" : `${limit - count.value} left`}</p>
  <div class="actions">
    <button class="add" type="button" onclick={addOne} disabled={done}>Add one</button>
    <button
      class="reset"
      type="button"
      onclick={resetCount}
      title={count.value === 0 ? null : "Start again"}
    >Reset</button>
  </div>
  <label class="name-field">
    Name
    <input class="name" type="text" placeholder="Type a name" oninput={readName} />
  </label>
  <p>Hello, {greeting}!</p>
</div>

<style>
@use "../../styles/demo" as demo;

.events {
  display: grid;
  gap: 0.5rem;
  color: var(--fg);

  p { margin: 0; }

  .status.done { color: var(--accent); font-weight: 700; }

  progress {
    width: 100%;
    height: 0.6rem;
    accent-color: var(--accent);
  }

  .hint { color: var(--muted); }

  .actions {
    @include demo.row;
    margin: 0.25rem 0;
  }

  button {
    @include demo.button;
  }

  .name-field {
    display: grid;
    gap: 0.25rem;
    color: var(--muted);
  }

  input {
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--bg);
    color: var(--fg);
    font: inherit;
  }
}
</style>
