<script>
import { variable } from "lusia";

const keys = variable(0);

// setup(root) runs once when the demo mounts. Its return value runs on detach.
function setup(root: Element) {
  function countKey() {
    keys.value++;
  }

  root.addEventListener("keydown", countKey);
  return function cleanup() {
    root.removeEventListener("keydown", countKey);
  };
}
</script>

<div class="setup-demo">
  <input type="text" placeholder="Press keys in this box" />
  <p>Keys pressed inside this demo: {keys}</p>
</div>

<style>
.setup-demo {
  display: grid;
  gap: 0.5rem;
  color: var(--fg);

  p { margin: 0; }

  input {
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--bg);
    color: var(--fg);
    font: inherit;
  }
}
</style>
