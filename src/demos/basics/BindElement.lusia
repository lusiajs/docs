<script>
  import { variable } from "lusiajs";

  // bind-element sets the real DOM element here. It clears it when the demo unmounts.
  const field = variable<HTMLInputElement | null>(null);
  const box = variable<HTMLElement | null>(null);
  const width = variable(0);

  function focusField() {
    field.value?.focus();
  }

  function measureBox() {
    width.value = box.value?.offsetWidth ?? 0;
  }
</script>

<div class="bind-element-demo">
  <input
    type="text"
    placeholder="Click the button to focus me"
    bind-element={field}
  />
  <button type="button" onclick={focusField}>Focus the field</button>
  <div class="box" bind-element={box}>Measure me</div>
  <button type="button" onclick={measureBox}>Measure the box</button>
  <p>The box is {width} px wide.</p>
</div>

<style>
  @use "../../styles/demo" as demo;

  .bind-element-demo {
    display: grid;
    gap: 0.6rem;
    justify-items: start;
    color: var(--fg);

    p {
      margin: 0;
    }

    input {
      width: 100%;
      padding: 0.5rem 0.75rem;
      border: 1px solid var(--line);
      border-radius: 8px;
      background: var(--bg);
      color: var(--fg);
      font: inherit;
    }

    .box {
      padding: 0.5rem 1rem;
      border-radius: 12px;
      background: var(--lavender-soft);
    }

    button {
      @include demo.button;
    }
  }
</style>
