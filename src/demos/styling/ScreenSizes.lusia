<div class="sizes-demo">
  <div class="tile markup-tile">
    <p>SCREEN in markup</p>
    <IF {SCREEN.PHONE}>
      <span>Phone</span>
    <ELSE>
      <span>Wider</span>
    </IF>
  </div>

  <div class="tile if-tile">
    <p>style in IF</p>
    <IF {SCREEN.PHONE}>
      <style>
        .if-tile {
          padding: 8px;
        }
      </style>
    <ELSE>
      <style>
        .if-tile {
          padding: 24px;
        }
      </style>
    </IF>
  </div>

  <div class="tile mixin-tile">
    <p>screen() mixin</p>
  </div>
</div>

