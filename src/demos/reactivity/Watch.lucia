<script>
import { variable } from "lucia";

const clicks = variable(0);
const note = variable(0);
const runs = variable(0);

// Runs once at start, then only when clicks updates. Reads inside it do not count.
variable.watch([clicks], () => {
  runs.value++;
});

function addClick() {
  clicks.value++;
}

function addNote() {
  note.value++;
}
</script>

<div class="watch-demo">
  <p>Clicks: {clicks}</p>
  <p>Note: {note}</p>
  <p>The watch ran {runs} times</p>
  <div class="actions">
    <button onclick={addClick} type="button">Click</button>
    <button onclick={addNote} type="button">Add to note</button>
  </div>
</div>

<style>
@use "../../styles/demo" as demo;

.watch-demo {
  display: grid;
  gap: 0.5rem;
  color: var(--fg);

  p { margin: 0; }

  .actions {
    @include demo.row;
    margin-top: 0.5rem;
  }

  button {
    @include demo.button;
  }
}
</style>
