<script>
import { variable } from "lucia";

const width = variable(4);
const height = variable(3);
// area uses a named function. fill uses a short inline arrow.
function areaOf() {
  return width.value * height.value;
}

const area = variable.compute(areaOf);
const fill = variable.compute(() => Math.min(area.value * 4, 100));
const size = variable.compute(() => (area.value > 12 ? "Large" : "Small"));

function makeWider() {
  width.value++;
}

function makeTaller() {
  height.value++;
}

function resetSize() {
  width.value = 4;
  height.value = 3;
}
</script>

<div class="variables-demo">
  <p>Width {width}, height {height}</p>
  <p>Area, a derived variable of both: {area}</p>
  <p>Size, a derived variable of the area: {size}</p>
  <div class="bar"><span style="width: {fill}%"></span></div>
  <div class="actions">
    <button onclick={makeWider} type="button">Wider</button>
    <button onclick={makeTaller} type="button">Taller</button>
    <button onclick={resetSize} type="button">Reset</button>
  </div>
</div>

<style>
@use "../../styles/demo" as demo;

.variables-demo {
  display: grid;
  gap: 0.5rem;
  color: var(--fg);

  p { margin: 0; }

  .bar {
    height: 0.6rem;
    border-radius: 999px;
    background: var(--line);
    overflow: hidden;

    span {
      display: block;
      height: 100%;
      background: var(--accent);
      transition: width 0.2s ease;
    }
  }

  .actions {
    @include demo.row;
    margin-top: 0.5rem;
  }

  button {
    @include demo.button;
  }
}
</style>
