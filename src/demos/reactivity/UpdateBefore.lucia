<script>
import { variable } from "lucia";

const count = variable(0);
const lastUpdate = variable("");

// The callback gets the new value and the old one. At start, before is undefined.
count.onUpdate((now, before) => {
  lastUpdate.value = `${before ?? "start"} to ${now}`;
});

function addOne() {
  count.set(count.get() + 1);
}

function resetCount() {
  count.set(0);
}
</script>

<div class="update-before-demo">
  <p>Count: {count}</p>
  <p>Last update: {lastUpdate}</p>
  <div class="actions">
    <button onclick={addOne} type="button">Add 1</button>
    <button onclick={resetCount} type="button">Reset</button>
  </div>
</div>

<style>
@use "../../styles/demo" as demo;

.update-before-demo {
  display: grid;
  gap: 0.5rem;
  color: var(--fg);

  p { margin: 0; }

  .actions {
    @include demo.row;
    margin-top: 0.5rem;
  }

  button {
    @include demo.button;
  }
}
</style>
