<script>
import { clicks } from "../../variable.ts";

function addClick() {
	clicks.value++;
}

function resetClicks() {
	clicks.value = 0;
}
</script>

<div class="writer">
	<p class="label">Writer</p>
	<div class="actions">
		<button onclick={addClick} type="button">Add 1</button>
		<button onclick={resetClicks} type="button">Reset</button>
	</div>
</div>

<style>
@use "../../styles/demo" as demo;

.writer {
	display: grid;
	gap: 0.5rem;
	color: var(--fg);

	p {
		margin: 0;
	}

	.label {
		font-weight: 700;
	}

	.actions {
		@include demo.row;
	}

	button {
		@include demo.button;
	}
}
</style>
