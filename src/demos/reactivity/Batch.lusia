<script>
  import { variable } from "lusiajs";

  const first = variable("Ada");
  const last = variable("Lovelace");
  const full = variable.compute(() => `${first.value} ${last.value}`);
  let renders = 0;
  const updates = variable(0);

  // The handler writes both variables. The page still updates the text once per click.
  function updateBoth() {
    renders++;
    first.value = `First ${renders}`;
    last.value = `Last ${renders}`;
    updates.value = renders;
  }
</script>

<div class="batch-demo">
  <p>Full name, a derived variable: {full}</p>
  <p>Clicks so far: {updates}</p>
  <div class="actions">
    <button onclick={updateBoth} type="button">Update both variables</button>
  </div>
</div>

<style>
  @use "../../styles/demo" as demo;

  .batch-demo {
    display: grid;
    gap: 0.5rem;
    color: var(--fg);

    p {
      margin: 0;
    }

    .actions {
      @include demo.row;
      margin: 0.5rem 0;
    }

    button {
      @include demo.button;
    }
  }
</style>
