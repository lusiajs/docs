<script>
  import { variable } from "lusiajs";

  const agreed = variable(false);
</script>

<div class="bind-demo">
  <label>
    <input type="checkbox" bind-checked={agreed} />
    I agree to the terms
  </label>
  <p>{agreed.value ? "Thanks." : "Please agree."}</p>
</div>

