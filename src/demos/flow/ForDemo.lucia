<script>
import { variable } from "lucia";

const LIMIT = 20;

const start = variable<number | null>(0);
const end = variable<number | null>(6);
const step = variable<number | null>(1);

// FOR rejects a step of 0. An empty field counts as "not a number".
// Both fall back to safe values.
function clampBound(value: number | null, fallback: number): number {
  if (value === null || !Number.isFinite(value)) return fallback;
  return Math.min(Math.max(value, -LIMIT), LIMIT);
}

function readStep(value: number | null): number {
  const number = clampBound(value, 1);
  return number === 0 ? 1 : number;
}

const fromValue = variable.compute(() => clampBound(start.value, 0));
const toValue = variable.compute(() => clampBound(end.value, 6));
const stepValue = variable.compute(() => readStep(step.value));
</script>

<div class="for-demo">
  <div class="fields">
    <label>From <input type="number" bind={start} /></label>
    <label>To, not included <input type="number" bind={end} /></label>
    <label>Step <input type="number" bind={step} /></label>
  </div>
  <div class="cells">
    <FOR {n} from={fromValue} to={toValue} step={stepValue}>
      <span class="cell">{n}</span>
    </FOR>
  </div>
  <p>A countdown, from 10 down to 1 by 3:</p>
  <div class="cells">
    <FOR {n} from={10} to={0} step={-3}>
      <span class="cell down">{n}</span>
    </FOR>
  </div>
</div>

<style>
.for-demo {
  display: grid;
  gap: 0.75rem;
  color: var(--fg);

  p { margin: 0; color: var(--muted); font-size: 0.9rem; }

  .fields {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(7rem, 1fr));
    gap: 0.75rem;
    min-width: 0;
  }

  label {
    display: grid;
    gap: 0.25rem;
    color: var(--muted);
  }

  input {
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--bg);
    color: var(--fg);
    font: inherit;
  }

  .cells {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .cell {
    display: grid;
    place-items: center;
    min-width: 2.2rem;
    height: 2.2rem;
    border-radius: 10px;
    background: var(--sky);
    color: #1d4f7a;
    font-weight: 700;

    &.down { background: var(--pink); color: #3a2e4a; }
  }
}
</style>
