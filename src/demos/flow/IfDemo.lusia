<script>
import { WHEN, PRESET, variable } from "lusiajs";

const mode = variable("out");

// A branch slides in when it appears and fades out when another branch replaces it.
const fadeOut = {
	0: { opacity: 1 },
	1: { opacity: 0 },
};

const branchMotion = [
	{ style: PRESET.SLIDE_UP, when: WHEN.ATTACH, duration: 300 },
	{ style: fadeOut, when: WHEN.DETACH, duration: 200 },
];

function signIn() {
	mode.value = "member";
}

function continueAsGuest() {
	mode.value = "guest";
}

function signOut() {
	mode.value = "out";
}
</script>

<div class="if-demo">
	<div class="actions">
		<button type="button" onclick={signIn}>Sign in</button>
		<button type="button" onclick={continueAsGuest}>Guest</button>
		<button type="button" onclick={signOut}>Sign out</button>
	</div>
	<IF {mode.value === "member"}>
		<p class="branch" animate={branchMotion}>Welcome back, Ada.</p>
	</IF>
	<ELSEIF {mode.value === "guest"}>
		<p class="branch" animate={branchMotion}>
			Hi guest. Some pages are locked.
		</p>
	</ELSEIF>
	<ELSE>
		<p class="branch" animate={branchMotion}>Please sign in.</p>
	</ELSE>
</div>

<style>
@use "../../styles/demo" as demo;

.if-demo {
	display: grid;
	gap: 0.75rem;
	justify-items: start;
	color: var(--fg);

	p {
		margin: 0;
	}

	.actions {
		@include demo.row;
	}

	button {
		@include demo.button;
	}

	.branch {
		padding: 0.6rem 0.9rem;
		border-radius: 12px;
		background: var(--mint);
		color: #1f5f4a;
		font-weight: 700;
	}
}
</style>
