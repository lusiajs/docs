<script>
import { WHEN, PRESET, variable } from "lusia";

interface Task {
	id: number;
	title: string;
}

const tasks = variable<Task[]>([
	{ id: 1, title: "Write the docs" },
	{ id: 2, title: "Fix the build" },
	{ id: 3, title: "Ship the release" },
]);
let nextId = 4;

// Rows leave by fading out. The row is removed after this animation ends.
const fadeOut = {
	0: { opacity: 1 },
	1: { opacity: 0 },
};

function addTask() {
	tasks.value = [...tasks.value, { id: nextId, title: `Task ${nextId}` }];
	nextId++;
}

function removeTask(task: Task) {
	tasks.value = tasks.value.filter((item) => item.id !== task.id);
}

function reverseTasks() {
	tasks.value = [...tasks.value].reverse();
}

function shuffleTasks() {
	tasks.value = [...tasks.value].sort(() => Math.random() - 0.5);
}
</script>

<div class="each-demo">
	<div class="actions">
		<button type="button" onclick={addTask}>Add task</button>
		<button type="button" onclick={reverseTasks}>Reverse</button>
		<button type="button" onclick={shuffleTasks}>Shuffle</button>
	</div>
	<p class="count">{tasks.value.length} tasks</p>
	<ol class="list">
		<EACH {tasks} as={task} index={position} key={task.id}>
			<li
				class="row"
				animate={[
          { style: PRESET.SLIDE_IN_UP, when: WHEN.ATTACH, duration: 300 },
          { style: fadeOut, when: WHEN.DETACH, duration: 200 },
        ]}
			>
				<span>{position}. {task.title}</span>
				<button type="button" onclick={() => removeTask(task)}>
					Remove
				</button>
			</li>
		</EACH>
	</ol>
</div>

<style>
@use "../../styles/demo" as demo;

.each-demo {
	display: grid;
	gap: 0.6rem;
	color: var(--fg);

	p {
		margin: 0;
	}

	.count {
		color: var(--muted);
		font-size: 0.9rem;
	}

	.actions {
		@include demo.row;
	}

	button {
		@include demo.button;
	}

	.list {
		display: grid;
		gap: 0.4rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		padding: 0.4rem 0.6rem;
		border-radius: 10px;
		background: var(--lavender-soft);
	}
}
</style>
