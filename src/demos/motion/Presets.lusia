<script>
import { PRESET, variable } from "lusia";

function createTile(name) {
	return { name, animation: PRESET[name], hovered: variable(false) };
}

const groups = [
	{ title: "Fade", names: ["FADE_IN", "FADE_OUT"] },
	{ title: "Slide", names: ["SLIDE_UP", "SLIDE_DOWN", "SLIDE_LEFT", "SLIDE_RIGHT"] },
	{ title: "Pop and zoom", names: ["POP_IN", "POP_OUT", "ZOOM_IN", "ZOOM_OUT"] },
	{ title: "Flip and blur", names: ["FLIP_IN", "FLIP_OUT", "BLUR_IN", "BLUR_OUT"] },
	{ title: "Bounce", names: ["DROP_IN", "BOUNCE_IN"] },
	{ title: "Attention", names: ["SHAKE", "PULSE", "SPIN", "WOBBLE", "HEARTBEAT", "TADA"] },
].map((group) => ({
	title: group.title,
	tiles: group.names.map(createTile),
}));

function enter(tile) {
	tile.hovered.value = true;
}

function leave(tile) {
	tile.hovered.value = false;
}
</script>

<div class="preset-gallery">
	<p>Hover a tile to play its preset.</p>
	<EACH {groups} as={group} key={group.title}>
		<section class="group">
			<h3>{group.title}</h3>
			<div class="grid">
				<EACH {group.tiles} as={tile} key={tile.name}>
					<div
						class="cell"
						onpointerenter={() => enter(tile)}
						onpointerleave={() => leave(tile)}
					>
						<div
							class="tile"
							animate={{ style: tile.animation, when: tile.hovered, duration: 500 }}
						>
							{tile.name}
						</div>
					</div>
				</EACH>
			</div>
		</section>
	</EACH>
</div>

<style>
.preset-gallery {
	display: grid;
	gap: 0.75rem;
	color: var(--fg);

	p {
		margin: 0;
		color: var(--muted);
		font-size: 0.9rem;
	}

	.group {
		display: grid;
		gap: 0.5rem;
		margin-top: 0.75rem;

		h3 {
			margin: 0;
			color: var(--fg);
			font-size: 0.95rem;
		}
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(7.5rem, 1fr));
		gap: 0.6rem;
	}

	.cell {
		display: grid;
		width: 100%;
		min-height: 4rem;
	}

	.tile {
		display: grid;
		width: 100%;
		height: 100%;
		place-items: center;
		border-radius: 14px;
		background: var(--lavender-soft);
		font-family: ui-monospace, monospace;
		font-size: 0.8rem;
		font-weight: 700;
	}
}
</style>
