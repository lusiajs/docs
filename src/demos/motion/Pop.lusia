<script>
  import { WHEN, EASE } from "lusiajs";

  // Two items: a pop when attached (IN) and a spin when detached (OUT).
  const popIn = {
    0: { opacity: 0, scale: "0.5" },
    1: [EASE.STYLE.BACK, EASE.OUT, { opacity: 1, scale: "1" }],
  };

  const spinOut = {
    0: { opacity: 1, rotate: "0deg" },
    1: [EASE.STYLE.QUART, EASE.IN, { opacity: 0, rotate: "180deg" }],
  };
</script>

<div
  class="motion-box"
  animate={[
    { style: popIn, duration: 500 },
    { style: spinOut, when: WHEN.DETACH, duration: 400 },
  ]}
>
  Pop
</div>

<style>
  .motion-box {
    padding: 1rem 1.5rem;
    border-radius: 16px;
    background: var(--lemon);
    color: #3a2e4a;
    font-weight: 700;
  }
</style>
