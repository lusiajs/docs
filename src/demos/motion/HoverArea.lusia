<script>
  import { HOVER_AREA, WHEN } from "lusiajs";

  const grow = {
    0: { scale: "1" },
    1: { scale: "1.4" },
  };
</script>

<div class="motion-stage">
  <div
    class="box"
    animate={{
      style: grow,
      when: WHEN.HOVER,
      duration: 250,
      more: { area: HOVER_AREA.FINAL },
    }}
  >
    Final box
  </div>
  <div
    class="box"
    animate={{
      style: grow,
      when: WHEN.HOVER,
      duration: 250,
      more: { area: HOVER_AREA.ELEMENT },
    }}
  >
    Element box
  </div>
</div>

