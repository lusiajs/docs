<script>
  import { ON, EASE, variable } from "lusiajs";

  // The tall section drives three steps. Each step plays in its own slice of the section.
  const section = variable(null);

  // Each step fades in, holds, and fades out again within its own slice.
  const stepPulse = {
    0: { opacity: 0, translate: "0px 24px" },
    0.5: [EASE.STYLE.LINEAR, EASE.OUT, { opacity: 1, translate: "0px 0px" }],
    1: [EASE.STYLE.LINEAR, EASE.IN, { opacity: 0, translate: "0px -24px" }],
  };

  const stepOne = {
    play: stepPulse,
    on: ON.SCROLL,
    options:{ follow: section, part: [0, 0.33] },
  };
  const stepTwo = {
    play: stepPulse,
    on: ON.SCROLL,
    options:{ follow: section, part: [0.33, 0.66] },
  };
  const stepThree = {
    play: stepPulse,
    on: ON.SCROLL,
    options:{ follow: section, part: [0.66, 1] },
  };
</script>

<div class="scroll-demo">
  <ul class="watch">
    <li>
      The section is 300vh tall. The scene stays on screen while it scrolls.
    </li>
    <li>
      Each step has a part: [from, to], a slice of the section's progress.
    </li>
    <li>
      A step outside its slice shows nothing, because its keys go back to 0.
    </li>
  </ul>
  <section class="story" bind-element={section}>
    <div class="scene">
      <p class="step" animate={stepOne}>Step 1: the idea.</p>
      <p class="step" animate={stepTwo}>Step 2: the plan.</p>
      <p class="step" animate={stepThree}>Step 3: the result.</p>
    </div>
  </section>
</div>

<style>
  .scroll-demo {
    color: var(--fg);

    .watch {
      margin: 0 0 0.5rem;
      padding-left: 1.25rem;
    }

    .story {
      height: 300vh;
    }

    .scene {
      position: sticky;
      top: 0;
      height: 100vh;
      display: grid;
      place-items: center;
    }

    .step {
      grid-area: 1 / 1;
      margin: 0;
      font-size: 1.5rem;
    }
  }
</style>
