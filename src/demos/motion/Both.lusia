<script>
  import { attach, variable, type Instance } from "lusiajs";
  import Pop from "./Pop.lusia";

  const slot = variable<Element | null>(null);
  let box: Instance | null = null;

  // Pop has an IN and an OUT style: it pops in, and spins out when detached.
  function toggleBox() {
    if (box) {
      box.detach();
      box = null;
    } else if (slot.value) {
      box = attach(Pop, slot.value);
    }
  }
</script>

<div class="motion-stage">
  <button onclick={toggleBox} type="button">Show or hide the box</button>
  <div class="slot" bind-element={slot}></div>
</div>

<style>
  @use "../../styles/demo" as demo;

  .motion-stage {
    display: grid;
    justify-items: center;
    gap: 1rem;
    color: var(--fg);

    .slot {
      min-height: 3rem;
    }

    button {
      @include demo.button;
    }
  }
</style>
