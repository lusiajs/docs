<script>
  import { ON, controller, EASE } from "lusiajs";

  // A controller plays the animation on demand: play, reverse or stop.
  const ctl = controller();

  const slide = {
    0: { translate: "0px 0px" },
    1: [EASE.STYLE.LINEAR, EASE.OUT, { translate: "220px 0px" }],
  };

  function playSlide() {
    ctl.play();
  }

  function reverseSlide() {
    ctl.reverse();
  }

  function stopSlide() {
    ctl.stop();
  }
</script>

<div class="motion-stage">
  <div class="actions">
    <button onclick={playSlide} type="button">Play</button>
    <button onclick={reverseSlide} type="button">Reverse</button>
    <button onclick={stopSlide} type="button">Stop</button>
  </div>
  <div
    class="square"
    animate={{ play: slide, on: ON.MANUAL, control: ctl, duration: 1200 }}
  ></div>
</div>

<style>
  @use "../../styles/demo" as demo;

  .motion-stage {
    display: grid;
    justify-items: start;
    gap: 1rem;
    color: var(--fg);

    .actions {
      @include demo.row;
    }

    button {
      @include demo.button;
    }

    .square {
      width: 3rem;
      height: 3rem;
      border-radius: 12px;
      background: var(--lavender);
    }
  }
</style>
