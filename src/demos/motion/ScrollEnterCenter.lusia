<script>
  import { WHEN, EASE, EDGE, onAttach } from "lusiajs";
  import { AT, watchProgress } from "./scroll-readout.ts";

  // Finishes in the middle: progress 1 when the card's centre reaches the screen middle.
  const rise = {
    0: { opacity: 0, filter: "blur(12px)" },
    1: [EASE.STYLE.LINEAR, EASE.OUT, { opacity: 1, filter: "blur(0px)" }],
  };

  const riseMotion = {
    style: rise,
    when: WHEN.SCROLL,
    more: {
      start: [EDGE.TOP, EDGE.BOTTOM],
      end: [EDGE.CENTER, EDGE.CENTER],
    },
  };

  onAttach((root) => {
    const slot = root.querySelector(".slot");
    const out = root.querySelector("output");
    return watchProgress(slot, AT.ENTER, AT.CENTER, out);
  });
</script>

<div class="scroll-demo">
  <p class="readout">progress <output>0.00</output></p>
  <ul class="watch">
    <li>Starts when the card's top meets the bottom of the screen.</li>
    <li>Done at the middle. After that the card stays put.</li>
  </ul>
  <div class="space">
    <div class="slot">
      <div class="card" animate={riseMotion}>Card</div>
    </div>
  </div>
</div>

<style>
  .scroll-demo {
    color: var(--fg);

    .readout {
      position: sticky;
      top: 1rem;
      margin: 0;
    }

    .watch {
      margin: 0.5rem 0 0;
      padding-left: 1.25rem;
    }

    .space {
      height: 150vh;
      display: grid;
      align-items: center;
    }

    .card {
      width: fit-content;
      padding: 1rem 1.5rem;
      border-radius: 12px;
      background: #16a34a;
      color: #fff;
    }
  }
</style>
