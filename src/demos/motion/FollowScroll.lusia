<script>
import { WHEN, EASE, EDGE } from "lusia";

// The bar fills and the card turns as the demo crosses the middle of the screen.
const fill = {
  0: { scale: "0 1" },
  1: [EASE.STYLE.LINEAR, EASE.OUT, { scale: "1 1" }],
};

const turn = {
  0: { rotate: "-10deg" },
  1: [EASE.STYLE.LINEAR, EASE.OUT, { rotate: "10deg" }],
};

const scrolled = {
  when: WHEN.SCROLL,
  more: {
    start: { element: EDGE.TOP, window: 0.9 },
    end: { element: EDGE.TOP, window: 0.4 },
  },
};
const barMotion = { ...scrolled, style: fill };
const cardMotion = { ...scrolled, style: turn };
</script>

<div class="motion-stage">
  <p>Scroll the page. The bar fills and the card turns.</p>
  <div class="track">
    <div class="bar" animate={barMotion}></div>
  </div>
  <div class="card" animate={cardMotion}>Card</div>
</div>

<style>
.motion-stage {
  display: grid;
  justify-items: start;
  gap: 1rem;
  color: var(--fg);

  p {
    margin: 0;
  }

  .track {
    width: 100%;
    height: 0.6rem;
    border-radius: 6px;
    background: var(--lavender-soft);
    overflow: hidden;
  }

  .bar {
    width: 100%;
    height: 100%;
    border-radius: 6px;
    background: var(--mint);
    transform-origin: left center;
  }

  .card {
    padding: 1rem 1.25rem;
    border-radius: 16px;
    background: var(--sky);
    color: #1d4f7a;
    font-weight: 700;
  }
}
</style>
