<script>
import { WHEN, EASE } from "lusia";

// It plays in after 250 ms. Leaving plays its own keys, for 700 ms.
const glow = {
  0: { backgroundColor: "#c9b6ff", scale: "1" },
  1: [EASE.STYLE.QUART, EASE.OUT, { backgroundColor: "#ffb7d5", scale: "1.25" }],
};

const fold = {
  0: { backgroundColor: "#ffb7d5", rotate: "0deg" },
  1: [EASE.STYLE.BACK, EASE.OUT, { backgroundColor: "#aef0d8", rotate: "90deg" }],
};

const hoverMotion = {
  style: glow,
  when: WHEN.HOVER,
  duration: 300,
  more: { inDelay: 250, out: fold, outDuration: 700 },
};
</script>

<div class="motion-stage">
  <p>Move over the box. It waits 250 ms, then turns when you leave.</p>
  <div class="box" animate={hoverMotion}></div>
</div>

<style>
.motion-stage {
  display: grid;
  justify-items: start;
  gap: 1rem;
  color: var(--fg);

  p {
    margin: 0;
  }

  .box {
    width: 3rem;
    height: 3rem;
    border-radius: 12px;
    background: var(--lavender);
  }
}
</style>
