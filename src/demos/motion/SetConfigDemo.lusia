<script>
  import { PRESET, SCOPE, setConfig, variable } from "lusiajs";

  const open = variable(false);

  // Changes the duration for every animation on the page until it is set again.
  function slowDown() {
    setConfig({ animate: { duration: 1200 } }, SCOPE.GLOBAL);
  }

  function reset() {
    setConfig({ animate: { duration: 400 } }, SCOPE.GLOBAL);
  }

  function toggle() {
    open.value = !open.value;
  }
</script>

<div class="motion-stage">
  <div class="actions">
    <button onclick={slowDown} type="button">Slow every animation</button>
    <button onclick={reset} type="button">Reset</button>
    <button onclick={toggle} type="button">Toggle</button>
  </div>
  <div class="box" animate={{ style: PRESET.SLIDE_UP, when: open }}>
    Moves with the default duration
  </div>
</div>

<style scoped>
  @use "../../styles/demo" as demo;

  .motion-stage {
    display: grid;
    justify-items: start;
    gap: 1rem;
    color: var(--fg);

    .actions {
      @include demo.row;
    }

    button {
      @include demo.button;
    }

    .box {
      padding: 0.8rem 1.1rem;
      border-radius: 14px;
      background: var(--sky);
      font-weight: 700;
    }
  }
</style>
