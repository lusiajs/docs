<script>
import { WHEN, variable } from "lucia";

// Each row glides to its new place when the list reorders.
const names = variable(["Ada", "Grace", "Linus", "Ken"]);
const glide = { when: WHEN.MOVE, duration: 400 };

function moveFirstToEnd() {
  const [first, ...rest] = names.value;
  names.value = [...rest, first];
}
</script>

<div class="layout-list">
  <p>Press the button. The first name moves to the end, and the rows glide.</p>
  <button onclick={moveFirstToEnd} type="button">Move the first to the end</button>
  <ul>
    <EACH {names.value} as={name} key={name}>
      <li animate={glide}>{name}</li>
    </EACH>
  </ul>
</div>

<style>
@use "../../styles/demo" as demo;

.layout-list {
  display: grid;
  justify-items: start;
  gap: 1rem;
  color: var(--fg);

  p {
    margin: 0;
  }

  button {
    @include demo.button;
  }

  ul {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  li {
    padding: 0.5rem 1rem;
    border-radius: 12px;
    background: var(--pink);
    color: #3a2e4a;
    font-weight: 700;
  }
}
</style>
