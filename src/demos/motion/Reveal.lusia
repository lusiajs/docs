<script>
import { WHEN, EASE } from "lusiajs";

const rise = {
	0: { opacity: 0, translate: "0px 20px" },
	1: [EASE.STYLE.QUART, EASE.OUT, { opacity: 1, translate: "0px 0px" }],
};

const reveal = { style: rise, when: WHEN.VIEW, duration: 500 };
</script>

<div class="motion-stage">
	<p class="item" animate={reveal}>First line</p>
	<p class="item" animate={{ ...reveal, delay: 150 }}>Second line</p>
	<p class="item" animate={{ ...reveal, delay: 300 }}>Third line</p>
</div>

<style>
.motion-stage {
	display: grid;
	gap: 0.75rem;
	color: var(--fg);

	.item {
		margin: 0;
		padding: 0.7rem 1rem;
		border-radius: 14px;
		background: var(--lavender-soft);
	}
}
</style>
