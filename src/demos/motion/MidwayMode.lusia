<script>
  import { ON, EASE, MIDWAY, variable } from "lusiajs";

  // Hover in and out quickly. The box changes its play in the mode you pick.
  const grow = {
    0: { scale: "1" },
    1: [EASE.OUT, { scale: "1.4" }],
  };

  const modes = {
    SWITCH: MIDWAY.SWITCH,
    SWITCH_SMOOTH: MIDWAY.SWITCH_SMOOTH,
    SWITCH_STOP: MIDWAY.SWITCH_STOP,
    WAIT: MIDWAY.WAIT,
    RESTART: MIDWAY.RESTART,
    JUMP_TO_END: MIDWAY.JUMP_TO_END,
    KEEP_CURRENT: MIDWAY.KEEP_CURRENT,
  };

  const modeName = variable("SWITCH");

  // midway is read when a box attaches. The box is rebuilt when the mode changes.
  const boxes = variable.compute(() => [
    {
      key: modeName.value,
      label: modeName.value,
      mode: modes[modeName.value as keyof typeof modes],
    },
  ]);
</script>

<div class="midway-demo">
  <label>
    Play mode
    <select bind-value={modeName}>
      <option value="SWITCH">SWITCH (default)</option>
      <option value="SWITCH_SMOOTH">SWITCH_SMOOTH</option>
      <option value="SWITCH_STOP">SWITCH_STOP</option>
      <option value="WAIT">WAIT</option>
      <option value="RESTART">RESTART</option>
      <option value="JUMP_TO_END">JUMP_TO_END</option>
      <option value="KEEP_CURRENT">KEEP_CURRENT</option>
    </select>
  </label>
  <div class="row">
    <EACH {boxes.value} as={box} key={box.key}>
      <div class="cell">
        <span class="label">{box.label}</span>
        <div
          class="box"
          animate={{
            play: grow,
            on: ON.HOVER,
            duration: 800,
            midway: { mode: box.mode },
          }}
        ></div>
      </div>
    </EACH>
  </div>
</div>

<style>
  .midway-demo {
    display: grid;
    gap: 1rem;
    color: var(--fg);

    label {
      display: grid;
      gap: 0.35rem;
      justify-items: start;
      font-size: 0.9rem;
    }

    .row {
      display: flex;
      flex-wrap: wrap;
      gap: 1.25rem;
    }

    .cell {
      display: grid;
      justify-items: center;
      gap: 0.5rem;
    }

    .label {
      font-family: ui-monospace, monospace;
      font-size: 0.78rem;
      color: var(--muted);
    }

    .box {
      width: 3rem;
      height: 3rem;
      border-radius: 12px;
      background: var(--mint);
    }
  }
</style>
