<script>
import { WHEN, EASE, MIDWAY, variable, TURN } from "lusia";

// Hover in and out quickly. Each box turns its own way when you change your mind.
const grow = {
  0: { scale: "1" },
  1: [EASE.OUT, { scale: "1.4" }],
};

const playModes = {
  turn: MIDWAY.TURN,
  finish: MIDWAY.FINISH,
  restart: MIDWAY.RESTART,
  skip: MIDWAY.SKIP,
  ignore: MIDWAY.IGNORE,
};

const turnModes = [
  { label: "SUDDEN", turn: TURN.SUDDEN },
  { label: "SMOOTH", turn: TURN.SMOOTH },
  { label: "STOP", turn: TURN.STOP },
];

const modeName = variable("turn");

// midway is read when a box attaches. The boxes are rebuilt when the mode changes.
const boxes = variable.compute(() =>
  turnModes.map(({ label, turn }) => ({
    key: label + modeName.value,
    label,
    turn,
    play: playModes[modeName.value as keyof typeof playModes],
  })),
);
</script>

<div class="midway-demo">
  <label>
    Play mode
    <select bind-value={modeName}>
      <option value="turn">TURN (default)</option>
      <option value="finish">FINISH</option>
      <option value="restart">RESTART</option>
      <option value="skip">SKIP</option>
      <option value="ignore">IGNORE</option>
    </select>
  </label>
  <div class="row">
    <EACH {boxes.value} as={box} key={box.key}>
      <div class="cell">
        <span class="label">{box.label}</span>
        <div
          class="box"
          animate={{
            style: grow,
            when: WHEN.HOVER,
            duration: 800,
            midway: { play: box.play, turn: box.turn, turnDuration: 250 },
          }}
        ></div>
      </div>
    </EACH>
  </div>
</div>

<style>
.midway-demo {
  display: grid;
  gap: 1rem;
  color: var(--fg);

  label {
    display: grid;
    gap: 0.35rem;
    justify-items: start;
    font-size: 0.9rem;
  }

  .row {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
  }

  .cell {
    display: grid;
    justify-items: center;
    gap: 0.5rem;
  }

  .label {
    font-family: ui-monospace, monospace;
    font-size: 0.78rem;
    color: var(--muted);
  }

  .box {
    width: 3rem;
    height: 3rem;
    border-radius: 12px;
    background: var(--mint);
  }
}
</style>
