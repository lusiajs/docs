<script>
import { WHEN, variable } from "lucia";

// The card keeps its place. When the text opens, its size changes,
// and WHEN.RESIZE glides the card to the new size.
const open = variable(false);
const glide = {
  when: WHEN.RESIZE,
  duration: 500,
  style: { 0: { opacity: 0.8 }, 1: { opacity: 1 } },
};

function toggleOpen() {
  open.value = !open.value;
}
</script>

<div class="layout-card">
  <button onclick={toggleOpen} type="button">
    {open.value ? "Show less" : "Show more"}
  </button>
  <div class="card" animate={glide}>
    <h3>Layout card</h3>
    <p>The card grows from its top edge when the rest of the text opens.</p>
    <IF {open.value}>
      <p>This text appears when the card opens.</p>
      <p>Close it, and the card shrinks back.</p>
    </IF>
  </div>
</div>

<style>
@use "../../styles/demo" as demo;

.layout-card {
  display: grid;
  justify-items: start;
  gap: 1rem;
  color: var(--fg);

  button {
    @include demo.button;
  }

  .card {
    width: 100%;
    max-width: 22rem;
    padding: 1rem 1.25rem;
    border-radius: 16px;
    background: var(--pink);
    color: #3a2e4a;

    h3,
    p {
      margin: 0 0 0.5rem;
    }
  }
}
</style>
