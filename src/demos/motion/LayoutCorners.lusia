<script>
import { WHEN, variable } from "lusiajs";

// The box has no keyframes. Its class moves it to another corner,
// and WHEN.MOVE glides it there.
const CORNERS = [
	"corner-top-left",
	"corner-top-right",
	"corner-bottom-right",
	"corner-bottom-left",
];
const step = variable(0);
const corner = variable.compute(() => CORNERS[step.value]);
const glide = { when: WHEN.MOVE, duration: 600 };

function nextCorner() {
	step.value = (step.value + 1) % CORNERS.length;
}
</script>

<div class="layout-corners">
	<p>Press the button. The box glides to the next corner.</p>
	<button onclick={nextCorner} type="button">Next corner</button>
	<div class="stage">
		<div class={`box ${corner.value}`} animate={glide}>Box</div>
	</div>
</div>

<style>
@use "../../styles/demo" as demo;

.layout-corners {
	display: grid;
	justify-items: start;
	gap: 1rem;
	color: var(--fg);

	p {
		margin: 0;
	}

	button {
		@include demo.button;
	}

	.stage {
		position: relative;
		width: 100%;
		max-width: 24rem;
		height: 10rem;
		border: 1px dashed currentColor;
		border-radius: 12px;
	}

	.box {
		position: absolute;
		padding: 0.5rem 0.9rem;
		border-radius: 12px;
		background: var(--pink);
		color: #3a2e4a;
		font-weight: 700;
	}

	.corner-top-left {
		top: 0;
		left: 0;
	}

	.corner-top-right {
		top: 0;
		right: 0;
	}

	.corner-bottom-right {
		right: 0;
		bottom: 0;
	}

	.corner-bottom-left {
		bottom: 0;
		left: 0;
	}
}
</style>
