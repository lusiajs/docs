<script>
  import { WHEN, EASE } from "lusiajs";

  // Only an OUT item: the box is visible at once, and plays this when it is detached.
  const shrinkOut = {
    0: { opacity: 1, scale: "1" },
    1: [EASE.STYLE.QUART, EASE.OUT, { opacity: 0, scale: "0.4" }],
  };
</script>

<div
  class="motion-box"
  animate={{ style: shrinkOut, when: WHEN.DETACH, duration: 400 }}
>
  Bye
</div>

<style>
  .motion-box {
    padding: 1rem 1.5rem;
    border-radius: 16px;
    background: var(--sky);
    color: #1d4f7a;
    font-weight: 700;
  }
</style>
