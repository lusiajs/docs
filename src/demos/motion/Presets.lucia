<script>
import { WHEN, PRESET } from "lucia";

// Every preset in PRESET, in order. Hovering a tile plays its preset.
const presets = Object.entries(PRESET).map(([name, animation]) => ({ name, animation }));
</script>

<div class="preset-gallery">
  <p>Hover a tile to play its preset.</p>
  <div class="grid">
    <EACH {presets} as={preset} key={preset.name}>
      <div
        class="tile"
        animate={{ style: preset.animation, when: WHEN.HOVER, duration: 500 }}
      >{preset.name}</div>
    </EACH>
  </div>
</div>

<style>
.preset-gallery {
  display: grid;
  gap: 0.75rem;
  color: var(--fg);

  p { margin: 0; color: var(--muted); font-size: 0.9rem; }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(7.5rem, 1fr));
    gap: 0.6rem;
  }

  .tile {
    display: grid;
    place-items: center;
    min-height: 4rem;
    border-radius: 14px;
    background: var(--lavender-soft);
    font-family: ui-monospace, monospace;
    font-size: 0.8rem;
    font-weight: 700;
  }
}
</style>
