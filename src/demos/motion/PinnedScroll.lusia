<script>
import { WHEN, EASE, variable } from "lusiajs";

// The tall element drives the progress. The box stays on screen while it scrolls past.
const pinDemo = variable<Element | null>(null);

const grow = {
	0: { scale: "0.4" },
	1: [EASE.STYLE.LINEAR, EASE.OUT, { scale: "1.2" }],
};

const turn = {
	0: { rotate: "0deg" },
	1: [EASE.STYLE.LINEAR, EASE.OUT, { rotate: "180deg" }],
};

const growMotion = {
	style: grow,
	when: WHEN.SCROLL,
	more: { follow: pinDemo, part: [0, 0.5] },
};

const turnMotion = {
	style: turn,
	when: WHEN.SCROLL,
	more: { follow: pinDemo, part: [0.5, 1] },
};
</script>

<div class="pin-demo" bind-element={pinDemo}>
	<div class="pin-stick">
		<p>Scroll the page. The box grows, then turns.</p>
		<div class="box" animate={[growMotion, turnMotion]}></div>
	</div>
</div>

<style>
.pin-demo {
	height: 160vh;
}

.pin-stick {
	position: sticky;
	top: 6rem;
	display: grid;
	justify-items: start;
	gap: 1rem;
	padding: 1rem;
	color: var(--fg);

	p {
		margin: 0;
	}

	.box {
		width: 3rem;
		height: 3rem;
		border-radius: 12px;
		background: var(--sky);
	}
}

@media (prefers-reduced-motion: reduce) {
	.pin-demo {
		height: auto;
	}

	.pin-stick {
		position: relative;
		top: auto;
	}
}
</style>
