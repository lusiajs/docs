<script>
  import { ON, EASE, variable } from "lusiajs";

  const shown = variable(true);

  // The box spins a full turn while it fades. Its layout space closes with it.
  const spinOut = {
    0: { opacity: 1, rotate: "0deg" },
    1: [EASE.STYLE.QUART, EASE.IN, { opacity: 0, rotate: "360deg" }],
  };

  function toggle() {
    shown.value = !shown.value;
  }
</script>

<div class="spin-away">
  <button type="button" onclick={toggle}>
    {shown.value ? "Hide the box" : "Show the box"}
  </button>
  <IF {shown.value}>
    <div
      class="box"
      animate={{ play: spinOut, on: ON.DETACH, duration: 500 }}
    >
      Spin
    </div>
  </IF>
  <p class="note">Text below the box moves up as the box leaves.</p>
</div>

<style>
  @use "../../styles/demo" as demo;

  .spin-away {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.6rem;
    color: var(--fg);

    button {
      @include demo.button;
    }

    .box {
      padding: 1rem 1.5rem;
      border-radius: 16px;
      background: var(--lavender-soft);
      font-weight: 700;
    }

    .note {
      margin: 0;
      opacity: 0.7;
    }
  }
</style>
