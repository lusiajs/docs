<script>
import { WHEN, EASE } from "lusia";

// The box stays lit for 300 ms after the pointer leaves,
// so a quick pass does not flicker.
const glow = {
  0: { backgroundColor: "#c9b6ff", scale: "1" },
  1: [EASE.STYLE.QUART, EASE.OUT, { backgroundColor: "#ffb7d5", scale: "1.2" }],
};

const hoverDelay = {
  style: glow,
  when: WHEN.HOVER,
  duration: 400,
  more: { outDelay: 300 },
};
</script>

<div class="motion-stage">
  <p>Move over the box, then away. It waits 300 ms before it goes back.</p>
  <div class="box" animate={hoverDelay}></div>
</div>

<style>
.motion-stage {
  display: grid;
  justify-items: start;
  gap: 1rem;
  color: var(--fg);

  p {
    margin: 0;
  }

  .box {
    width: 3rem;
    height: 3rem;
    border-radius: 12px;
    background: var(--lavender);
  }
}
</style>
