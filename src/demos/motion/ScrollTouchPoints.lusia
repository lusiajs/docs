<script>
  import { WHEN, EASE, EDGE, onAttach } from "lusiajs";
  import { watchProgress } from "./scroll-readout.ts";

  const fadeIn = {
    0: { opacity: 0 },
    1: [EASE.STYLE.LINEAR, EASE.OUT, { opacity: 1 }],
  };

  // A pair takes an EDGE member or a number from 0 to 1 for each point.
  const edgeStart = [EDGE.TOP, EDGE.CENTER];
  const edgeEnd = [EDGE.BOTTOM, EDGE.TOP];
  const numberStart = [0.25, 0.75];
  const numberEnd = [0.75, 0.25];
  const defaultStart = [EDGE.TOP, EDGE.BOTTOM];
  const defaultEnd = [EDGE.BOTTOM, EDGE.TOP];

  const edgeMotion = {
    style: fadeIn,
    when: WHEN.SCROLL,
    more: { start: edgeStart, end: edgeEnd },
  };
  const numberMotion = {
    style: fadeIn,
    when: WHEN.SCROLL,
    more: { start: numberStart, end: numberEnd },
  };
  const enterMotion = {
    style: fadeIn,
    when: WHEN.SCROLL,
    more: { start: defaultStart, end: defaultEnd },
  };

  onAttach((root) => {
    const cards = root.querySelectorAll(".card");
    const outputs = root.querySelectorAll("output");
    const stops = [
      watchProgress(cards[0], edgeStart, edgeEnd, outputs[0]),
      watchProgress(cards[1], numberStart, numberEnd, outputs[1]),
      watchProgress(cards[2], defaultStart, defaultEnd, outputs[2]),
    ];
    return () => stops.forEach((stop) => stop());
  });
</script>

<div class="scroll-demo">
  <ul class="watch">
    <li>
      Top: EDGE members. The card's top meets the middle, then its bottom the
      top.
    </li>
    <li>Middle: numbers. The same idea, with 0.25 and 0.75.</li>
    <li>Bottom: no start or end set, so the default range.</li>
  </ul>
  <div class="space">
    <div class="row">
      <div class="card" animate={edgeMotion}>EDGE</div>
      <output>0.00</output>
    </div>
    <div class="row">
      <div class="card" animate={numberMotion}>Numbers</div>
      <output>0.00</output>
    </div>
    <div class="row">
      <div class="card" animate={enterMotion}>Default</div>
      <output>0.00</output>
    </div>
  </div>
</div>

<style>
  .scroll-demo {
    color: var(--fg);

    .watch {
      margin: 0 0 0.5rem;
      padding-left: 1.25rem;
    }

    .space {
      height: 200vh;
      display: grid;
      align-content: center;
      gap: 3rem;
    }

    .row {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    .card {
      padding: 1rem 1.5rem;
      border-radius: 12px;
      background: #0891b2;
      color: #fff;
    }
  }
</style>
