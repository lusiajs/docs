<script>
import { WHEN, EASE, EDGE, SCROLL_AT } from "lusia";
import { watchProgress } from "./scroll-readout.ts";

const fadeIn = {
  0: { opacity: 0 },
  1: [EASE.STYLE.LINEAR, EASE.OUT, { opacity: 1 }],
};

// An object takes an EDGE member or a number from 0 to 1 for each point.
const edgeStart = { element: EDGE.TOP, window: EDGE.CENTER };
const edgeEnd = { element: EDGE.BOTTOM, window: EDGE.TOP };
const numberStart = { element: 0.25, window: 0.75 };
const numberEnd = { element: 0.75, window: 0.25 };
const enterStart = { element: 0, window: 1 };
const leaveEnd = { element: 1, window: 0 };

const edgeMotion = {
  style: fadeIn,
  when: WHEN.SCROLL,
  more: { start: edgeStart, end: edgeEnd },
};
const numberMotion = {
  style: fadeIn,
  when: WHEN.SCROLL,
  more: { start: numberStart, end: numberEnd },
};
const enterMotion = {
  style: fadeIn,
  when: WHEN.SCROLL,
  more: { start: SCROLL_AT.ENTER, end: SCROLL_AT.LEAVE },
};

function setup(root) {
  const cards = root.querySelectorAll(".card");
  const outputs = root.querySelectorAll("output");
  const stops = [
    watchProgress(cards[0], edgeStart, edgeEnd, outputs[0]),
    watchProgress(cards[1], numberStart, numberEnd, outputs[1]),
    watchProgress(cards[2], enterStart, leaveEnd, outputs[2]),
  ];
  return () => stops.forEach((stop) => stop());
}
</script>

<div class="scroll-demo">
  <ul class="watch">
    <li>Top: EDGE members. The card's top meets the middle, then its bottom the top.</li>
    <li>Middle: numbers. The same idea, with 0.25 and 0.75.</li>
    <li>Bottom: SCROLL_AT.ENTER to LEAVE, the default.</li>
  </ul>
  <div class="space">
    <div class="row">
      <div class="card" animate={edgeMotion}>EDGE</div>
      <output>0.00</output>
    </div>
    <div class="row">
      <div class="card" animate={numberMotion}>Numbers</div>
      <output>0.00</output>
    </div>
    <div class="row">
      <div class="card" animate={enterMotion}>SCROLL_AT</div>
      <output>0.00</output>
    </div>
  </div>
</div>

<style>
.scroll-demo {
  color: var(--fg);

  .watch {
    margin: 0 0 0.5rem;
    padding-left: 1.25rem;
  }

  .space {
    height: 200vh;
    display: grid;
    align-content: center;
    gap: 3rem;
  }

  .row {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .card {
    padding: 1rem 1.5rem;
    border-radius: 12px;
    background: #0891b2;
    color: #fff;
  }
}
</style>
