<script>
  import { ON, PRESET, onAttach, variable } from "lusiajs";
  import { watchPinned } from "./scroll-readout.ts";

  // One tall lane drives all four presets, so they play side by side.
  const lane = variable(null);

  const upMotion = {
    play: PRESET.SLIDE_UP,
    on: ON.SCROLL,
    options:{ follow: lane },
  };
  const downMotion = {
    play: PRESET.SLIDE_DOWN,
    on: ON.SCROLL,
    options:{ follow: lane },
  };
  const leftMotion = {
    play: PRESET.SLIDE_LEFT,
    on: ON.SCROLL,
    options:{ follow: lane },
  };
  const rightMotion = {
    play: PRESET.SLIDE_RIGHT,
    on: ON.SCROLL,
    options:{ follow: lane },
  };

  onAttach((root) => {
    return watchPinned(root.querySelector(".lane"), root.querySelector("output"));
  });
</script>

<div class="scroll-demo">
  <p class="readout">lane progress <output>0.00</output></p>
  <ul class="watch">
    <li>Scroll the lane. All four cards play at the same progress.</li>
    <li>The pairs move in opposite directions.</li>
  </ul>
  <section class="lane" bind-element={lane}>
    <div class="scene">
      <div class="pair">
        <div class="cell">
          <span class="name">SLIDE_UP</span>
          <div class="card" animate={upMotion}>Up</div>
        </div>
        <div class="cell">
          <span class="name">SLIDE_DOWN</span>
          <div class="card" animate={downMotion}>Down</div>
        </div>
      </div>
      <div class="pair">
        <div class="cell">
          <span class="name">SLIDE_LEFT</span>
          <div class="card" animate={leftMotion}>Left</div>
        </div>
        <div class="cell">
          <span class="name">SLIDE_RIGHT</span>
          <div class="card" animate={rightMotion}>Right</div>
        </div>
      </div>
    </div>
  </section>
</div>

<style>
  .scroll-demo {
    color: var(--fg);

    .readout {
      position: sticky;
      top: 1rem;
      margin: 0;
      z-index: 1;
    }

    .watch {
      margin: 0.5rem 0 0;
      padding-left: 1.25rem;
    }

    .lane {
      height: 220vh;
    }

    .scene {
      position: sticky;
      top: 0;
      height: 100vh;
      display: grid;
      align-content: center;
      gap: 2rem;
    }

    .pair {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }

    .name {
      display: block;
      font-size: 0.8rem;
      opacity: 0.7;
    }

    .card {
      padding: 1rem;
      border-radius: 12px;
      background: #7c3aed;
      color: #fff;
    }
  }
</style>
