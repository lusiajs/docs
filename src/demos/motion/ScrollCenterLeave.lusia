<script>
  import { ON, EASE, EDGE, onAttach } from "lusiajs";
  import { AT, watchProgress } from "./scroll-readout.ts";

  // Starts at the middle and fades out as the card leaves the top of the screen.
  const fadeOut = {
    0: { opacity: 1, scale: "1" },
    1: [EASE.STYLE.LINEAR, EASE.IN, { opacity: 0, scale: "0.9" }],
  };

  const fadeOutMotion = {
    play: fadeOut,
    on: ON.SCROLL,
    options:{
      start: [EDGE.CENTER, EDGE.CENTER],
      end: [EDGE.BOTTOM, EDGE.TOP],
    },
  };

  onAttach((root) => {
    const slot = root.querySelector(".slot");
    const out = root.querySelector("output");
    return watchProgress(slot, AT.CENTER, AT.LEAVE, out);
  });
</script>

<div class="scroll-demo">
  <p class="readout">progress <output>0.00</output></p>
  <ul class="watch">
    <li>Progress 0 when the card's centre meets the middle of the screen.</li>
    <li>Progress 1 when its bottom meets the top of the screen.</li>
  </ul>
  <div class="space">
    <div class="slot">
      <div class="card" animate={fadeOutMotion}>Card</div>
    </div>
  </div>
</div>

<style>
  .scroll-demo {
    color: var(--fg);

    .readout {
      position: sticky;
      top: 1rem;
      margin: 0;
    }

    .watch {
      margin: 0.5rem 0 0;
      padding-left: 1.25rem;
    }

    .space {
      height: 150vh;
      display: grid;
      align-items: center;
    }

    .card {
      width: fit-content;
      padding: 1rem 1.5rem;
      border-radius: 12px;
      background: #e11d48;
      color: #fff;
    }
  }
</style>
