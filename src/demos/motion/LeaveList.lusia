<script>
import { WHEN, variable } from "lusia";

interface Task {
	id: number;
	title: string;
}

const tasks = variable<Task[]>([
	{ id: 1, title: "Read the docs" },
	{ id: 2, title: "Fix the build" },
	{ id: 3, title: "Ship the release" },
	{ id: 4, title: "Plan the next sprint" },
]);
const animateSpace = variable(true);
let nextId = 5;

// A removed row fades out. animateSpace is on by default. The two lists below differ only in it.
const fadeOut = {
	0: { opacity: 1 },
	1: { opacity: 0 },
};

function addTask() {
	tasks.value = [...tasks.value, { id: nextId, title: `Task ${nextId}` }];
	nextId++;
}

function removeTask(task: Task) {
	tasks.value = tasks.value.filter((item) => item.id !== task.id);
}

function toggleAnimateSpace() {
	animateSpace.value = !animateSpace.value;
}
</script>

<div class="leave-list">
	<div class="actions">
		<button type="button" onclick={addTask}>Add task</button>
		<button type="button" onclick={toggleAnimateSpace}>
			Animate space: {animateSpace.value ? "on" : "off"}
		</button>
	</div>
	<IF {animateSpace.value}>
		<ul class="list">
			<EACH {tasks} as={task} key={task.id}>
				<li
					class="row"
					animate={{ style: fadeOut, when: WHEN.DETACH, duration: 400 }}
				>
					<span>{task.title}</span>
					<button type="button" onclick={() => removeTask(task)}>
						Remove
					</button>
				</li>
			</EACH>
		</ul>
	</IF>
	<ELSE>
		<ul class="list">
			<EACH {tasks} as={task} key={task.id}>
				<li
					class="row"
					animate={{
            style: fadeOut,
            when: WHEN.DETACH,
            duration: 400,
            more: { animateSpace: false },
          }}
				>
					<span>{task.title}</span>
					<button type="button" onclick={() => removeTask(task)}>
						Remove
					</button>
				</li>
			</EACH>
		</ul>
	</ELSE>
</div>

<style>
@use "../../styles/demo" as demo;

.leave-list {
	display: grid;
	gap: 0.6rem;
	color: var(--fg);

	.actions {
		@include demo.row;
	}

	button {
		@include demo.button;
	}

	.list {
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem;
		padding: 0.4rem 0.6rem;
		border-radius: 10px;
		background: var(--lavender-soft);
	}
}
</style>
