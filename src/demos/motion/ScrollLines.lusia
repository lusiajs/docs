<script>
import { setup } from "lusia";
import { onScrollFrame, meets } from "./scroll-readout.ts";

// A window line lights up when an element line is on it, and the other way round.
function lineAt(el) {
  return Number(el.dataset.at);
}

function meetsAny(rect, line, others) {
  return others.some((other) => meets(rect, lineAt(line), lineAt(other)));
}

// The window lines are fixed to the screen, so they show only while the demo is on it.
function isOnScreen(root) {
  const rect = root.getBoundingClientRect();
  return rect.bottom > 0 && rect.top < window.innerHeight;
}

setup((root) => {
  const card = root.querySelector(".card");
  const windowLines = [...root.querySelectorAll(".window-line")];
  const cardLines = [...root.querySelectorAll(".card-line")];
  return onScrollFrame(() => {
    const rect = card.getBoundingClientRect();
    const onScreen = isOnScreen(root);
    for (const line of windowLines) line.hidden = !onScreen;
    for (const line of cardLines) {
      line.classList.toggle("lit", meetsAny(rect, line, windowLines));
    }
    for (const line of windowLines) {
      line.classList.toggle("lit", meetsAny(rect, line, cardLines));
    }
  });
});
</script>

<div class="scroll-demo">
  <ul class="watch">
    <li>The blue lines are the window: top, centre and bottom of the screen.</li>
    <li>The card has its own lines: top, centre and bottom.</li>
    <li>A line turns red when it meets the other one. That is a start or end point.</li>
  </ul>

  <div class="window-line" data-at="0" style="top: 0%"><span>window top</span></div>
  <div class="window-line" data-at="0.5" style="top: 50%"><span>window centre</span></div>
  <div class="window-line" data-at="1" style="top: 100%"><span>window bottom</span></div>

  <div class="space">
    <div class="card">
      Card
      <i class="card-line" data-at="0" style="top: 0%"></i>
      <i class="card-line" data-at="0.5" style="top: 50%"></i>
      <i class="card-line" data-at="1" style="top: 100%"></i>
    </div>
  </div>
</div>

<style>
.scroll-demo {
  color: var(--fg);

  .watch {
    margin: 0 0 0.5rem;
    padding-left: 1.25rem;
  }

  .window-line {
    position: fixed;
    left: 0;
    right: 0;
    height: 2px;
    background: #2563eb;
    z-index: 1;

    span {
      position: absolute;
      right: 0.5rem;
      bottom: 4px;
      font-size: 0.75rem;
      color: #2563eb;
    }

    &.lit {
      background: #e11d48;
    }
  }

  .space {
    height: 160vh;
    display: grid;
    align-items: center;
  }

  .card {
    position: relative;
    width: 60%;
    height: 160px;
    padding: 1rem;
    border-radius: 12px;
    background: #f1f5f9;
    color: #0f172a;
  }

  .card-line {
    position: absolute;
    left: 0;
    right: 0;
    height: 2px;
    background: #64748b;

    &.lit {
      background: #e11d48;
    }
  }
}
</style>
