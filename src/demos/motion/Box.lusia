<script>
import { EASE } from "lusia";

// Key 0 is where it starts. Key 1 sets the motion into place:
// CUBIC, slowing down at the end.
const fadeIn = {
	0: { opacity: 0, scale: "0.6" },
	1: [EASE.STYLE.CUBIC, EASE.OUT, { opacity: 1, scale: "1" }],
};
</script>

<div class="motion-box" animate={{ style: fadeIn, duration: 900 }}>Hello</div>

<style>
.motion-box {
	padding: 1rem 1.5rem;
	border-radius: 16px;
	background: var(--pink);
	color: #3a2e4a;
	font-weight: 700;
}
</style>
