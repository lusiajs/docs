<script>
import { WHEN, EASE, variable } from "lusia";
import { watchPinned } from "./scroll-readout.ts";

// The tall lane drives every effect. The effects move the cards, not the lane.
const lane = variable(null);
const page = variable(null);

const barGrow = {
  0: { scale: "0 1" },
  1: [EASE.STYLE.LINEAR, EASE.OUT, { scale: "1 1" }],
};

const barMotion = { style: barGrow, when: WHEN.SCROLL, more: { follow: page } };

// Two layers at different speeds make the parallax.
const slow = {
  0: { translate: "0px 0px" },
  1: [EASE.STYLE.LINEAR, EASE.OUT, { translate: "0px -40px" }],
};
const fast = {
  0: { translate: "0px 0px" },
  1: [EASE.STYLE.LINEAR, EASE.OUT, { translate: "0px -160px" }],
};

const slowMotion = { style: slow, when: WHEN.SCROLL, more: { follow: lane } };
const fastMotion = { style: fast, when: WHEN.SCROLL, more: { follow: lane } };

// Rotate, scale and colour change together.
const spin = {
  0: { rotate: "0deg", scale: "0.8", backgroundColor: "#e11d48" },
  1: [
    EASE.STYLE.LINEAR,
    EASE.OUT,
    { rotate: "180deg", scale: "1.2", backgroundColor: "#2563eb" },
  ],
};

const spinMotion = { style: spin, when: WHEN.SCROLL, more: { follow: lane } };

function setup(root) {
  page.value = document.documentElement;
  lane.value = root.querySelector(".lane");
  return watchPinned(root.querySelector(".lane"), root.querySelector("output"));
}
</script>

<div class="scroll-demo">
  <div class="bar" animate={barMotion}></div>
  <p class="readout">lane progress <output>0.00</output></p>
  <ul class="watch">
    <li>The top bar is the page progress: it follows the whole page.</li>
    <li>The back layer moves less than the front layer: parallax.</li>
    <li>The card turns, grows and changes colour as the lane scrolls.</li>
  </ul>
  <section class="lane">
    <div class="scene">
      <div class="layer back" animate={slowMotion}>Back layer</div>
      <div class="layer front" animate={fastMotion}>Front layer</div>
      <div class="spin" animate={spinMotion}>Spin</div>
    </div>
  </section>
</div>

<style>
.scroll-demo {
  color: var(--fg);

  .bar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: 6px;
    background: #2563eb;
    transform-origin: left center;
    z-index: 2;
  }

  .readout {
    position: sticky;
    top: 1rem;
    margin: 0;
    z-index: 1;
  }

  .watch {
    margin: 0 0 0.5rem;
    padding-left: 1.25rem;
  }

  .lane {
    height: 220vh;
  }

  .scene {
    position: sticky;
    top: 0;
    height: 100vh;
    display: grid;
    align-content: center;
    justify-items: start;
    gap: 2rem;
  }

  .layer {
    padding: 1rem;
    border-radius: 12px;
    width: fit-content;
  }

  .back {
    background: #cbd5e1;
  }

  .front {
    background: #0f172a;
    color: #fff;
  }

  .spin {
    width: 120px;
    height: 120px;
    display: grid;
    place-items: center;
    border-radius: 16px;
    color: #fff;
  }
}
</style>
