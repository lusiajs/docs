<script>
  import { EASE, PRESET, WHEN, setAnimateDefault, variable } from "lusiajs";

  const open = variable(false);

  // This changes the default for every animation on the page until it is reset.
  function slowDown() {
    setAnimateDefault({ duration: 1200, ease: [EASE.STYLE.CUBIC, EASE.OUT] });
  }

  // 400 ms and QUART INOUT are the defaults set in lusia.config for this site.
  function reset() {
    setAnimateDefault({ duration: 400, ease: [EASE.STYLE.QUART, EASE.INOUT] });
  }

  function toggle() {
    open.value = !open.value;
  }
</script>

<div class="motion-stage">
  <div class="actions">
    <button onclick={slowDown} type="button">Slow every animation</button>
    <button onclick={reset} type="button">Reset</button>
    <button onclick={toggle} type="button">Toggle</button>
  </div>
  <div class="box" animate={{ style: PRESET.SLIDE_UP, when: open }}>
    Moves with the default timing
  </div>
</div>

<style scoped>
  @use "../../styles/demo" as demo;

  .motion-stage {
    display: grid;
    justify-items: start;
    gap: 1rem;
    color: var(--fg);

    .actions {
      @include demo.row;
    }

    button {
      @include demo.button;
    }

    .box {
      padding: 0.8rem 1.1rem;
      border-radius: 14px;
      background: var(--sky);
      font-weight: 700;
    }
  }
</style>
