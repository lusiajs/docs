<script>
  import { ON, EASE } from "lusiajs";

  // With no ease, the keys use the engine default: QUART and INOUT.
  const plain = {
    0: { translate: "0px 0px" },
    1: { translate: "150px 0px" },
  };

  // ease sets the easing for every key that does not set its own.
  const backOut = {
    ease: [EASE.STYLE.BACK, EASE.OUT],
    0: { translate: "0px 0px" },
    1: { translate: "150px 0px" },
  };

  // Key 1 sets only the ease. It keeps the keyframes' BOUNCE style.
  const bounceIn = {
    ease: [EASE.STYLE.BOUNCE, EASE.IN],
    0: { translate: "0px 0px" },
    1: [EASE.OUT, { translate: "150px 0px" }],
  };

  const plainMotion = { play: plain, on: ON.HOVER, duration: 800 };
  const backMotion = { play: backOut, on: ON.HOVER, duration: 800 };
  const bounceMotion = { play: bounceIn, on: ON.HOVER, duration: 1000 };
</script>

<div class="curve-demo">
  <p>Hover each box. The defaults are set on the keyframes, not on the item.</p>
  <div class="row">
    <span class="label">No ease: QUART, INOUT</span>
    <div class="track">
      <div class="box" animate={plainMotion}></div>
    </div>
  </div>
  <div class="row">
    <span class="label">ease: BACK, OUT</span>
    <div class="track">
      <div class="box" animate={backMotion}></div>
    </div>
  </div>
  <div class="row">
    <span class="label">ease: BOUNCE, IN. Key 1 sets OUT only</span>
    <div class="track">
      <div class="box" animate={bounceMotion}></div>
    </div>
  </div>
</div>

<style>
  .curve-demo {
    display: grid;
    gap: 0.75rem;
    color: var(--fg);

    p {
      margin: 0;
      color: var(--muted);
      font-size: 0.9rem;
    }

    .row {
      display: grid;
      gap: 0.35rem;
    }

    .label {
      font-family: ui-monospace, monospace;
      font-size: 0.78rem;
      color: var(--muted);
    }

    .track {
      padding: 0.25rem 0;
    }

    .box {
      width: 2.6rem;
      height: 2.6rem;
      border-radius: 12px;
      background: var(--pink);
    }
  }
</style>
