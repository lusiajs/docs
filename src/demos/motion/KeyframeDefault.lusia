<script>
  import { WHEN, EASE } from "lusiajs";

  // With no default, the keys use the engine default: QUART and INOUT.
  const plain = {
    0: { translate: "0px 0px" },
    1: { translate: "150px 0px" },
  };

  // default sets the easing for every key that does not set its own.
  const backOut = {
    default: [EASE.STYLE.BACK, EASE.OUT],
    0: { translate: "0px 0px" },
    1: { translate: "150px 0px" },
  };

  // Key 1 sets only the ease. It keeps the default's BOUNCE style.
  const bounceIn = {
    default: [EASE.STYLE.BOUNCE, EASE.IN],
    0: { translate: "0px 0px" },
    1: [EASE.OUT, { translate: "150px 0px" }],
  };

  const plainMotion = { style: plain, when: WHEN.HOVER, duration: 800 };
  const backMotion = { style: backOut, when: WHEN.HOVER, duration: 800 };
  const bounceMotion = { style: bounceIn, when: WHEN.HOVER, duration: 1000 };
</script>

<div class="curve-demo">
  <p>Hover each box. The defaults are set on the keyframes, not on the item.</p>
  <div class="row">
    <span class="label">No default: QUART, INOUT</span>
    <div class="track">
      <div class="box" animate={plainMotion}></div>
    </div>
  </div>
  <div class="row">
    <span class="label">default: BACK, OUT</span>
    <div class="track">
      <div class="box" animate={backMotion}></div>
    </div>
  </div>
  <div class="row">
    <span class="label">default: BOUNCE, IN. Key 1 sets OUT only</span>
    <div class="track">
      <div class="box" animate={bounceMotion}></div>
    </div>
  </div>
</div>

<style>
  .curve-demo {
    display: grid;
    gap: 0.75rem;
    color: var(--fg);

    p {
      margin: 0;
      color: var(--muted);
      font-size: 0.9rem;
    }

    .row {
      display: grid;
      gap: 0.35rem;
    }

    .label {
      font-family: ui-monospace, monospace;
      font-size: 0.78rem;
      color: var(--muted);
    }

    .track {
      padding: 0.25rem 0;
    }

    .box {
      width: 2.6rem;
      height: 2.6rem;
      border-radius: 12px;
      background: var(--pink);
    }
  }
</style>
