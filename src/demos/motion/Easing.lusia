<script>
import { WHEN, EASE } from "lusia";

// An easing is any function from 0 to 1 that starts at 0 and ends at 1.
function squared(t: number) {
	return t * t;
}

const slide = {
	0: { translate: "0px 0px" },
	1: [squared, EASE.OUT, { translate: "180px 0px" }],
};
</script>

<div class="motion-stage">
	<p>Hover the square. It uses a custom easing.</p>
	<div
		class="square"
		animate={{ style: slide, when: WHEN.HOVER, duration: 700 }}
	></div>
</div>

<style>
.motion-stage {
	display: grid;
	justify-items: start;
	gap: 1rem;
	color: var(--fg);

	p {
		margin: 0;
	}

	.square {
		width: 3rem;
		height: 3rem;
		border-radius: 12px;
		background: var(--mint);
	}
}
</style>
