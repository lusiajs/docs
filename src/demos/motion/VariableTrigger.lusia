<script>
import { EASE, variable } from "lusia";

// A variable is a trigger: true plays the animation forward, false plays it back.
const open = variable(false);

const panelIn = {
  0: { opacity: 0, translate: "0px 12px" },
  1: [EASE.STYLE.QUART, EASE.OUT, { opacity: 1, translate: "0px 0px" }],
};

function toggleOpen() {
  open.value = !open.value;
}
</script>

<div class="motion-stage">
  <button onclick={toggleOpen} type="button">Open or close the panel</button>
  <div
    class="panel"
    animate={{ style: panelIn, when: open, duration: 400 }}
  >Panel content</div>
</div>

<style>
@use "../../styles/demo" as demo;

.motion-stage {
  display: grid;
  justify-items: start;
  gap: 1rem;
  color: var(--fg);

  button {
    @include demo.button;
  }

  .panel {
    padding: 1rem 1.25rem;
    border-radius: 16px;
    background: var(--mint);
    color: #1f5f4a;
    font-weight: 700;
  }
}
</style>
