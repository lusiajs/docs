<script>
import { WHEN, EASE, SCROLL_AT } from "lusia";
import { AT, watchProgress } from "./scroll-readout.ts";

// Two items on one card. They set different properties, so they do not fight.
// If two items set the same property, the later item wins.
const fadeIn = {
  0: { opacity: 0 },
  1: [EASE.STYLE.LINEAR, EASE.OUT, { opacity: 1 }],
};

const blurOut = {
  0: { filter: "blur(0px)" },
  1: [EASE.STYLE.LINEAR, EASE.IN, { filter: "blur(10px)" }],
};

const fadeInMotion = {
  style: fadeIn,
  when: WHEN.SCROLL,
  more: { start: SCROLL_AT.ENTER, end: SCROLL_AT.CENTER },
};
const blurOutMotion = {
  style: blurOut,
  when: WHEN.SCROLL,
  more: { start: SCROLL_AT.CENTER, end: SCROLL_AT.LEAVE },
};
const motion = [fadeInMotion, blurOutMotion];

function setup(root) {
  const card = root.querySelector(".card");
  const outputs = root.querySelectorAll("output");
  const stops = [
    watchProgress(card, AT.ENTER, AT.CENTER, outputs[0]),
    watchProgress(card, AT.CENTER, AT.LEAVE, outputs[1]),
  ];
  return () => stops.forEach((stop) => stop());
}
</script>

<div class="scroll-demo">
  <p class="readout">
    fade in <output>0.00</output> &middot; blur out <output>0.00</output>
  </p>
  <ul class="watch">
    <li>Fades in from the bottom to the middle of the screen.</li>
    <li>Blurs out from the middle to the top.</li>
  </ul>
  <div class="space">
    <div class="card" animate={motion}>Card</div>
  </div>
</div>

<style>
.scroll-demo {
  color: var(--fg);

  .readout {
    position: sticky;
    top: 1rem;
    margin: 0;
  }

  .watch {
    margin: 0.5rem 0 0;
    padding-left: 1.25rem;
  }

  .space {
    height: 180vh;
    display: grid;
    align-items: center;
  }

  .card {
    width: fit-content;
    padding: 1rem 1.5rem;
    border-radius: 12px;
    background: #ea580c;
    color: #fff;
  }
}
</style>
