<script>
import { variable } from "lusia";

interface Todo {
	id: number;
	title: string;
	done: boolean;
}

const count = variable(0);
const name = variable("");
const draft = variable("");
const todos = variable<Todo[]>([
	{ id: 1, title: "Write the docs", done: true },
	{ id: 2, title: "Ship the release", done: false },
]);
let nextId = 3;

const label = variable.compute(() => (count.value > 4 ? "hot" : "warming up"));
const remaining = variable.compute(
	() => todos.value.filter((todo) => !todo.done).length,
);

function increment() {
	count.value++;
}

function addTodo() {
	const title = draft.value.trim();
	if (title === "") return;
	todos.value = [...todos.value, { id: nextId, title, done: false }];
	nextId++;
	draft.value = "";
}

function toggleTodo(todo: Todo) {
	todos.value = todos.value.map((item) =>
		item.id === todo.id ? { ...item, done: !item.done } : item,
	);
}

function removeTodo(todo: Todo) {
	todos.value = todos.value.filter((item) => item.id !== todo.id);
}
</script>

<main class="app">
	<h1>Hello {name.value === "" ? "stranger" : name.value}</h1>

	<section class="card">
		<h2>Variable</h2>
		<p class="count {label}">Clicked {count} times ({label})</p>
		<button type="button" onclick={increment}>Click me</button>
	</section>

	<section class="card">
		<h2>Bind</h2>
		<input type="text" bind-value={name} placeholder="Your name" />
	</section>

	<section class="card">
		<h2>Flow</h2>
		<IF {remaining.value === 0}>
			<p>All done.</p>
		</IF>
		<ELSE>
			<p>{remaining} left</p>
		</ELSE>
		<ul>
			<EACH {todos} as={todo} key={todo.id}>
				<li>
					<span class={todo.done ? 'done' : ''}>{todo.title}</span>
					<button type="button" onclick={() => toggleTodo(todo)}>
						{todo.done ? "Undo" : "Done"}
					</button>
					<button type="button" onclick={() => removeTodo(todo)}>
						Remove
					</button>
				</li>
			</EACH>
		</ul>
		<div class="row">
			<input
				type="text"
				bind-value={draft}
				placeholder="New todo title"
			/>
			<button type="button" onclick={addTodo}>Add todo</button>
		</div>
	</section>
</main>

<style>
.app {
	display: grid;
	gap: 1rem;
	max-width: 36rem;
	margin: 2rem auto;
	padding: 0 1rem;
	font-family: system-ui, sans-serif;
}

h1 {
	margin: 0;
}

.card {
	display: grid;
	gap: 0.5rem;
	padding: 1rem;
	border: 1px solid #ddd;
	border-radius: 12px;

	h2 {
		margin: 0;
		font-size: 1rem;
	}

	p {
		margin: 0;
	}
}

.row {
	display: flex;
	gap: 0.5rem;
}

.hot {
	color: tomato;
}

.done {
	text-decoration: line-through;
}
</style>
