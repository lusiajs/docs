<script>
import { variable } from "lusia";
import CodeEditor from "../components/CodeEditor.lusia";
import PlayBar from "../components/PlayBar.lusia";
import PlayErrors from "../components/PlayErrors.lusia";
import type { LiveError } from "../live/types.ts";
import { pageMotion } from "../motion/page.ts";
import { changeCode, jumpTo, selectFile } from "../playground/actions.ts";
import { active, errors, files, jump, notice, view } from "../playground/state.ts";

// The error list opens over the workspace, so it never reserves height.
const problemsOpen = variable(false);
const problemCount = variable.compute(() => errors.value.length);
const problemLabel = variable.compute(() =>
	problemCount.value === 1 ? "1 problem" : `${problemCount.value} problems`,
);
const firstProblem = variable.compute(() => errors.value[0]?.message ?? "");
const noteText = variable.compute(() =>
	notice.value !== "" ? notice.value : "Esc leaves the editor",
);
const showProblems = variable.compute(
	() => problemsOpen.value && problemCount.value > 0,
);

// The panel closes with the last problem, so it does not reopen on a later error.
variable.autoRun(() => {
	if (errors.value.length === 0) problemsOpen.value = false;
});

function showCode() {
	view.value = "code";
}

function showPreview() {
	view.value = "preview";
}

function toggleProblems() {
	problemsOpen.value = !problemsOpen.value;
}

function closeProblems() {
	problemsOpen.value = false;
}

// Choosing a problem shows the code at its line, so the panel closes.
function jumpToError(error: LiveError) {
	problemsOpen.value = false;
	jumpTo(error);
}
</script>

<main class="playground" data-view={view.value} animate={pageMotion}>
	<div class="play-views" role="group" aria-label="View">
		<button
			type="button"
			aria-pressed={String(view.value === "code")}
			onclick={showCode}
		>
			Code
		</button>
		<button
			type="button"
			aria-pressed={String(view.value === "preview")}
			onclick={showPreview}
		>
			Preview
		</button>
	</div>

	<PlayBar />

	<div class="play-work">
		<section class="play-editor" aria-label="Code">
			<CodeEditor
				files={files}
				active={active}
				onChange={changeCode}
				onSelect={selectFile}
				jump={jump}
				toolbar={false}
			/>
		</section>
		<section class="play-preview" aria-label="Preview">
			<div class="play-stage" data-preview></div>
		</section>
		<IF {showProblems}>
			<div class="play-problems" id="play-problems">
				<header class="play-problems-head">
					<h2>Problems</h2>
					<button
						class="play-close"
						type="button"
						aria-label="Close problems"
						onclick={closeProblems}
					>
						<span class="material-symbols-rounded" aria-hidden="true"
							>close</span
						>
					</button>
				</header>
				<PlayErrors errors={errors} onJump={jumpToError} />
			</div>
		</IF>
	</div>

	<div class="play-status">
		<p class="play-note" role="status">{noteText}</p>
		<IF {problemCount.value > 0}>
			<button
				class="play-problem-toggle"
				type="button"
				aria-expanded={String(problemsOpen.value)}
				aria-controls="play-problems"
				onclick={toggleProblems}
			>
				<span class="material-symbols-rounded" aria-hidden="true"
					>error</span
				>
				<span class="play-problem-text"
					>{problemLabel}: {firstProblem}</span
				>
			</button>
		</IF>
		<ELSE>
			<span class="play-ok">
				<span class="material-symbols-rounded" aria-hidden="true"
					>check_circle</span
				>
				No errors
			</span>
		</ELSE>
	</div>
</main>

<style>
@use "../styles/playground";
</style>
