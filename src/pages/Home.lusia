<script>
  import { onAttach, variable } from "lusiajs";
  import Hero from "../components/Hero.lusia";
  import Features from "../components/Features.lusia";
  import HomeBackground from "../components/HomeBackground.lusia";
  import ScrollProgress from "../components/ScrollProgress.lusia";
  import Sparks from "../components/Sparks.lusia";
  import { pageMotion } from "../motion/page.ts";
  import { heroSlow } from "../motion/hero-slow.ts";
  import { trackCursor } from "../motion/cursor.ts";
  import { spawnSparks, type Spark } from "../motion/sparks.ts";
  import { watchKonami } from "../motion/konami.ts";

  const sparks = variable<Spark[]>([]);
  const storm = variable(false);
  const slowAnchor = variable<HTMLElement | null>(null);
  const heroZone = variable<HTMLElement | null>(null);
  const pageSpan = variable<HTMLElement | null>(null);
  const heroSlowMotion = heroSlow(slowAnchor);

  const STORM_MS = 6000;

  // The Konami code calls up a petal storm for a few seconds.
  function startStorm(): void {
    storm.value = true;
    setTimeout(() => (storm.value = false), STORM_MS);
  }

  onAttach(() => {
    const stopCursor = trackCursor(sparks);
    const stopKonami = watchKonami(() => {
      startStorm();
      spawnSparks(sparks, {
        kind: "petal",
        tones: ["var(--pink)", "var(--lavender)", "var(--mint)"],
        count: 24,
        x: window.innerWidth / 2,
        y: window.innerHeight / 3,
        spread: 420,
        lift: 120,
        duration: 2600,
      });
    });
    return () => {
      stopCursor();
      stopKonami();
    };
  });
</script>

<HomeBackground storm={storm} follow={pageSpan} />
<div class="cursor-layer" aria-hidden="true">
  <Sparks sparks={sparks} />
</div>
<div class="page-root home" animate={pageMotion}>
  <span class="page-span" aria-hidden="true" bind-element={pageSpan}></span>
  <ScrollProgress follow={pageSpan} />
  <div
    class="hero-slow-anchor"
    aria-hidden="true"
    bind-element={slowAnchor}
  ></div>
  <div class="hero-zone">
    <span class="hero-zone-span" aria-hidden="true" bind-element={heroZone}></span>
    <div class="hero-slow" animate={heroSlowMotion}>
      <Hero zone={heroZone} />
    </div>
  </div>
  <Features />
</div>
