<script>
import { setup, variable } from "lusia";
import Hero from "../components/Hero.lusia";
import Features from "../components/Features.lusia";
import HomeBackground from "../components/HomeBackground.lusia";
import ScrollProgress from "../components/ScrollProgress.lusia";
import Sparks from "../components/Sparks.lusia";
import { pageMotion } from "../motion/page.ts";
import { trackCursor } from "../motion/cursor.ts";
import { spawnSparks, type Spark } from "../motion/sparks.ts";
import { watchKonami } from "../motion/konami.ts";

const homeEl = variable<HTMLElement | null>(null);
const sparks = variable<Spark[]>([]);
const storm = variable(false);

const STORM_MS = 6000;

// The Konami code calls up a petal storm for a few seconds.
function startStorm(): void {
  storm.value = true;
  setTimeout(() => (storm.value = false), STORM_MS);
}

setup(() => {
  const stopCursor = trackCursor(sparks);
  const stopKonami = watchKonami(() => {
    startStorm();
    spawnSparks(sparks, {
      kind: "petal",
      tones: ["var(--pink)", "var(--lavender)", "var(--mint)"],
      count: 24,
      x: window.innerWidth / 2,
      y: window.innerHeight / 3,
      spread: 420,
      lift: 120,
      duration: 2600,
    });
  });
  return () => {
    stopCursor();
    stopKonami();
  };
});
</script>

<div class="page-root home" animate={pageMotion} bind-element={homeEl}>
  <HomeBackground follow={homeEl} storm={storm} />
  <ScrollProgress follow={homeEl} />
  <div class="cursor-layer" aria-hidden="true">
    <Sparks sparks={sparks} />
  </div>
  <Hero follow={homeEl} />
  <Features />
</div>
