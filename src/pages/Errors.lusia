<script>
  import { CODES } from "lusiajs/errors/codes.ts";
  import { pageMotion } from "../motion/page.ts";

  // The page reads the code table directly, so it can never drift from the compiler.
  const entries = Object.entries(CODES).map(([id, code]) => ({ id, ...code }));
  const groups = [
    {
      id: "l1",
      label: "Build errors",
      intro: "A problem in a .lusia file, reported while the app builds.",
      codes: entries.filter((entry) => entry.id.startsWith("L1")),
    },
    {
      id: "l2",
      label: "Runtime errors",
      intro:
        "A bad value passed to animate, bind-value, EACH, FOR or a lazy component.",
      codes: entries.filter((entry) => entry.id.startsWith("L2")),
    },
    {
      id: "l3",
      label: "Bundle errors",
      intro: "An import or file the bundler cannot build.",
      codes: entries.filter((entry) => entry.id.startsWith("L3")),
    },
  ];
</script>

<div class="page-root docs errors-page">
  <main class="content" animate={pageMotion}>
    <h1>Error codes</h1>
    <p class="errors-intro">
      An error code names the check that failed. Each entry shows the fixed
      message and how to fix it. Placeholders like
      <code>$name</code> are filled with the real value when the error is
      raised.
    </p>

    <EACH {groups} as={group}>
      <section class="doc-section" id={group.id}>
        <h2>{group.label}</h2>
        <p class="errors-group-intro">{group.intro}</p>
        <EACH {group.codes} as={code}>
          <article class="error-entry" id={code.id.toLowerCase()}>
            <h3><code>{code.id}</code> {code.message}</h3>
            <p>{code.hint}</p>
          </article>
        </EACH>
      </section>
    </EACH>
  </main>
</div>

<style>
  .errors-page {
    --page-accent: var(--rose);
  }

  .errors-intro,
  .errors-group-intro {
    color: var(--muted);
  }

  .error-entry {
    border: 1px solid var(--line);
    border-radius: 12px;
    padding: 0.75rem 1rem;
    margin-block: 0.75rem;
    background: var(--card);

    h3 {
      margin: 0;
      font-size: 1rem;
      display: flex;
      gap: 0.5rem;
      align-items: baseline;
    }

    p {
      margin: 0.35rem 0 0;
      color: var(--muted);
    }
  }
</style>
