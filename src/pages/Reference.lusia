<script>
  import { onAttach, variable } from "lusiajs";
  import { api } from "lusiajs/api";
  import { entryIcon } from "../catalog.ts";
  import RefCard from "../components/RefCard.lusia";
  import RefTile from "../components/RefTile.lusia";
  import Sidebar from "../components/Sidebar.lusia";
  import { drawerOpen, sidebarClass } from "../drawer.ts";
  import { pageLink, referencePath } from "../page-link.ts";
  import { navLabel } from "../nav-label.ts";
  import { gridMotion } from "../motion/reference.ts";
  import { pageMotion } from "../motion/page.ts";
  import { sidebarMotion } from "../motion/sidebar.ts";
  import { createReferenceFilter } from "../reference-filter.ts";
  import { kindSections, kindsOf, withNeighbors } from "../reference-model.ts";
  import {
    entryIdFromHash,
    scrollOnOpen,
    watchHash,
  } from "../reference-view.ts";

  const sections = kindSections(api);
  const cards = withNeighbors(sections.flatMap((section) => section.entries));
  const indexGroups = sections.map((section) => ({
    id: section.kind,
    label: section.label,
    icon: section.icon,
    color: section.color,
    blocks: [
      {
        id: section.kind,
        entries: section.entries.map((entry) => ({
          id: entry.id,
          name: navLabel(entry.name),
          icon: entryIcon(entry.id),
          href: pageLink(referencePath, entry.id),
          demos: [],
        })),
      },
    ],
  }));
  const kinds = kindsOf(api);
  const filter = createReferenceFilter(
    sections.flatMap((section) => section.entries),
  );

  function sectionShown(section: (typeof sections)[number]): boolean {
    return filter.hasShown(section.entries.map((entry) => entry.id));
  }

  // The hash names the entry to open. Without one, the grid shows.
  const hash = variable(location.hash);
  const cardIds = cards.map((card) => card.entry.id);
  const openId = variable.compute(() => entryIdFromHash(hash.value, cardIds));
  scrollOnOpen(openId);
  onAttach(() => watchHash(hash));
</script>

<div class="page-root docs reference">
  <aside
    class={sidebarClass}
    id="sidebar"
    aria-label="Reference"
    animate={sidebarMotion}
  >
    <span class="nav-indicator" aria-hidden="true"></span>
    <Sidebar groups={indexGroups} shown={filter.isShown} />
  </aside>
  <div class="scrim" id="scrim" hidden={!drawerOpen.value}></div>
  <main class="content" animate={pageMotion}>
    <IF {!openId.value}>
      <div data-ref-grid animate={gridMotion}>
        <h1 class="ref-page-title">Reference</h1>
        <p class="ref-lead">
          Every function, type, markup, style and value, with signatures and
          examples.
        </p>
        <div class="ref-tools">
          <label class="ref-search">
            <span class="material-symbols-rounded" aria-hidden="true"
              >search</span
            >
            <input
              id="ref-filter"
              type="search"
              placeholder="Filter the reference"
              aria-label="Filter the reference"
              autocomplete="off"
              bind-value={filter.text}
            />
          </label>
          <div class="ref-kinds" role="group" aria-label="Filter by kind">
            <EACH {kinds} as={kind}>
              <button
                class="chip kind-chip"
                type="button"
                data-kind={kind}
                data-ref-kind={kind}
                aria-pressed={String(filter.isKindPicked(kind))}
                onclick={() => filter.toggleKind(kind)}
              >
                {kind}
              </button>
            </EACH>
          </div>
          <p class="ref-count" data-ref-count>{filter.count}</p>
        </div>

        <IF {filter.empty.value}>
          <div class="ref-empty" data-ref-empty>
            <p>Nothing matches your filter.</p>
            <button
              class="ref-clear"
              type="button"
              data-ref-clear
              onclick={filter.clear}
            >
              Clear filters
            </button>
          </div>
        </IF>

        <EACH {sections} as={section}>
          <IF {sectionShown(section)}>
            <section
              class="ref-group"
              data-ref-group={section.kind}
              style={"--group: " + section.color}
            >
              <h2 class="ref-group-title">
                {section.label}
                <span class="ref-group-count">{section.entries.length}</span>
              </h2>
              <div class="ref-tile-grid">
                <EACH {section.entries} as={entry}>
                  <IF {filter.isShown(entry.id)}>
                    <RefTile
                      entry={entry}
                      href={pageLink(referencePath, entry.id)}
                    />
                  </IF>
                </EACH>
              </div>
            </section>
          </IF>
        </EACH>
      </div>
    </IF>

    <IF {openId.value}>
      <div data-ref-details>
        <a class="ref-link ref-back" href={referencePath} data-ref-back>
          <span class="material-symbols-rounded" aria-hidden="true"
            >arrow_back</span
          >
          Back to Reference
        </a>
        <EACH {cards} as={card}>
          <IF {card.entry.id === openId.value}>
            <RefCard
              entry={card.entry}
              previous={card.previous}
              next={card.next}
            />
          </IF>
        </EACH>
      </div>
    </IF>
  </main>
</div>
